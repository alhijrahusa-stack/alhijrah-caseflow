# Career Gate environment. Copy to .env.local for development; set the same
# names in Vercel (Project → Settings → Environment Variables). Never commit values.
# Anything left blank is reported as NOT_CONFIGURED by the app; nothing is faked.

# --- Core (required) ---------------------------------------------------------
DATABASE_URL=                     # Supabase Postgres, transaction pooler (port 6543)
NEXT_PUBLIC_SUPABASE_URL=         # https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=    # used for staff sign-in calls and Realtime
SUPABASE_SERVICE_ROLE_KEY=        # server only: private Storage + staff invites
SUPABASE_JWT_SECRET=              # optional: legacy HS256 projects; otherwise JWKS is used
CAREER_GATE_ADMIN_EMAIL=          # real email of the first admin (bootstrap)
STATUS_OTP_PEPPER=                # >= 32 random chars
IP_HASH_PEPPER=                   # >= 32 random chars
CRON_SECRET=                      # Vercel Cron bearer secret
APP_BASE_URL=                     # https://<production domain> (status link in messages, Twilio callbacks)

# --- Document vision (Google Gemini) -----------------------------------------
GOOGLE_GEMINI_API_KEY=
DOCUMENT_VISION_FAST_MODEL=gemini-3.5-flash-lite       # as specified; confirm with the live check
DOCUMENT_VISION_ESCALATION_MODEL=gemini-3.8-flash      # as specified; confirm with the live check

# --- Agents and semantic search (OpenAI) -------------------------------------
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=gpt-5.6-luna                         # as specified; confirm with the live check
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- WhatsApp (Meta Cloud API) -----------------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=             # Graph API version, e.g. from your Meta app settings
WHATSAPP_TEMPLATE_LANG=           # e.g. en_US
WHATSAPP_TEMPLATE_SUBMISSION=     # approved template name: params {first_name, ref, submitted_at}
WHATSAPP_TEMPLATE_STATUS_OTP=     # approved authentication template name: params {code}
WHATSAPP_APP_SECRET=              # webhook signature verification
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# --- SMS (Twilio) ------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Email (Resend) ----------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=


# Identity Document Intelligence — production providers
# Regula Document Reader Web Service 9.9 is primary. Point this to your licensed
# Regula service or authenticated reverse proxy; do not use a public demo for PII.
REGULA_DOCUMENT_READER_URL=
REGULA_DOCUMENT_READER_AUTHORIZATION=

# Microblink BlinkID Verify 4000.4.0 is conditional fallback only.
# mode: self_hosted | cloud. Cloud requires explicit end-user consent per request.
MICROBLINK_VERIFY_URL=
MICROBLINK_VERIFY_AUTHORIZATION=
MICROBLINK_VERIFY_MODE=self_hosted
