# Copy to .env.local for local development. Set the same variables in Vercel
# (Project → Settings → Environment Variables). Never commit real values.

# Supabase Postgres connection string (Project → Connect → Transaction pooler, port 6543).
DATABASE_URL=

# Supabase project URL and service role key, used server-side only for the
# private "documents" Storage bucket. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared office key for /staff. Required in production; without it the
# office workspace stays closed. Use a long random value.
STAFF_ACCESS_KEY=
