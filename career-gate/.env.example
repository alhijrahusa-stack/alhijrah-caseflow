# Copy to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by public intake/status routes and the notification worker.
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp Cloud API (Meta). Leave blank to disable sending (messages stay queued).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
WHATSAPP_TEMPLATE_LANG=en_US

# Supabase Storage bucket for client documents (private).
DOCUMENTS_BUCKET=client-documents
