+    modulesRoot: path.resolve('dist/server'), compatibilityDate: '2026-05-15', compatibilityFlags: ['nodejs_compat'],
+    d1Databases: { DB: 'ds-db' }, r2Buckets: ['BUCKET'], kvNamespaces: { PERMISSIONS_KV: 'ds-kv' }, durableObjects: { CHAT_ROOMS: 'CaseChatRoom' },
+    bindings: { TRUST_SITES_IDENTITY_HEADERS: '1', OFFICE_ADMIN_EMAIL: 'admin@example.test', APP_SECRET: 'e'.repeat(64), PERMISSIONS_KV_NAMESPACE: 'test', OPENAI_API_KEY: 'sk-proj-test-' + 'k'.repeat(40), OPENAI_MODEL: MODEL },
