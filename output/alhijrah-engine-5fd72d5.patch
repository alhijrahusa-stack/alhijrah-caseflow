+function checked<T extends z.ZodTypeAny>(schema: T, kind: string) { return (v: unknown): { success: true; data: z.infer<T> } | { success: false } => { const r = schema.safeParse(v); if (r.success) return { success: true, data: r.data }; console.error('decision_support_schema', kind, r.error.issues.slice(0, 8).map(i => i.path.join('.') + ':' + i.code).join(' ')); return { success: false }; }; }
