+        : data.items.length ? <ol className="space-y-1.5">{data.items.slice(0, 12).map((p, i) => (
+          <li key={p.kind + p.candidateId + i} className="flex items-center justify-between gap-2 rounded-lg bg-[#090E1A] p-2 text-xs">
+            <span className="min-w-0 truncate"><span className={`ml-2 rounded-full border px-2 py-0.5 text-[11px] ${kindColor[p.kind]}`}>{kindLabel[p.kind]}</span><span className="text-slate-100">{p.name || p.reference}</span> <span className="text-slate-400">· {p.title}</span></span>
+            <button type="button" onClick={() => openCandidate(p.candidateId)} className="shrink-0 text-[11px] font-bold text-amber-300 underline" dir="ltr">{p.reference}</button>
+          </li>))}</ol>
+        : <p className="text-xs text-slate-400">لا توجد أولويات معلّقة اليوم.</p>}
