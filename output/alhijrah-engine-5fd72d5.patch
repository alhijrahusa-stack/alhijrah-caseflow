+import { z } from 'zod';
+import { staffWith,candidateOwned,sameOrigin,readJson,errorResponse } from '@/lib/server';
+import { rateLimit } from '@/lib/security';
+import { openaiConfig } from '@/lib/openai';
+import { comparePathways,analyzeDocuments,listReports,MAX_PATHWAYS } from '@/lib/decision-support';
+import { pathways } from '@/lib/pathways';
+// ALHIJRAH decision support (staff only). GET: engine status, pathway catalogue and saved draft reports.
+// POST: a staff-initiated run (compare up to three pathways against official sources, or check documents); results are
+// draft reports for staff review. Nothing here changes the case's status, documents or tasks.
+type Context={params:Promise<{id:string}>};
+const headers={'Cache-Control':'private, no-store'};
+const schema=z.discriminatedUnion('action',[
+ z.object({action:z.literal('compare'),pathways:z.array(z.string().min(2).max(40)).min(1).max(MAX_PATHWAYS),locale:z.enum(['ar','en']).default('ar')}).strict(),
+ z.object({action:z.literal('documents'),locale:z.enum(['ar','en']).default('ar')}).strict(),
+]);
+export async function GET(_r:Request,ctx:Context){try{const s=await staffWith('view_crm'),{id}=await ctx.params;await candidateOwned(id,s.scope);const c=openaiConfig();
+ return Response.json({engine:{configured:c.configured,model:c.model,reason:c.reason},maxPathways:MAX_PATHWAYS,pathways:pathways.map(p=>({id:p.id,ar:p.ar,en:p.en})),reports:await listReports(id)},{headers});}catch(e){return errorResponse(e);}}
+export async function POST(request:Request,ctx:Context){try{sameOrigin(request);const s=await staffWith('review_case'),{id}=await ctx.params,c=await candidateOwned(id,s.scope),d=await readJson(request,schema);
+ await rateLimit(request,'decision-support:'+id,12,3600);
+ const report=d.action==='compare'?await comparePathways(id,c.ownerId,s.user.email,d.pathways,d.locale):await analyzeDocuments(id,c.ownerId,s.user.email,d.locale);
+ return Response.json({report},{status:201,headers});}catch(e){return errorResponse(e);}}
