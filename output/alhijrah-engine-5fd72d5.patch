+// ALHIJRAH — Autonomous Assessment & Decision Support Engine (staff-only, advisory).
+// - compare: up to three Canadian pathways side by side, each requirement checked against current official Canadian sources
+//   (OpenAI web search restricted to government domains). A requirement keeps its source only when that exact URL came back
+//   from the search on an official domain; otherwise it is marked unverified. No points are computed here: the CRS shown is
+//   the engine's stored value, labelled as such.
+// - documents: reads the case's uploaded files (clean or legacy only) for type/legibility/expiry observations and checks the
+//   engine's missing-document list. Requires the client's recorded AI authorization; never marks a document reviewed.
+// - Every run is staff-initiated, saved encrypted in R2 as a draft report and logged on the case. Follow-up tasks are only
+//   proposed; creating one is a separate staff action (/api/tasks). Final immigration decisions stay with the licensed professional.
+import { z } from 'zod';
+import { env } from 'cloudflare:workers';
+import { getDb } from '@/db';
+import { candidates, documents, documentAiPermissions, events, caseCrs } from '@/db/schema';
+import { and, eq, inArray } from 'drizzle-orm';
+import { ApiError } from './server';
+import { encrypt, decrypt } from './security';
+import { aiStructured, openaiConfig, cleanUrl, type ContentPart } from './openai';
+import { reviewInput } from './case-review';
+import { pathwayById, pathwayIds } from './pathways';
+import { documentLabels } from './model';
+import { DOCUMENT_PERMISSION_VERSION } from './generated-documents';
+import { operationLog } from './professional-ai';
+import { torontoDate } from './v22-core';
+import { latestV22 } from './assessment-store';
+
+export const MAX_PATHWAYS = 3;
+const status = z.enum(['met', 'not_met', 'unknown']);
+const requirement = z.object({ requirement: z.string().min(2).max(1500), caseStatus: status, caseEvidence: z.string().max(1500), sourceUrl: z.string().max(2000), sourcePageDate: z.string().max(120) }).strict();
+const task = z.object({ title: z.string().min(3).max(400), dueInDays: z.number().int().min(0).max(90), priority: z.enum(['normal', 'high', 'urgent']) }).strict();
+export const compareSchema = z.object({
+  summary: z.string().min(10).max(5000),
+  pathways: z.array(z.object({ pathwayId: z.string().max(60), name: z.string().min(2).max(300), requirements: z.array(requirement).max(20), blockers: z.array(z.string().max(1200)).max(12), officeNextSteps: z.array(z.string().max(1200)).max(12) }).strict()).min(1).max(MAX_PATHWAYS + 2),
+  missingInformation: z.array(z.string().max(1200)).max(20), clientQuestions: z.array(z.string().max(1200)).max(15), taskProposals: z.array(task).max(12),
+}).strict();
+const S = { type: 'string' }, arr = (items: Record<string, unknown>, maxItems: number) => ({ type: 'array', items, maxItems });
+const compareJsonSchema = {
+  type: 'object', additionalProperties: false, required: ['summary', 'pathways', 'missingInformation', 'clientQuestions', 'taskProposals'],
+  properties: {
+    summary: S,
+    pathways: arr({ type: 'object', additionalProperties: false, required: ['pathwayId', 'name', 'requirements', 'blockers', 'officeNextSteps'], properties: {
+      pathwayId: S, name: S,
+      requirements: arr({ type: 'object', additionalProperties: false, required: ['requirement', 'caseStatus', 'caseEvidence', 'sourceUrl', 'sourcePageDate'], properties: { requirement: S, caseStatus: { type: 'string', enum: ['met', 'not_met', 'unknown'] }, caseEvidence: S, sourceUrl: S, sourcePageDate: S } }, 14),
+      blockers: arr(S, 8), officeNextSteps: arr(S, 8) } }, MAX_PATHWAYS),
+    missingInformation: arr(S, 12), clientQuestions: arr(S, 10),
+    taskProposals: arr({ type: 'object', additionalProperties: false, required: ['title', 'dueInDays', 'priority'], properties: { title: S, dueInDays: { type: 'integer' }, priority: { type: 'string', enum: ['normal', 'high', 'urgent'] } } }, 8),
+  },
+};
+export const documentsSchema = z.object({
+  summary: z.string().min(2).max(4000),
+  documents: z.array(z.object({ documentId: z.string().max(120), observedType: z.string().max(400), matchesCategory: z.enum(['yes', 'no', 'unclear']), readable: z.enum(['yes', 'partly', 'no']), expiryDateShown: z.string().max(80), issues: z.array(z.string().max(1200)).max(12) }).strict()).max(8),
+  missingDocuments: z.array(z.string().max(600)).max(20), taskProposals: z.array(task).max(12),
+}).strict();
+const documentsJsonSchema = {
+  type: 'object', additionalProperties: false, required: ['summary', 'documents', 'missingDocuments', 'taskProposals'],
+  properties: {
+    summary: S,
+    documents: arr({ type: 'object', additionalProperties: false, required: ['documentId', 'observedType', 'matchesCategory', 'readable', 'expiryDateShown', 'issues'], properties: { documentId: S, observedType: S, matchesCategory: { type: 'string', enum: ['yes', 'no', 'unclear'] }, readable: { type: 'string', enum: ['yes', 'partly', 'no'] }, expiryDateShown: S, issues: arr(S, 8) } }, 6),
+    missingDocuments: arr(S, 15),
