+'use client';
+// ALHIJRAH decision support panel (case view) and the ordered work-priority list (dashboard). Every run is a staff action;
+// results are draft reports. Proposed follow-up tasks are created only when a staff member presses «اعتماد».
+import { useEffect, useState } from 'react';
+import { Sparkles, LoaderCircle, ExternalLink, ShieldCheck, ListPlus, Check, FileSearch, Scale, AlertTriangle, Languages, Clock } from 'lucide-react';
+import { api } from '@/lib/client';
+import { torontoDate } from '@/lib/v22-core';
+
+type Req = { requirement: string; caseStatus: 'met' | 'not_met' | 'unknown'; caseEvidence: string; sourceUrl: string; sourceTitle: string; sourcePageDate: string; checkedOn: string; verified: boolean };
+type Task = { title: string; dueInDays: number; priority: 'normal' | 'high' | 'urgent' };
+type Compare = { summary: string; pathways: { pathwayId: string; name: string; requirements: Req[]; blockers: string[]; officeNextSteps: string[] }[]; missingInformation: string[]; clientQuestions: string[]; taskProposals: Task[]; engineCrs: { value: number | null; source: string } | null; sources: { url: string; title: string; checkedOn: string }[]; verifiedRequirements: number; unverifiedRequirements: number };
+type Docs = { summary: string; documents: { documentId: string; observedType: string; matchesCategory: string; readable: string; expiryDateShown: string; issues: string[] }[]; missingDocuments: string[]; taskProposals: Task[]; analyzed: number; skipped: number; engineMissingDocuments: string[]; note: string };
+type Report = { reportId: string; kind: 'compare' | 'documents'; locale: 'ar' | 'en'; model: string; createdAt: string; createdBy: string; checkedOn: string; disclaimer: string; result: Compare | Docs };
+type State = { engine: { configured: boolean; model: string; reason: string }; maxPathways: number; pathways: { id: string; ar: string; en: string }[]; reports: Report[] };
+
+const box = 'rounded-2xl border border-amber-500/25 bg-[#0b1120]/90 p-5 space-y-4';
+const statusText = { met: 'مستوفى بحسب الملف', not_met: 'غير مستوفى بحسب الملف', unknown: 'غير معروف من الملف' };
+const statusColor = { met: 'text-emerald-300', not_met: 'text-red-300', unknown: 'text-amber-200' };
+const addDays = (n: number) => new Date(Date.parse(torontoDate(Date.now()) + 'T12:00:00Z') + n * 86400000).toISOString().slice(0, 10);
+
+export function DecisionSupport({ candidateId, notify, onReviewSaved }: { candidateId: string; notify: (m: string) => void; onReviewSaved?: () => void }) {
+  const [state, setState] = useState<State | null>(null), [error, setError] = useState('');
+  const [chosen, setChosen] = useState<string[]>([]), [locale, setLocale] = useState<'ar' | 'en'>('ar'), [busy, setBusy] = useState(''), [active, setActive] = useState<Report | null>(null);
+  const [rev, setRev] = useState(0);
+  useEffect(() => {
+    let live = true;
+    api<State>(`/api/candidates/${candidateId}/decision-support`).then(s => { if (live) { setState(s); setActive(a => a ?? s.reports[0] ?? null); } }).catch(e => { if (live) setError((e as Error).message); });
+    return () => { live = false; };
+  }, [candidateId, rev]);
+
+  async function run(body: Record<string, unknown>, label: string) {
+    setBusy(label); setError('');
+    try { const r = await api<{ report: Report }>(`/api/candidates/${candidateId}/decision-support`, { method: 'POST', body: JSON.stringify({ ...body, locale }), timeoutMs: 170000 }); setActive(r.report); setRev(v => v + 1); notify('حُفظ التقرير كمسودة للمراجعة'); }
+    catch (e) { setError((e as Error).message); } finally { setBusy(''); }
+  }
+  async function review() {
+    setBusy('review'); setError('');
+    try { await api(`/api/candidates/${candidateId}/ai-review?locale=${locale}`, { method: 'POST', timeoutMs: 170000 }); notify('حُفظت المراجعة الشاملة في الملف'); onReviewSaved?.(); }
+    catch (e) { setError((e as Error).message); } finally { setBusy(''); }
+  }
+  if (!state) return <div className={box}>{error ? <p role="alert" className="text-xs text-red-200">{error}</p> : <p className="flex items-center gap-2 text-xs text-slate-400"><LoaderCircle className="h-4 w-4 animate-spin" />جارٍ تحميل محرك دعم القرار…</p>}</div>;
+  const off = !state.engine.configured;
+  return (
+    <section className={box} aria-label="محرك ALHIJRAH لدعم القرار">
+      <div className="flex flex-wrap items-center justify-between gap-2 border-b border-amber-500/15 pb-3">
+        <h3 className="flex items-center gap-2 text-base font-bold text-white"><Sparkles className="h-4 w-4 text-amber-400" />محرك ALHIJRAH للتقييم ودعم القرار</h3>
+        <span className={`rounded-full border px-2.5 py-0.5 text-[11px] ${off ? 'border-red-500/40 text-red-200' : 'border-emerald-500/40 text-emerald-300'}`}>{off ? 'غير مفعّل' : `OpenAI · ${state.engine.model}`}</span>
+      </div>
+      {off && <p role="alert" className="text-xs text-red-200">{state.engine.reason}</p>}
+      <div className="space-y-2">
+        <div className="text-xs font-bold text-amber-300">اختر حتى {state.maxPathways} مسارات للمقارنة بالمصادر الرسمية الحالية</div>
+        <div className="flex flex-wrap gap-1.5">
+          {state.pathways.map(p => { const on = chosen.includes(p.id), full = !on && chosen.length >= state.maxPathways; return (
+            <button key={p.id} type="button" disabled={full} aria-pressed={on} onClick={() => setChosen(c => on ? c.filter(x => x !== p.id) : [...c, p.id])}
+              className={`rounded-full border px-2.5 py-1 text-[11px] ${on ? 'border-amber-400/60 bg-amber-500/20 text-amber-200' : 'border-white/10 text-slate-300 disabled:opacity-40'}`}>{p.ar}</button>); })}
+        </div>
+      </div>
+      <div className="flex flex-wrap items-center gap-2">
+        <label className="flex items-center gap-1 text-xs text-slate-300"><Languages className="h-3.5 w-3.5" />لغة التقرير
+          <select aria-label="لغة التقرير" value={locale} onChange={e => setLocale(e.target.value as 'ar' | 'en')} className="rounded-lg border border-amber-500/25 bg-[#090E1A] px-2 py-1 text-xs text-white"><option value="ar">العربية</option><option value="en">English</option></select>
+        </label>
+        <button type="button" disabled={off || !chosen.length || !!busy} onClick={() => void run({ action: 'compare', pathways: chosen }, 'compare')} className="inline-flex items-center gap-1.5 rounded-xl bg-gradient-to-l from-amber-400 to-amber-500 px-3 py-2 text-xs font-bold text-[#090E1A] disabled:opacity-50">{busy === 'compare' ? <LoaderCircle className="h-3.5 w-3.5 animate-spin" /> : <Scale className="h-3.5 w-3.5" />}مقارنة المسارات ({chosen.length})</button>
+        <button type="button" disabled={off || !!busy} onClick={() => void run({ action: 'documents' }, 'documents')} className="inline-flex items-center gap-1.5 rounded-xl border border-amber-500/30 bg-[#090E1A] px-3 py-2 text-xs font-bold text-amber-300 disabled:opacity-50">{busy === 'documents' ? <LoaderCircle className="h-3.5 w-3.5 animate-spin" /> : <FileSearch className="h-3.5 w-3.5" />}فحص المستندات والنواقص</button>
+        <button type="button" disabled={off || !!busy} onClick={() => void review()} className="inline-flex items-center gap-1.5 rounded-xl border border-amber-500/30 bg-[#090E1A] px-3 py-2 text-xs font-bold text-amber-300 disabled:opacity-50">{busy === 'review' ? <LoaderCircle className="h-3.5 w-3.5 animate-spin" /> : <Sparkles className="h-3.5 w-3.5" />}مراجعة شاملة بهذه اللغة</button>
+      </div>
+      {busy && <p className="text-[11px] text-slate-400">قد يستغرق التحقق من المصادر الرسمية حتى دقيقتين.</p>}
+      {error && <p role="alert" className="rounded-lg border border-red-500/40 bg-red-500/10 p-2 text-xs text-red-200">{error}</p>}
+      {state.reports.length > 0 && (
+        <div className="flex flex-wrap gap-1.5 text-[11px]">{state.reports.map(r => (
+          <button key={r.reportId} type="button" onClick={() => setActive(r)} className={`rounded-lg border px-2 py-1 ${active?.reportId === r.reportId ? 'border-amber-400/60 text-amber-200' : 'border-white/10 text-slate-400'}`}>{r.kind === 'compare' ? 'مقارنة' : 'مستندات'} · {r.checkedOn} · {r.locale.toUpperCase()}</button>))}</div>
+      )}
+      {active && <ReportView report={active} candidateId={candidateId} notify={notify} />}
+      <p className="flex items-center gap-1.5 text-[11px] text-slate-500"><ShieldCheck className="h-3.5 w-3.5" />المخرجات مسودات للمراجعة. لا يغيّر المحرك حالة الملف أو مستنداته أو مهامه، والقرار الهجري النهائي للمختص المرخّص.</p>
+    </section>
+  );
+}
+
+function ReportView({ report, candidateId, notify }: { report: Report; candidateId: string; notify: (m: string) => void }) {
+  const r = report.result;
+  return (
+    <article className="space-y-3 rounded-xl border border-amber-500/20 bg-[#090E1A] p-4 text-xs" dir={report.locale === 'en' ? 'ltr' : 'rtl'}>
+      <div className="flex flex-wrap justify-between gap-2 text-[11px] text-slate-400"><span>{report.kind === 'compare' ? 'مقارنة المسارات' : 'فحص المستندات'} · {report.model}</span><span>تحقق في {report.checkedOn} · {report.createdBy}</span></div>
+      <p className="rounded-lg border border-amber-500/30 bg-amber-500/10 p-2 text-amber-100">{report.disclaimer}</p>
+      <p className="leading-relaxed text-slate-200">{r.summary}</p>
