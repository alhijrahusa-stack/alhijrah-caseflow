+// Work priority queue (office-wide scope of the caller): 1) overdue tasks, 2) tasks due today, 3) client requests waiting
+// for the office (portal inbox "pending"), 4) inactive cases (no update for 14 days, not archived). Dates use the Toronto
+// office calendar. Read-only.
+import { getDb } from '@/db';
+import { tasks,candidates,clientCases } from '@/db/schema';
+import { and,eq,ne,lt,asc,sql } from 'drizzle-orm';
+import { owned,type Scope } from './server';
+import { torontoDate } from './v22-core';
+export type PriorityItem={rank:1|2|3|4;kind:'overdue_task'|'today_task'|'waiting_request'|'inactive_case';candidateId:string;reference:string;name:string;title:string;date:string};
+const nameOf=sql<string>`json_extract(${candidates.profile},'$.fullName')`;
+export async function prioritizedWork(scope:Scope,limit=40){
+ const db=getDb(),today=torontoDate(Date.now()),stale=new Date(Date.now()-14*86400000).toISOString();
+ const open=and(owned(tasks.ownerId,scope),eq(tasks.status,'open'),ne(candidates.status,'archived'));
+ const [overdue,due,waiting,inactive]=await Promise.all([
+  db.select({id:candidates.id,reference:candidates.reference,name:nameOf,title:tasks.title,date:tasks.dueDate}).from(tasks).innerJoin(candidates,eq(candidates.id,tasks.candidateId)).where(and(open,ne(tasks.dueDate,''),lt(tasks.dueDate,today))).orderBy(asc(tasks.dueDate)).limit(limit),
+  db.select({id:candidates.id,reference:candidates.reference,name:nameOf,title:tasks.title,date:tasks.dueDate}).from(tasks).innerJoin(candidates,eq(candidates.id,tasks.candidateId)).where(and(open,eq(tasks.dueDate,today))).orderBy(asc(tasks.createdAt)).limit(limit),
+  db.select({id:candidates.id,reference:candidates.reference,name:nameOf,date:clientCases.submittedAt}).from(clientCases).innerJoin(candidates,eq(candidates.id,clientCases.candidateId)).where(and(owned(candidates.ownerId,scope),eq(clientCases.inbox,'pending'),ne(candidates.status,'archived'))).orderBy(asc(clientCases.submittedAt)).limit(limit),
+  db.select({id:candidates.id,reference:candidates.reference,name:nameOf,date:candidates.updatedAt}).from(candidates).where(and(owned(candidates.ownerId,scope),ne(candidates.status,'archived'),lt(candidates.updatedAt,stale))).orderBy(asc(candidates.updatedAt)).limit(limit),
