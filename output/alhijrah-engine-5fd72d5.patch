+    {r.missingInformation.length > 0 && <div><strong className="text-amber-300">معلومات ناقصة</strong><ul className="list-inside list-disc text-slate-300">{r.missingInformation.map((b, i) => <li key={i}>{b}</li>)}</ul></div>}
