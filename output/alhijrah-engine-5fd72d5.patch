+const reportKey = (caseId: string, reportId: string) => `decision-support/${caseId}/${reportId}.json`;
+
+async function save(caseId: string, ownerId: string, actor: string, report: Report, action: string) {
+  if (!env.BUCKET) throw new ApiError(503, 'التخزين غير متاح لحفظ التقرير.');
+  await env.BUCKET.put(reportKey(caseId, report.reportId), await encrypt(JSON.stringify(report)), { httpMetadata: { contentType: 'text/plain' }, customMetadata: { kind: report.kind, createdAt: report.createdAt } });
+  await getDb().insert(events).values({ id: crypto.randomUUID(), ownerId, candidateId: caseId, action, note: `${report.model} · ${report.locale} · تقرير ${report.reportId.slice(0, 8)} · بانتظار مراجعة الموظف`, createdAt: report.createdAt });
