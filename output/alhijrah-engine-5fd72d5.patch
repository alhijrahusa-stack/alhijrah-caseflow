+// ALHIJRAH decision-support engine — the single OpenAI client of the Worker.
+// Key: Worker secret OPENAI_API_KEY (server-side only, never returned, logged or sent to the browser).
+// Model: Worker variable OPENAI_MODEL. The configured model is used as-is: a provider error (unknown model, no access,
+// quota) is reported with its HTTP status and provider message — the engine never switches to another model.
+// Official-source verification uses OpenAI web search restricted to Canadian government domains; every citation kept
+// must be a URL the search actually returned on one of those domains, stamped with the Toronto date it was checked.
+import { env } from 'cloudflare:workers';
+import { ApiError } from './server';
+import { assertCanadianOutput } from './output-guard';
+import { torontoDate } from './v22-core';
+
+export const OFFICIAL_DOMAINS = ['canada.ca', 'gc.ca', 'justice.gc.ca', 'laws-lois.justice.gc.ca', 'gazette.gc.ca', 'statcan.gc.ca', 'noc.statcan.gc.ca',
+  'ontario.ca', 'alberta.ca', 'gov.bc.ca', 'welcomebc.ca', 'saskatchewan.ca', 'immigratemanitoba.com', 'quebec.ca', 'novascotia.ca',
+  'immigrationnewfoundland.ca', 'princeedwardisland.ca', 'gnb.ca', 'yukon.ca', 'nwtimmigration.ca', 'gov.nu.ca'] as const;
+const OFFICIAL_HOST = new RegExp(`^(?:[a-z0-9-]+\\.)*(?:${OFFICIAL_DOMAINS.map(d => d.replace(/\./g, '\\.')).join('|')})$`, 'i');
+export const MODEL_ID = /^[A-Za-z0-9][A-Za-z0-9._:-]{1,99}$/;
+
+export type OpenAIConfig = { configured: boolean; model: string; reason: string };
+type Env = { OPENAI_API_KEY?: string; OPENAI_MODEL?: string };
+const vars = () => env as unknown as Env;
+
+export function openaiConfig(): OpenAIConfig {
+  const key = (vars().OPENAI_API_KEY || '').trim(), model = (vars().OPENAI_MODEL || '').trim();
+  if (!key) return { configured: false, model, reason: 'OPENAI_API_KEY غير مضبوط على الخادم.' };
+  if (!model) return { configured: false, model, reason: 'OPENAI_MODEL غير مضبوط على الخادم.' };
+  if (!MODEL_ID.test(model)) return { configured: false, model, reason: 'قيمة OPENAI_MODEL غير صالحة.' };
+  return { configured: true, model, reason: '' };
+}
+export function serverOpenAIKey() { const c = requireConfig(); return c.key; }
+function requireConfig() { const c = openaiConfig(); if (!c.configured) throw new ApiError(503, `محرك الذكاء الاصطناعي غير مفعّل: ${c.reason}`); return { ...c, key: (vars().OPENAI_API_KEY || '').trim() }; }
+
+export const redact = (s: string) => s.replace(/sk-[A-Za-z0-9_-]{8,}/g, '[key]').replace(/Bearer\s+\S+/gi, 'Bearer [key]');
+export function isOfficialUrl(url: string) { try { const u = new URL(url); return u.protocol === 'https:' && OFFICIAL_HOST.test(u.hostname); } catch { return false; } }
+export function cleanUrl(url: string) { try { const u = new URL(url); for (const k of [...u.searchParams.keys()]) if (/^(utm_|trk$)/i.test(k)) u.searchParams.delete(k); u.hash = ''; return u.toString(); } catch { return url; } }
+
+// Exact provider reason (status + provider message, key redacted). 404 names the model: no silent fallback.
+export async function openaiError(response: Response, model: string): Promise<ApiError> {
+  const body = await response.json().catch(() => null) as { error?: { message?: string; code?: string } } | null;
+  const detail = redact(body?.error?.message || '').slice(0, 240);
+  const reason = response.status === 401 ? 'مفتاح OpenAI مرفوض (401).'
+    : response.status === 403 ? `OpenAI رفض الطلب (403): المشروع لا يملك صلاحية النموذج ${model} أو المنطقة غير مسموحة.`
+    : response.status === 404 ? `النموذج ${model} غير متاح لمشروع OpenAI (404). لم يُستبدل بنموذج آخر.`
+    : response.status === 429 ? 'تجاوز حد الاستخدام أو الرصيد في OpenAI (429).'
+    : `رفض OpenAI الطلب (${response.status}).`;
+  return new ApiError(response.status === 429 ? 429 : 502, detail ? `${reason} رسالة المزود: ${detail}` : reason);
+}
+
+export type Citation = { url: string; title: string; checkedOn: string };
+export type ContentPart = { type: 'input_text'; text: string } | { type: 'input_image'; image_url: string } | { type: 'input_file'; filename: string; file_data: string };
+export type InputItem = { role: 'user' | 'assistant' | 'system'; content: string | ContentPart[] } | Record<string, unknown>;
+type OutItem = { type: string; status?: string; action?: { type?: string; sources?: { url?: string }[] }; name?: string; arguments?: string; call_id?: string; content?: { type: string; text?: string; annotations?: { type: string; url?: string; title?: string }[] }[] };
+export type RawResponse = { status?: string; model?: string; output?: OutItem[]; incomplete_details?: { reason?: string } | null };
+
+export type CallOptions = {
+  instructions: string; input: string | InputItem[]; maxTokens?: number; officialSearch?: boolean; tools?: Record<string, unknown>[];
+  schema?: { name: string; schema: Record<string, unknown> }; jsonMode?: boolean; timeoutMs?: number; reasoning?: 'low' | 'medium' | 'high';
+};
+// One Responses API call with the configured model. Returns the raw response; callers use the helpers below.
+export async function openaiResponse(o: CallOptions): Promise<{ raw: RawResponse; model: string; searched: boolean }> {
+  const c = requireConfig(), controller = new AbortController(), timer = setTimeout(() => controller.abort(), o.timeoutMs ?? 90000);
+  const tools = [...(o.officialSearch ? [{ type: 'web_search', filters: { allowed_domains: [...OFFICIAL_DOMAINS] } }] : []), ...(o.tools || [])];
+  let response: Response;
+  try {
+    response = await fetch('https://api.openai.com/v1/responses', {
+      method: 'POST', signal: controller.signal, headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + c.key },
+      body: JSON.stringify({
+        model: c.model, store: false, instructions: o.instructions, input: o.input, max_output_tokens: o.maxTokens ?? 3000,
+        ...(o.reasoning ? { reasoning: { effort: o.reasoning } } : {}), ...(tools.length ? { tools } : {}), ...(o.officialSearch ? { include: ['web_search_call.action.sources'] } : {}),
+        ...(o.schema ? { text: { format: { type: 'json_schema', name: o.schema.name, strict: true, schema: o.schema.schema } } } : o.jsonMode ? { text: { format: { type: 'json_object' } } } : {}),
+      }),
+    });
+  } catch (e) { throw new ApiError(502, (e as Error).name === 'AbortError' ? 'انتهت مهلة الاتصال بـ OpenAI.' : 'تعذّر الوصول إلى خادم OpenAI.'); }
+  finally { clearTimeout(timer); }
+  if (!response.ok) throw await openaiError(response, c.model);
+  const raw = await response.json() as RawResponse;
+  if (raw.model && !raw.model.startsWith(c.model)) throw new ApiError(502, `أجاب OpenAI بنموذج مختلف (${raw.model}) عن المضبوط (${c.model}); رُفضت الاستجابة.`);
+  return { raw, model: raw.model || c.model, searched: (raw.output || []).some(i => i.type === 'web_search_call') };
+}
+export const outputText = (raw: RawResponse) => (raw.output || []).filter(o => o.type === 'message').flatMap(o => o.content || []).filter(p => p.type === 'output_text').map(p => p.text || '').join('').trim();
+export const functionCalls = (raw: RawResponse) => (raw.output || []).filter(o => o.type === 'function_call');
+// Citations the web search returned on official domains only (tracking parameters removed), stamped with today's Toronto date.
+export function officialCitations(raw: RawResponse): Citation[] {
+  const out: Citation[] = [], checkedOn = torontoDate(Date.now());
+  for (const m of (raw.output || []).filter(o => o.type === 'message')) for (const p of m.content || []) for (const a of p.annotations || [])
+    if (a.type === 'url_citation' && a.url && isOfficialUrl(a.url)) { const url = cleanUrl(a.url); if (!out.some(c => c.url === url)) out.push({ url, title: a.title || url, checkedOn }); }
+  return out;
+}
+// Every official page the search retrieved in this response (cited or consulted). Used to verify per-requirement sources.
+export function searchedOfficialUrls(raw: RawResponse): Set<string> {
+  const urls = new Set(officialCitations(raw).map(c => c.url));
+  for (const o of (raw.output || []).filter(i => i.type === 'web_search_call')) for (const s of o.action?.sources || []) if (s.url && isOfficialUrl(s.url)) urls.add(cleanUrl(s.url));
+  return urls;
+}
+function assertComplete(raw: RawResponse) {
+  if (raw.status === 'incomplete') throw new ApiError(502, `توقفت استجابة OpenAI قبل اكتمالها (${raw.incomplete_details?.reason || 'incomplete'}); لم يُعتمد شيء.`);
+  if (raw.status && raw.status !== 'completed') throw new ApiError(502, `حالة استجابة OpenAI غير مكتملة (${raw.status}).`);
+  if ((raw.output || []).some(o => o.type === 'message' && (o.content || []).some(p => p.type === 'refusal'))) throw new ApiError(502, 'رفض النموذج إكمال الطلب.');
+}
+
+// Plain-text answer (chat-style messages). guard=true applies the Canadian-output guard.
+export async function aiText(messages: { role: 'system' | 'user' | 'assistant'; content: string }[], maxTokens = 700, guard = true) {
+  const system = messages.filter(m => m.role === 'system').map(m => m.content).join('\n\n');
+  const input = messages.filter(m => m.role !== 'system').map(m => ({ role: m.role, content: m.content }));
+  const { raw, model } = await openaiResponse({ instructions: system || 'Answer briefly.', input: input.length ? input : 'ok', maxTokens, timeoutMs: 30000 });
+  assertComplete(raw);
+  const text = outputText(raw);
+  if (!text) throw new ApiError(502, 'وصلت استجابة فارغة من OpenAI.');
+  if (guard) assertCanadianOutput(text);
+  return { text, model };
+}
+
+// Structured JSON validated twice: the provider's strict JSON schema, then the caller's zod schema.
+export async function aiStructured<T>(o: CallOptions & { schema: { name: string; schema: Record<string, unknown> }; parse: (v: unknown) => { success: true; data: T } | { success: false } }) {
+  const { raw, model, searched } = await openaiResponse(o);
+  assertComplete(raw);
+  const text = outputText(raw);
+  if (!text || text.length > 80000) throw new ApiError(502, 'استجابة OpenAI غير صالحة.');
+  assertCanadianOutput(text);
+  let value: unknown; try { value = JSON.parse(text); } catch { throw new ApiError(502, 'استجابة OpenAI ليست JSON صالحًا.'); }
+  const checked = o.parse(value);
+  if (!checked.success) throw new ApiError(502, 'لم تجتز استجابة OpenAI التحقق البرمجي من بنيتها.');
+  return { data: checked.data, model, searched, citations: officialCitations(raw), searchedUrls: searchedOfficialUrls(raw) };
+}
+
+// JSON object answer validated by a zod-style parser (for callers without a provider JSON schema).
+export async function aiJsonObject<T>(instructions: string, input: unknown, parse: (v: unknown) => { success: true; data: T } | { success: false }, maxTokens = 1300) {
+  const { raw, model } = await openaiResponse({ instructions: instructions + ' Respond with a single JSON object.', input: 'JSON input: ' + JSON.stringify(input), maxTokens, jsonMode: true, timeoutMs: 30000 });
+  assertComplete(raw);
+  const text = outputText(raw);
+  if (!text) throw new ApiError(502, 'استجابة التحليل غير مكتملة.');
+  assertCanadianOutput(text);
+  let value: unknown; try { value = JSON.parse(text); } catch { throw new ApiError(502, 'استجابة التحليل غير صالحة.'); }
+  const checked = parse(value);
+  if (!checked.success) throw new ApiError(502, 'لم يجتز التحليل التحقق من بنيته.');
+  return { data: checked.data, model };
+}
+
+// Models the configured project can call (live list from OpenAI). Used by settings to show availability.
+export async function listOpenAIModels(): Promise<string[]> {
+  const c = requireConfig(), controller = new AbortController(), timer = setTimeout(() => controller.abort(), 15000);
+  try {
+    const r = await fetch('https://api.openai.com/v1/models', { signal: controller.signal, headers: { Authorization: 'Bearer ' + c.key } });
+    if (!r.ok) throw await openaiError(r, c.model);
+    const body = await r.json() as { data?: { id?: string }[] };
+    return (body.data || []).map(m => m.id || '').filter(id => MODEL_ID.test(id) && /^(gpt|o\d|chatgpt)/i.test(id) && !/audio|realtime|tts|transcribe|image|embedding|moderation|search-api/i.test(id)).sort();
+  } catch (e) { if (e instanceof ApiError) throw e; throw new ApiError(502, 'تعذّر الوصول إلى خادم OpenAI.'); } finally { clearTimeout(timer); }
+}
