+  useEffect(() => { let live = true; api<{ today: string; counts: Record<string, number>; items: Priority[] }>('/api/dashboard/priorities').then(d => { if (live) setData(d); }).catch(e => { if (live) setError((e as Error).message); }); return () => { live = false; }; }, [revision]);
+  return (
+    <section className={box} aria-label="أولويات العمل">
+      <h3 className="flex items-center gap-2 border-b border-amber-500/15 pb-3 text-base font-bold text-white"><Clock className="h-4 w-4 text-amber-400" />أولويات العمل<span className="text-[11px] font-normal text-slate-400">متأخر ← اليوم ← طلبات العملاء المنتظرة ← الملفات الراكدة</span></h3>
