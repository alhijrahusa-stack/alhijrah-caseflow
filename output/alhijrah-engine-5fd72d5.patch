+}
+export async function listReports(caseId: string): Promise<Report[]> {
+  if (!env.BUCKET) return [];
+  const listed = await env.BUCKET.list({ prefix: `decision-support/${caseId}/`, limit: 100 });
+  const keys = listed.objects.sort((a, b) => b.uploaded.getTime() - a.uploaded.getTime()).slice(0, 10).map(o => o.key);
+  const out: Report[] = [];
+  for (const key of keys) { const o = await env.BUCKET.get(key); if (!o) continue; try { out.push(JSON.parse(await decrypt(await o.text())) as Report); } catch { /* unreadable report skipped */ } }
+  return out;
+}
