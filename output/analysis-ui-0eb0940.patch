diff --git a/components/operations/analysis-suite.tsx b/components/operations/analysis-suite.tsx
new file mode 100644
index 0000000..445f6df
--- /dev/null
+++ b/components/operations/analysis-suite.tsx
@@ -0,0 +1,62 @@
+'use client';
+// Case «التحليل والمسارات» tab: one glass workspace with five sections instead of six stacked modules. Every module and
+// action is kept; only the arrangement changes. The engine panel stays mounted across its two sections (overview and
+// evidence) so its live socket, language and draft state survive switching; the other modules load when opened.
+import { useState } from 'react';
+import { LayoutDashboard, FileSearch, Scale, Calculator, ClipboardCheck } from 'lucide-react';
+import type { CandidateRecord, Profile } from '@/lib/model';
+import { EnginePanel } from './engine-panel';
+import { DecisionSupport } from './decision-support';
+import { AiCaseReview } from './ai-review';
+import { CaseIntelligence } from './intelligence';
+import { StaffEligibility } from './eligibility';
+import { StaffCrs } from './crs';
+
+type View = 'overview' | 'evidence' | 'reviews' | 'rules' | 'readiness';
+const VIEWS: { id: View; label: string; hint: string; icon: typeof LayoutDashboard }[] = [
+  { id: 'overview', label: 'الخلاصة والمسارات', hint: 'النقاط والأدلة والمسارات المرتبة', icon: LayoutDashboard },
+  { id: 'evidence', label: 'الأدلة والخطة', hint: 'المعالجة والاستخراج والمحاكاة والخطة والنشر', icon: FileSearch },
+  { id: 'reviews', label: 'المقارنة والتقارير', hint: 'مقارنة المسارات والمراجعة الشاملة', icon: Scale },
+  { id: 'rules', label: 'القواعد وCRS', hint: 'محرك قواعد الأهلية وحاسبة CRS', icon: Calculator },
+  { id: 'readiness', label: 'جاهزية الملف', hint: 'البيانات والمستندات ومعايير الفحص', icon: ClipboardCheck },
+];
+
+// The case view remounts after each saved version; the open section is kept per case for the session.
+const lastView = new Map<string, View>();
+
+export function AnalysisSuite({ c, role, notify, saveProfile, openSection }: {
+  c: CandidateRecord; role: 'MANAGER' | 'STAFF'; notify: (m: string) => void;
+  saveProfile: (profile: Profile) => Promise<void>;
+  openSection: (s: 'documents' | 'client' | 'messages' | 'workflow') => void;
+}) {
+  const [view, setViewState] = useState<View>(() => lastView.get(c.id) || 'overview'), [aiRev, setAiRev] = useState(0);
+  const setView = (x: View) => { lastView.set(c.id, x); setViewState(x); };
+  const engineView = view === 'evidence' ? 'evidence' : 'overview';
+  return (
+    <div className="analysis-suite space-y-4">
+      <nav role="tablist" aria-label="أقسام التحليل" className="tw-scope flex flex-wrap gap-1.5 rounded-2xl border border-[#D4AF37]/20 bg-[#0B1120]/90 p-1.5 backdrop-blur-2xl">
+        {VIEWS.map(v => {
+          const on = view === v.id, Icon = v.icon;
+          return <button key={v.id} type="button" role="tab" id={'analysis-tab-' + v.id} aria-selected={on} aria-controls={'analysis-view-' + v.id} title={v.hint} onClick={() => setView(v.id)}
+            className={`flex flex-1 basis-[calc(50%-0.375rem)] items-center justify-center gap-1.5 whitespace-nowrap rounded-xl px-3 py-2 sm:flex-none sm:basis-auto text-xs font-bold transition-colors ${on ? 'border border-[#D4AF37]/45 bg-[#D4AF37]/12 text-[#F1D27A] shadow-[0_0_18px_-6px_rgba(212,175,55,0.45)]' : 'border border-transparent text-slate-400 hover:text-slate-200'}`}>
+            <Icon className="h-3.5 w-3.5" />{v.label}</button>;
+        })}
+      </nav>
+      <div id={'analysis-view-' + engineView} role="tabpanel" aria-labelledby={'analysis-tab-' + engineView} hidden={view !== 'overview' && view !== 'evidence'}>
+        <EnginePanel candidateId={c.id} role={role} notify={notify} section={engineView} onSection={setView}
+          profile={c.profile} saveProfile={saveProfile} />
+      </div>
+      {view === 'reviews' && <div id="analysis-view-reviews" role="tabpanel" aria-labelledby="analysis-tab-reviews" className="space-y-4">
+        <DecisionSupport candidateId={c.id} notify={notify} onReviewSaved={() => setAiRev(r => r + 1)} />
+        <AiCaseReview key={aiRev} candidateId={c.id} notify={notify} />
+      </div>}
+      {view === 'rules' && <div id="analysis-view-rules" role="tabpanel" aria-labelledby="analysis-tab-rules" className="space-y-4">
+        <StaffEligibility candidateId={c.id} />
+        <StaffCrs candidateId={c.id} />
+      </div>}
+      {view === 'readiness' && <div id="analysis-view-readiness" role="tabpanel" aria-labelledby="analysis-tab-readiness">
+        <CaseIntelligence candidate={c} openSection={openSection} />
+      </div>}
+    </div>
+  );
+}
