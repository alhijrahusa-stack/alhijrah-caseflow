@@ -0,0 +1,185 @@
+#!/usr/bin/env python3
+"""Build or verify the version-pinned catalogue using Python 3.10+ stdlib."""
+import argparse
+import csv
+import hashlib
+import io
+import json
+import re
+from collections import Counter
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+LANGUAGES = ("en", "fr")
+LEVELS = (None, "broad_category", "major_group", "sub_major_group", "minor_group", "unit_group")
+LEVEL_LABELS = {
+    "en": ("Broad Category", "Major Group", "Sub-major Group", "Minor Group", "Unit Group"),
+    "fr": ("Grande catégorie", "Grand groupe", "Sous-grand groupe", "Sous-groupe", "Groupe de base"),
+}
+COUNTS = {1: 10, 2: 45, 3: 89, 4: 162, 5: 516}
+SECTIONS = (
+    "illustrative_examples", "all_examples", "inclusions", "exclusions",
+    "main_duties", "employment_requirements", "additional_information",
+)
+SOURCE_LABELS = {
+    "en": ("Illustrative example(s)", "All examples", "Inclusion(s)", "Exclusion(s)",
+           "Main duties", "Employment requirements", "Additional information"),
+    "fr": ("Exemple(s) illustratif(s)", "Tous les exemples", "Inclusion(s)", "Exclusion(s)",
+           "Fonctions principales", "Conditions d'accès à la profession", "Renseignements supplémentaires"),
+}
+ELEMENT_TOTALS = {"en": 44037, "fr": 45882}
+HEADERS = {
+    ("structure", "en"): ("Level", "Hierarchical structure", "Code - NOC 2021 V1.0", "Class title", "Class definition"),
+    ("structure", "fr"): ("Niveau", "Structure hiérarchique", "Code dela CNP 2021 v1.0", "Titres de classes", "Définitions de la classe"),
+    ("elements", "en"): ("Level", "Code - NOC 2021 V1.0", "Class title", "Element Type Label English", "Element Description English"),
+    ("elements", "fr"): ("Niveau", "Code de la CNP v1.0", "Titres de classes", "Nom du type d’élément Français", "Description d’élément Français"),
+    ("crosswalk", "en"): ("NOC 2016 V1.3 Code", "NOC 2016 V1.3 Title", " GSIM Type of Change", "NOC 2021 V1.0 Code", "NOC 2021 V1.0 Title", "Notes", ""),
+    ("crosswalk", "fr"): ("Code CNP 2016 v1.3 ", "Titre de la CNP 2016 v1.3", "Type de changement GSIM", "Code CNP 2021 v1.0", "Titre de la CNP 2021 v1.0", "Notes"),
+}
+
+
+def require(condition, message):
+    if not condition:
+        raise ValueError(message)
+
+
+def assert_code(code, length):
+    require(re.fullmatch(r"[0-9]{" + str(length) + r"}", code), f"Invalid code: {code!r}")
+
+
+def rows(kind, lang):
+    filename = f"official/{kind}.{lang}.csv"
+    with (ROOT / filename).open(encoding="utf-8-sig", newline="") as handle:
+        reader = csv.reader(handle, strict=True)
+        header = HEADERS[kind, lang]
+        require(tuple(next(reader)) == header, f"Unexpected header: {filename}")
+        for ordinal, row in enumerate(reader, start=1):
+            require(len(row) == len(header), f"Unexpected field count: {filename}:{ordinal}")
+            yield ordinal, row
+
+
+def build_localized(lang):
+    data = {}
+    for ordinal, row in rows("structure", lang):
+        level, label, code, title, definition = row
+        require(level in ("1", "2", "3", "4", "5"), f"Invalid level: {lang}:{ordinal}")
+        depth = int(level)
+        assert_code(code, depth)
+        require(depth == 1 or code[1] in "012345", f"Invalid TEER: {code}")
+        require(label == LEVEL_LABELS[lang][depth - 1], f"Invalid level label: {lang}:{ordinal}")
+        require(code not in data and title.strip() and definition.strip(), f"Malformed or duplicate: {lang}:{ordinal}")
+        data[code] = {"source_record": ordinal, "level_label": label, "title": title, "definition": definition}
+        if depth == 5:
+            data[code]["sections"] = {key: [] for key in SECTIONS}
+    require(Counter(map(len, data)) == COUNTS, f"Unexpected hierarchy: {lang}")
+    require(all(len(code) == 1 or code[:-1] in data for code in data), f"Missing parent: {lang}")
+
+    labels = dict(zip(SOURCE_LABELS[lang], SECTIONS))
+    for ordinal, row in rows("elements", lang):
+        level, code, title, label, value = row
+        require(level == "5" and len(code) == 5 and code in data, f"Invalid element parent: {lang}:{ordinal}")
+        require(title == data[code]["title"] and label in labels and value.strip(),
+                f"Invalid element fields: {lang}:{ordinal}")
+        data[code]["sections"][labels[label]].append({"source_record": ordinal, "text": value})
+    counts = Counter()
+    for code, item in data.items():
+        if len(code) == 5:
+            sections = item["sections"]
+            require(all(sections[key] for key in ("all_examples", "illustrative_examples", "main_duties", "employment_requirements")),
+                    f"Missing required sections: {lang}:{code}")
+            counts.update({key: len(value) for key, value in sections.items()})
+    require(sum(counts.values()) == ELEMENT_TOTALS[lang], f"Unexpected element count: {lang}")
+    return data, dict(counts)
+
+
+def catalogue(localized):
+    require(localized["en"].keys() == localized["fr"].keys(), "Language hierarchies differ")
+    for code in sorted(localized["en"]):
+        level = len(code)
+        yield {
+            "noc_version": "2021-v1.0", "code": code, "level": LEVELS[level],
+            "parent_code": code[:-1] or None, "broad_category": code[0],
+            "teer": int(code[1]) if level >= 2 else None,
+            "localized": {lang: localized[lang][code] for lang in LANGUAGES},
+        }
+
+
+def crosswalk(unit_codes):
+    totals = Counter()
+    pairs = {lang: set() for lang in LANGUAGES}
+    for lang in LANGUAGES:
+        for ordinal, row in rows("crosswalk", lang):
+            before, from_title, gsim, after, to_title, notes = row[:6]
+            require(not any(row[6:]), f"Unexpected crosswalk data: {lang}:{ordinal}")
+            old, new = before.strip(), after.strip()
+            assert_code(old, 4)
+            assert_code(new, 5)
+            require(new in unit_codes and from_title.strip() and to_title.strip() and gsim.strip(),
+                    f"Invalid crosswalk entry: {lang}:{ordinal}")
+            totals[lang] += 1
+            pairs[lang].add((old, new))
+            yield {
+                "from_version": "2016-v1.3", "to_version": "2021-v1.0",
+                "source_language": lang, "source_record": ordinal, "from_code": old, "to_code": new,
+                "from_title": from_title, "to_title": to_title, "gsim_change": gsim, "notes": notes,
+            }
+    require(totals == {"en": 585, "fr": 585}, f"Unexpected crosswalk counts: {totals}")
+    require(pairs["en"] == pairs["fr"], "Crosswalk code pairs differ by language")
+
+
+def jsonl(records):
+    out = io.StringIO()
+    for record in records:
+        out.write(json.dumps(record, ensure_ascii=False, separators=(",", ":")))
+        out.write("\n")
+    return out.getvalue().encode("utf-8")
+
+
+def verify_integrity():
+    sums = ROOT / "SHA256SUMS"
+    paths = {}
+    for line in sums.read_text(encoding="utf-8").splitlines():
+        digest, relative = line.split("  ", 1)
+        path = ROOT / relative
+        require(path.resolve().is_relative_to(ROOT) and path.is_file() and relative not in paths,
+                f"Invalid manifest path: {relative}")
+        require(hashlib.sha256(path.read_bytes()).hexdigest() == digest, f"Hash mismatch: {relative}")
+        paths[relative] = digest
+    actual = {path.relative_to(ROOT).as_posix() for path in ROOT.rglob("*")
+              if path.is_file() and path != sums}
+    require(actual == paths.keys(), "Package entry list differs from SHA256SUMS")
+    manifest = json.loads((ROOT / "sources.json").read_text(encoding="utf-8"))
+    for entry in manifest["official_files"]:
+        source = ROOT / entry["path"]
+        require(paths[entry["path"]] == entry["sha256"] and source.stat().st_size == entry["bytes"],
+                f"Source manifest mismatch: {entry['path']}")
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("operation", choices=("build", "verify"))
+    args = parser.parse_args()
+    if args.operation == "verify":
+        verify_integrity()
+    localized, counts = {}, {}
+    for lang in LANGUAGES:
+        localized[lang], counts[lang] = build_localized(lang)
+    unit_codes = {code for code in localized["en"] if len(code) == 5}
+    payloads = {
+        "data/catalog.jsonl": jsonl(catalogue(localized)),
+        "data/crosswalk.jsonl": jsonl(crosswalk(unit_codes)),
+    }
+    for relative, payload in payloads.items():
+        path = ROOT / relative
+        if args.operation == "build":
+            temporary = path.with_suffix(".tmp")
+            temporary.write_bytes(payload)
+            temporary.replace(path)
+        else:
+            require(path.read_bytes() == payload, f"Normalized output differs from official files: {relative}")
+    print(json.dumps({"operation": args.operation, "hierarchy_counts": COUNTS,
+                      "element_counts": counts, "crosswalk_rows": 1170}, sort_keys=True))
+
+
+if __name__ == "__main__":
+    main()
