+        },
+        "required": [
+          "program_id",
+          "status",
+          "reason_code",
+          "source_ids"
+        ],
+        "additionalProperties": false
+      },
+      "minItems": 0
+    }
+  },
+  "required": [
+    "schema_version",
+    "case_id",
+    "employment_segment_id",
+    "evaluation_revision",
+    "catalog_snapshot_id",
+    "policy_snapshot_id",
+    "noc_version",
+    "evidence_snapshot_sha256",
+    "matching_engine_version",
+    "status",
+    "approved_code",
+    "approval",
+    "candidates",
+    "evidence",
+    "follow_up_questions",
+    "program_gates"
+  ],
+  "additionalProperties": false,
+  "allOf": [
+    {
+      "if": {
+        "properties": {
+          "status": {
+            "const": "APPROVED_INTERNAL"
+          }
+        }
+      },
+      "then": {
+        "properties": {
+          "approved_code": {
+            "type": "string",
+            "minLength": 5,
+            "maxLength": 5,
+            "pattern": "^[0-9][0-5][0-9]{3}$"
+          },
+          "approval": {
+            "type": "object",
+            "properties": {
+              "reviewer_id": {
+                "type": "string",
+                "minLength": 1
+              },
+              "approved_at": {
+                "type": "string",
+                "format": "date-time"
+              },
+              "reason": {
+                "type": "string",
+                "minLength": 1
+              }
+            },
+            "required": [
+              "reviewer_id",
+              "approved_at",
+              "reason"
+            ],
+            "additionalProperties": false
+          },
+          "evidence": {
+            "minItems": 1
+          },
+          "candidates": {
+            "minItems": 1,
+            "contains": {
+              "properties": {
+                "lead_statement": {
+                  "const": "MET"
+                },
+                "main_duties": {
+                  "const": "MET"
+                },
+                "essential_duties": {
+                  "const": "MET"
+                },
+                "exclusions_clear": {
+                  "const": "MET"
+                },
+                "findings": {
+                  "minItems": 1
+                }
+              }
+            }
+          }
+        }
+      },
+      "else": {
+        "properties": {
+          "approved_code": {
+            "type": "null"
+          },
+          "approval": {
+            "type": "null"
+          }
+        }
+      }
+    }
+  ]
+}
