+
+  const byCode = await json(await send('/api/office/noc-catalog?action=search&q=electrician&code=72200'), 200);
+  assert.equal(byCode.candidates[0].code, '72200'); assert.equal(byCode.candidates[0].exact, true);
+  const cross = await json(await send('/api/office/noc-catalog?action=crosswalk&code=7241'), 200);
+  assert.equal(cross.fromVersion, '2016-v1.3');
+  assert.ok(cross.mappings.length >= 1 && cross.mappings.every(m => /^[0-9]{5}$/.test(m.toCode)));
+});
+
+test('snapshot rows are immutable; evaluation cards use the published reference once the catalog is active', async () => {
+  await assert.rejects(db.prepare("UPDATE noc_nodes SET title_en='x' WHERE code='00010'").run(), /NOC_IMMUTABLE/);
+  await assert.rejects(db.prepare("DELETE FROM noc_nodes WHERE code='00010'").run(), /NOC_IMMUTABLE/);
+  await assert.rejects(db.prepare('DELETE FROM noc_elements').run(), /NOC_IMMUTABLE/);
