new file mode 100644
index 0000000..2397e41
--- /dev/null
+++ b/reference/noc-2021-v1.0/data/noc-policy.json
@@ -0,0 +1,90 @@
+{
+  "schema_version": 1,
+  "policy_snapshot_id": "ca-noc-occupation-rules-2026-11-17",
+  "reviewed_on": "2026-11-17",
+  "noc_version": "2021-v1.0",
+  "authority_precedence": [
+    "Applicable Act, regulations and valid controlling Ministerial Instructions or public policy for their legal scope",
+    "Applicable program or jurisdiction's official operational guidance",
+    "Statistics Canada / ESDC for the official classification",
+    "Internal selection and review workflow"
+  ],
+  "scope": "Occupational screening and classification reference. Complete eligibility, work-hour aggregation, admissibility, CRS, language, nomination, invitation and filing remain separate.",
+  "standard_work_duties_test": {
+    "lead_statement_actions_required": true,
+    "substantial_main_duties_required": true,
+    "all_essential_duties_required": true,
+    "official_numeric_threshold": null,
+    "required_catalog_fields_in_csv": ["definition", "main_duties", "employment_requirements"],
+    "essential_duty_flag_available_in_csv": false
+  },
+  "programs": {
+    "FSW": {
+      "authority": ["IRPR-75", "IRPR-76", "IRCC-FSW"],
+      "eligible_teer": [0, 1, 2, 3],
+      "exclude_restricted_occupation": true,
+      "same_primary_unit_required": true,
+      "work_duties_test": "standard_work_duties_test",
+      "work_experience_reference": {"lookback_years": 10, "min_full_time_equivalent_hours_ircc": 1560, "min_years": 1, "continuity_required": true}
+    },
+    "CEC": {
+      "authority": ["IRPR-87.1", "IRCC-CEC"],
+      "eligible_teer": [0, 1, 2, 3],
+      "exclude_restricted_occupation": true,
+      "multiple_units_permitted": true,
+      "work_duties_test": "standard_work_duties_test",
+      "work_experience_reference": {"lookback_years": 3, "min_full_time_equivalent_hours_ircc": 1560, "min_years": 1, "canada_required": true},
+      "dynamic_policy_exceptions": [{"id": "eligible_physicians_under_applicable_public_policy", "source_id": "IRCC-CEC-PHYSICIANS"}]
+    },
+    "FSTP": {
+      "authority": ["IRPR-87.2", "IRCC-FSTP"],
+      "include_major_groups": ["72", "73", "82", "83", "92", "93"],
+      "exclude_sub_major_groups": ["726", "932"],
+      "include_minor_groups": ["6320"],
+      "include_unit_groups": ["62200"],
+      "work_duties_test": "standard_work_duties_test",
+      "work_experience_reference": {"lookback_years": 5, "min_full_time_equivalent_hours_ircc": 3120, "min_years": 2, "same_unit": true, "independently_qualified_during_counted_period": true},
+      "relevant_noc_employment_requirements": "Apply IRPR 87.2(3)(c) with its certificate-of-qualification exception."
+    },
+    "AIP": {
+      "authority": ["IRPR-87.3", "IRCC-AIP-WORK", "IRCC-AIP-OFFER"],
+      "eligible_offer_teer": [0, 1, 2, 3, 4],
+      "eligible_experience_teer": [0, 1, 2, 3, 4],
+      "exclude_restricted_experience_occupation": true,
+      "duration_reference": {"teer_4": "indeterminate", "teer_0_to_3": "at_least_one_year_after_pr_visa_issuance"},
+      "work_duties_test": "standard_work_duties_test_unless_exempt",
+      "work_experience_reference": {"lookback_years": 5, "min_full_time_equivalent_hours_ircc": 1560, "min_years": 1},
+      "ordinary_offer_comparison": "offer rank must be >= rank of the occupation in which most relied-on qualifying work experience was acquired",
+      "teer_rank_higher_is_higher": {"0": 4, "1": 3, "2": 2, "3": 2, "4": 1},
+      "healthcare_exception": {
+        "eligible_experience_codes": ["31301", "32101"],
+        "eligible_offer_codes": ["33102", "44101"],
+        "requires_verified_exception_experience": true
+      },
+      "recent_graduate_exception": {"requires_verified_IRPR_87_3_5_status": true},
+      "guidance_discrepancy": "Retain IRPR 87.3(6)(d)–(7) as authority. The separate IRCC work-experience table does not display the TEER 2/3 equal rank."
+    },
+    "PNP_EXPRESS_ENTRY": {
+      "authority": ["IRPR-87", "IRCC-PNP-EE"],
+      "requires_verified_stream_rule": true,
+      "requires_nomination": true,
+      "requires_eligibility_in_one_of": ["FSW", "CEC", "FSTP"]
+    },
+    "PNP_NON_EXPRESS_ENTRY": {
+      "authority": ["IRPR-87", "IRCC-PNP-NON-EE"],
+      "requires_verified_stream_rule": true,
+      "requires_nomination": true
+    },
+    "EXPRESS_ENTRY_CATEGORY": {
+      "authority": ["IRCC-EE-INSTRUCTIONS", "IRCC-EE-CATEGORIES"],
+      "requires_verified_category_and_applicable_round_instructions": true,
+      "requires_express_entry_program_eligibility": true,
+      "requires_separate_crs_and_invitation_assessment": true
+    },
+    "RCIP_FCIP": {
+      "authority": ["IRCC-RCIP-WORK", "IRCC-COMMUNITY-PILOTS-HIRE"],
+      "requires_verified_pilot_and_community_rule": true,
+      "teer_5_rule_when_experience_required": "same_five_digit_NOC_for_qualifying_work_and_offer"
+    }
+  }
+}
