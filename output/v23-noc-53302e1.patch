+    return out(matched ? 'PASS_OCCUPATION_GATE' : 'FAIL_OCCUPATION_GATE', matched ? 'IN_SPECIFIED_TRADE_SET' : 'OUTSIDE_SPECIFIED_TRADE_SET');
+  }
+  if (programId === 'AIP') {
+    const ex = rule.healthcare_exception as { eligible_experience_codes: string[]; eligible_offer_codes: string[] };
+    if (!(rule.eligible_offer_teer as number[]).includes(teer)) return out('FAIL_OCCUPATION_GATE', 'OFFER_TEER_OUTSIDE_RULE');
+    if (facts.recentGraduateVerified === true) return out('PASS_OCCUPATION_GATE', 'VERIFIED_RECENT_GRADUATE_EXEMPTION');
+    if (facts.healthcareExceptionVerified === true) {
+      if (facts.healthcareExperienceCode !== undefined && (await teerOf(facts.healthcareExperienceCode)) === null) return { error: `Invalid five-digit NOC ${NOC_VERSION} unit code: ${String(facts.healthcareExperienceCode).slice(0, 12)}` };
+      if (facts.healthcareExperienceCode && ex.eligible_experience_codes.includes(facts.healthcareExperienceCode) && ex.eligible_offer_codes.includes(code)) return out('PASS_OCCUPATION_GATE', 'VERIFIED_HEALTHCARE_EXCEPTION');
+    }
+    if (facts.experienceCode === undefined) return out('INDETERMINATE', 'MOST_RELIED_ON_OCCUPATION_REQUIRED');
+    const expTeer = await teerOf(facts.experienceCode);
+    if (expTeer === null) return { error: `Invalid five-digit NOC ${NOC_VERSION} unit code: ${String(facts.experienceCode).slice(0, 12)}` };
+    const ranks = rule.teer_rank_higher_is_higher as Record<string, number>;
+    if ((rule.eligible_experience_teer as number[]).includes(expTeer) && facts.experienceRestricted === false && ranks[String(teer)] >= ranks[String(expTeer)])
+      return out('PASS_OCCUPATION_GATE', 'OFFER_AND_EXPERIENCE_TEER_CHECK_PASSED');
+    if (facts.recentGraduateVerified !== false) return out('INDETERMINATE', 'GRADUATE_EXEMPTION_STATUS_UNKNOWN');
+    if (ex.eligible_offer_codes.includes(code) && facts.healthcareExceptionVerified !== false
+      && (facts.healthcareExperienceCode === undefined || ex.eligible_experience_codes.includes(facts.healthcareExperienceCode)))
+      return out('INDETERMINATE', 'HEALTHCARE_EXCEPTION_REQUIRES_REVIEW');
+    if (!(rule.eligible_experience_teer as number[]).includes(expTeer)) return out('FAIL_OCCUPATION_GATE', 'EXPERIENCE_TEER_OUTSIDE_RULE');
+    if (facts.experienceRestricted === true) return out('FAIL_OCCUPATION_GATE', 'RESTRICTED_EXPERIENCE_OCCUPATION');
+    if (facts.experienceRestricted !== false) return out('INDETERMINATE', 'EXPERIENCE_RESTRICTION_STATUS_UNKNOWN');
+    return out('FAIL_OCCUPATION_GATE', 'OFFER_RANK_BELOW_EXPERIENCE_RANK');
+  }
+  return out('RULE_NOT_VERIFIED', 'ADDITIONAL_STREAM_OR_ROUND_RULE_REQUIRED');
+}
+
+// 2016 V1.3 → 2021 V1.0 correspondence. Many-to-many; duties must be re-matched on the new version.
+export async function crosswalkFrom(oldCode: string, lang: 'en' | 'fr' = 'en') {
+  const snap = await activeSnapshot(); if (!snap || !/^[0-9]{4}$/.test(oldCode)) return null;
+  const rows = await getDb().select({ toCode: nocCrosswalk.toCode, toTitle: nocCrosswalk.toTitle, fromTitle: nocCrosswalk.fromTitle, gsim: nocCrosswalk.gsimChange, notes: nocCrosswalk.notes })
+    .from(nocCrosswalk).where(and(eq(nocCrosswalk.snapshotId, snap.snapshotId), eq(nocCrosswalk.fromCode, oldCode), eq(nocCrosswalk.sourceLanguage, lang))).orderBy(nocCrosswalk.toCode);
+  return { fromVersion: '2016-v1.3', toVersion: NOC_VERSION, fromCode: oldCode, mappings: rows, note: 'العلاقة قد تكون متعددًا إلى متعدد؛ إعادة مطابقة المهام على الإصدار الجديد لازمة.' };
+}
diff --git a/lib/noc-import.ts b/lib/noc-import.ts
new file mode 100644
index 0000000..c435e13
--- /dev/null
+++ b/lib/noc-import.ts
@@ -0,0 +1,169 @@
+// Import one version-pinned NOC 2021 snapshot into the office database. The package is far larger than a single
+// request, so it is staged in verified chunks: every chunk carries its own SHA-256, the server chains those digests,
+// and activation only happens when the chain and the row counts match what the caller declared up front. Re-sending the
+// same fingerprint is a no-op (idempotent). A different fingerprint becomes a new snapshot id, so evaluations stay bound
+// to the snapshot they were decided on. Nothing here writes to a client file.
+import { and, eq, sql } from 'drizzle-orm';
+import { getDb } from '@/db';
+import { nocSnapshots, nocNodes, nocElements, nocCrosswalk, nocPolicies } from '@/db/schema';
+import { NOC_VERSION, LICENSE, SECTIONS, type Section } from './noc-catalog';
+
+export const EXPECTED = { nodes: 822, byLevel: { 1: 10, 2: 45, 3: 89, 4: 162, 5: 516 } as Record<number, number>, elements: 44037 + 45882, crosswalk: 1170 };
+export const GENESIS_CHAIN = '0'.repeat(64);
+
+export type CatalogRecord = { noc_version: string; code: string; level: string; parent_code: string | null; broad_category: string; teer: number | null;
+  localized: Record<'en' | 'fr', { source_record: number; level_label: string; title: string; definition: string; sections?: Record<string, { source_record: number; text: string }[]> }> };
+export type CrosswalkRecord = { from_version: string; to_version: string; source_language: 'en' | 'fr'; source_record: number; from_code: string; to_code: string; from_title: string; to_title: string; gsim_change: string; notes: string };
+
+export const sha256Hex = async (input: Uint8Array | string) => {
+  const data = typeof input === 'string' ? new TextEncoder().encode(input) : input;
+  return [...new Uint8Array(await crypto.subtle.digest('SHA-256', data as BufferSource))].map(b => b.toString(16).padStart(2, '0')).join('');
+};
+// Chain of chunk digests, in the order the caller sends them. Identical on the client and the server.
+export const chainNext = (prev: string, chunkSha: string) => sha256Hex(prev + ':' + chunkSha);
+export const snapshotIdOf = (chainSha: string) => `noc-${NOC_VERSION}-${chainSha.slice(0, 12)}`;
+
+// Structural checks on one chunk of catalog records. Full-package invariants (counts per level, parentage) are checked
+// at activation, when every row is in the staging table.
+export function verifyNodes(rows: CatalogRecord[]): string | null {
+  for (const r of rows) {
+    if (r.noc_version !== NOC_VERSION) return `unexpected version ${r.noc_version}`;
+    if (!/^[0-9]{1,5}$/.test(r.code)) return `invalid code ${r.code}`;
+    const level = r.code.length;
+    if (level > 1 && !/^[0-5]$/.test(r.code.charAt(1))) return `invalid TEER digit in ${r.code}`;
+    if (r.teer !== (level >= 2 ? Number(r.code.charAt(1)) : null)) return `TEER mismatch for ${r.code}`;
+    if (r.broad_category !== r.code.charAt(0)) return `broad category mismatch for ${r.code}`;
+    if ((r.parent_code ?? null) !== (level > 1 ? r.code.slice(0, -1) : null)) return `parent mismatch for ${r.code}`;
+    for (const lang of ['en', 'fr'] as const) {
+      const l = r.localized?.[lang];
+      if (!l || !l.title?.trim() || !l.definition?.trim() || !(l.source_record >= 1)) return `missing ${lang} text for ${r.code}`;
+      if (level === 5) {
+        if (!l.sections) return `missing sections for ${r.code} (${lang})`;
+        for (const s of Object.keys(l.sections)) if (!SECTIONS.includes(s as Section)) return `unknown section ${s}`;
+        for (const k of ['all_examples', 'illustrative_examples', 'main_duties', 'employment_requirements']) if (!l.sections[k]?.length) return `empty required section ${k} for ${r.code} (${lang})`;
+      }
+    }
+  }
+  return null;
+}
+export function verifyCrosswalk(rows: CrosswalkRecord[]): string | null {
+  for (const c of rows) {
+    if (!/^[0-9]{4}$/.test(c.from_code) || !/^[0-9]{5}$/.test(c.to_code)) return `invalid crosswalk codes ${c.from_code}→${c.to_code}`;
+    if (c.source_language !== 'en' && c.source_language !== 'fr') return 'invalid crosswalk language';
+    if (!c.from_title?.trim() || !c.to_title?.trim() || !c.gsim_change?.trim()) return `incomplete crosswalk row ${c.source_record}`;
+  }
+  return null;
+}
+
+// D1 allows at most 100 bound parameters per statement, so each insert batch is sized by its column count.
+const chunk = <T,>(rows: T[], size: number) => { const out: T[][] = []; for (let i = 0; i < rows.length; i += size) out.push(rows.slice(i, i + size)); return out; };
+
+export type Staged = { snapshotId: string; chain: string; nodes: number; elements: number; crosswalkRows: number; status: string };
+
+export async function beginSnapshot(declaredChain: string, manifestSha256: string, actor: string): Promise<Staged> {
+  const db = getDb(), snapshotId = snapshotIdOf(declaredChain);
+  const [existing] = await db.select().from(nocSnapshots).where(eq(nocSnapshots.snapshotId, snapshotId)).limit(1);
+  if (!existing) await db.insert(nocSnapshots).values({ snapshotId, nocVersion: NOC_VERSION, manifestSha256, catalogSha256: declaredChain, crosswalkSha256: declaredChain, licenseSource: LICENSE,
+    status: 'STAGING', expectedNodes: EXPECTED.nodes, expectedElements: EXPECTED.elements, expectedCrosswalk: EXPECTED.crosswalk, importedBy: actor, importedAt: new Date().toISOString(), activatedAt: null });
+  return counts(snapshotId);
+}
+
+export async function counts(snapshotId: string): Promise<Staged> {
+  const db = getDb();
+  const [[n], [e], [c], [s]] = await Promise.all([
+    db.select({ n: sql<number>`count(*)` }).from(nocNodes).where(eq(nocNodes.snapshotId, snapshotId)),
+    db.select({ n: sql<number>`count(*)` }).from(nocElements).where(eq(nocElements.snapshotId, snapshotId)),
+    db.select({ n: sql<number>`count(*)` }).from(nocCrosswalk).where(eq(nocCrosswalk.snapshotId, snapshotId)),
+    db.select({ status: nocSnapshots.status, chain: nocSnapshots.catalogSha256 }).from(nocSnapshots).where(eq(nocSnapshots.snapshotId, snapshotId)).limit(1),
+  ]);
+  return { snapshotId, chain: s?.chain ?? '', nodes: n.n, elements: e.n, crosswalkRows: c.n, status: s?.status ?? 'MISSING' };
+}
+
+async function staging(snapshotId: string) {
+  const [s] = await getDb().select().from(nocSnapshots).where(eq(nocSnapshots.snapshotId, snapshotId)).limit(1);
+  if (!s) throw new Error('unknown snapshot');
+  if (s.status === 'ACTIVE') return { snapshot: s, done: true as const };
+  if (s.status !== 'STAGING') throw new Error(`snapshot is ${s.status}`);
+  return { snapshot: s, done: false as const };
+}
+
+export async function stageNodes(snapshotId: string, rows: CatalogRecord[]): Promise<Staged> {
+  const st = await staging(snapshotId); if (st.done) return counts(snapshotId);
+  const problem = verifyNodes(rows); if (problem) throw new Error('NOC chunk rejected: ' + problem);
+  const db = getDb();
+  for (const part of chunk(rows, 8))
+    await db.insert(nocNodes).values(part.map(r => ({ snapshotId, code: r.code, level: r.code.length, parentCode: r.parent_code, broadCategory: r.broad_category, teer: r.teer,
+      titleEn: r.localized.en.title, titleFr: r.localized.fr.title, definitionEn: r.localized.en.definition, definitionFr: r.localized.fr.definition,
+      sourceRecordEn: r.localized.en.source_record, sourceRecordFr: r.localized.fr.source_record }))).onConflictDoNothing();
+  const elements: { snapshotId: string; code: string; lang: string; section: string; sourceRecord: number; text: string }[] = [];
+  const fts: { code: string; lang: string; section: string; rec: number; body: string }[] = [];
+  for (const r of rows) for (const lang of ['en', 'fr'] as const) {
+    const sections = r.localized[lang].sections; if (!sections) continue;
+    fts.push({ code: r.code, lang, section: 'lead_statement', rec: r.localized[lang].source_record, body: `${r.localized[lang].title}\n${r.localized[lang].definition}` });
+    for (const [section, items] of Object.entries(sections)) for (const it of items) {
+      elements.push({ snapshotId, code: r.code, lang, section, sourceRecord: it.source_record, text: it.text });
+      fts.push({ code: r.code, lang, section, rec: it.source_record, body: it.text });
+    }
+  }
+  for (const part of chunk(elements, 16)) await db.insert(nocElements).values(part).onConflictDoNothing();
+  for (const part of chunk(fts, 16)) {
+    const values = sql.join(part.map(f => sql`(${snapshotId},${f.code},${f.lang},${f.section},${f.rec},${f.body})`), sql`,`);
+    await db.run(sql`INSERT INTO noc_fts (snapshot_id, code, lang, section, source_record, body) VALUES ${values}`);
+  }
+  return counts(snapshotId);
+}
+
+export async function stageCrosswalk(snapshotId: string, rows: CrosswalkRecord[]): Promise<Staged> {
+  const st = await staging(snapshotId); if (st.done) return counts(snapshotId);
+  const problem = verifyCrosswalk(rows); if (problem) throw new Error('NOC chunk rejected: ' + problem);
+  const db = getDb();
+  for (const part of chunk(rows, 9))
+    await db.insert(nocCrosswalk).values(part.map(c => ({ snapshotId, sourceLanguage: c.source_language, sourceRecord: c.source_record, fromVersion: c.from_version, toVersion: c.to_version,
+      fromCode: c.from_code, toCode: c.to_code, fromTitle: c.from_title, toTitle: c.to_title, gsimChange: c.gsim_change, notes: c.notes || '' }))).onConflictDoNothing();
+  return counts(snapshotId);
+}
+
+export type ActivateResult = Staged & { activated: boolean; policySnapshotId: string | null };
+
+// Final gate: the declared chain, the counts per level, parentage, bilingual parity and crosswalk targets are all
+// checked against the staged rows before a single statement promotes the snapshot.
+export async function activateSnapshot(snapshotId: string, declaredChain: string, policy: { json: string; sha256: string } | undefined): Promise<ActivateResult> {
+  const db = getDb(), now = new Date().toISOString();
+  const st = await staging(snapshotId);
+  if (st.done) return { ...(await counts(snapshotId)), activated: false, policySnapshotId: await activePolicyId() };
+  if (snapshotIdOf(declaredChain) !== snapshotId) throw new Error('chain does not match the snapshot id');
+
+  const c = await counts(snapshotId);
+  if (c.nodes !== EXPECTED.nodes || c.elements !== EXPECTED.elements || c.crosswalkRows !== EXPECTED.crosswalk) {
+    await db.update(nocSnapshots).set({ status: 'FAILED' }).where(and(eq(nocSnapshots.snapshotId, snapshotId), eq(nocSnapshots.status, 'STAGING')));
+    throw new Error(`NOC staging counts mismatch: nodes ${c.nodes}/${EXPECTED.nodes}, elements ${c.elements}/${EXPECTED.elements}, crosswalk ${c.crosswalkRows}/${EXPECTED.crosswalk}`);
+  }
+  const levels = await db.all<{ level: number; n: number }>(sql`SELECT level, count(*) AS n FROM noc_nodes WHERE snapshot_id = ${snapshotId} GROUP BY level`);
+  for (const [level, n] of Object.entries(EXPECTED.byLevel)) if (levels.find(x => x.level === Number(level))?.n !== n) throw new Error(`level ${level} count mismatch`);
+  const [orphans] = await db.all<{ n: number }>(sql`SELECT count(*) AS n FROM noc_nodes c WHERE c.snapshot_id = ${snapshotId} AND c.parent_code IS NOT NULL AND NOT EXISTS (SELECT 1 FROM noc_nodes p WHERE p.snapshot_id = c.snapshot_id AND p.code = c.parent_code)`);
+  if (orphans.n) throw new Error(`${orphans.n} nodes without a parent`);
+  const [langs] = await db.all<{ en: number; fr: number }>(sql`SELECT sum(lang='en') AS en, sum(lang='fr') AS fr FROM (SELECT DISTINCT code, lang FROM noc_elements WHERE snapshot_id = ${snapshotId})`);
+  if (langs.en !== EXPECTED.byLevel[5] || langs.fr !== EXPECTED.byLevel[5]) throw new Error('bilingual unit coverage mismatch');
+  const [badCross] = await db.all<{ n: number }>(sql`SELECT count(*) AS n FROM noc_crosswalk x WHERE x.snapshot_id = ${snapshotId} AND NOT EXISTS (SELECT 1 FROM noc_nodes p WHERE p.snapshot_id = x.snapshot_id AND p.code = x.to_code)`);
+  if (badCross.n) throw new Error(`${badCross.n} crosswalk targets are not in the catalog`);
+
+  let policySnapshotId: string | null = null;
+  if (policy) {
+    const p = JSON.parse(policy.json) as { policy_snapshot_id: string; noc_version: string; reviewed_on: string };
+    if (p.noc_version !== NOC_VERSION) throw new Error('policy is pinned to a different NOC version');
+    policySnapshotId = p.policy_snapshot_id;
+    await db.insert(nocPolicies).values({ policySnapshotId, nocVersion: p.noc_version, reviewedOn: p.reviewed_on, sha256: policy.sha256, policyJson: policy.json, status: 'STAGING', importedAt: now }).onConflictDoNothing();
+  }
+  await db.update(nocSnapshots).set({ status: 'SUPERSEDED' }).where(eq(nocSnapshots.status, 'ACTIVE'));
+  await db.update(nocSnapshots).set({ status: 'ACTIVE', activatedAt: now }).where(and(eq(nocSnapshots.snapshotId, snapshotId), eq(nocSnapshots.status, 'STAGING')));
+  if (policySnapshotId) {
+    await db.update(nocPolicies).set({ status: 'SUPERSEDED' }).where(eq(nocPolicies.status, 'ACTIVE'));
+    await db.update(nocPolicies).set({ status: 'ACTIVE' }).where(eq(nocPolicies.policySnapshotId, policySnapshotId));
+  }
+  return { ...(await counts(snapshotId)), activated: true, policySnapshotId };
+}
+
+async function activePolicyId() {
+  const [p] = await getDb().select({ id: nocPolicies.policySnapshotId }).from(nocPolicies).where(eq(nocPolicies.status, 'ACTIVE')).limit(1);
+  return p?.id ?? null;
+}
