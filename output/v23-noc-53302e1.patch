+  for (const bad of ['0001', '00000', '1234', '160000', 'abcde']) assert.equal((await send('/api/office/noc-catalog?action=unit&code=' + encodeURIComponent(bad))).status, bad === '00000' ? 404 : 400, bad);
+  const stored = await db.prepare("SELECT typeof(code) t FROM noc_nodes WHERE code='00010'").first();
