+
+test('retrieval: documented duties surface the right units with their source records, and the rank never becomes a decision', async () => {
+  const r = await json(await send('/api/office/noc-catalog?action=search&q=' + encodeURIComponent('Operate forklift, pallet stacking and inventory tracking in a warehouse')), 200);
+  const codes = r.candidates.map(c => c.code);
+  assert.ok(codes.some(c => ['75101', '14400', '14401'].includes(c)), JSON.stringify(codes));
+  assert.ok(r.candidates.every(c => /^[0-9][0-5][0-9]{3}$/.test(c.code) && typeof c.teer === 'number'));
