+#!/usr/bin/env python3
+"""Evaluate the occupation-code gate only. Full immigration assessments live outside this file."""
+import argparse
+import json
+import re
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+PASS = "PASS_OCCUPATION_GATE"
+FAIL = "FAIL_OCCUPATION_GATE"
+UNKNOWN = "INDETERMINATE"
+UNVERIFIED = "RULE_NOT_VERIFIED"
+
+
+class OccupationalGate:
+    def __init__(self):
+        self.rules = json.loads((ROOT / "data/noc-policy.json").read_text(encoding="utf-8"))
+        self.programs = self.rules["programs"]
+        self.codes = {}
+        with (ROOT / "data/catalog.jsonl").open(encoding="utf-8") as handle:
+            for line in handle:
+                record = json.loads(line)
+                if record["level"] == "unit_group":
+                    self.codes[record["code"]] = record["teer"]
+        if len(self.codes) != 516:
+            raise ValueError("Expected 516 NOC unit groups")
+
+    def teer(self, code):
+        if not isinstance(code, str) or not re.fullmatch(r"[0-9]{5}", code) or code not in self.codes:
+            raise ValueError(f"Invalid five-digit NOC 2021 unit code: {code!r}")
+        return self.codes[code]
+
+    def result(self, program, status, reason):
+        return {"program_id": program, "status": status, "reason_code": reason,
+                "source_ids": self.programs[program]["authority"]}
+
+    def evaluate(self, program, code, *, restricted=None, experience_code=None, experience_restricted=None,
+                 recent_graduate_verified=None, healthcare_experience_code=None,
+                 healthcare_exception_verified=None):
+        teer = self.teer(code)
+        if program not in self.programs:
+            raise ValueError(f"Unknown program ID: {program!r}")
+        if program in ("FSW", "CEC"):
+            if teer not in self.programs[program]["eligible_teer"]:
+                return self.result(program, FAIL, "TEER_OUTSIDE_RULE")
+            if restricted is True:
+                return self.result(program, FAIL, "RESTRICTED_OCCUPATION")
+            if restricted is not False:
+                return self.result(program, UNKNOWN, "RESTRICTED_OCCUPATION_STATUS_UNKNOWN")
+            return self.result(program, PASS, "TEER_AND_RESTRICTION_CHECK_PASSED")
+        if program == "FSTP":
+            rule = self.programs[program]
+            matched = (code in rule["include_unit_groups"] or code[:4] in rule["include_minor_groups"]
+                       or (code[:2] in rule["include_major_groups"] and code[:3] not in rule["exclude_sub_major_groups"]))
+            return self.result(program, PASS if matched else FAIL,
+                               "IN_SPECIFIED_TRADE_SET" if matched else "OUTSIDE_SPECIFIED_TRADE_SET")
+        if program == "AIP":
+            return self.aip(code, teer, experience_code, experience_restricted, recent_graduate_verified,
+                            healthcare_experience_code, healthcare_exception_verified)
+        return self.result(program, UNVERIFIED, "ADDITIONAL_STREAM_OR_ROUND_RULE_REQUIRED")
+
+    def aip(self, code, teer, experience_code, experience_restricted, recent_graduate_verified,
+            healthcare_experience_code, healthcare_exception_verified):
+        rule = self.programs["AIP"]
+        if teer not in rule["eligible_offer_teer"]:
+            return self.result("AIP", FAIL, "OFFER_TEER_OUTSIDE_RULE")
+        if recent_graduate_verified is True:
+            return self.result("AIP", PASS, "VERIFIED_RECENT_GRADUATE_EXEMPTION")
+        exception = rule["healthcare_exception"]
+        if healthcare_exception_verified is True:
+            self.teer(healthcare_experience_code)
+            if (healthcare_experience_code in exception["eligible_experience_codes"]
+                    and code in exception["eligible_offer_codes"]):
+                return self.result("AIP", PASS, "VERIFIED_HEALTHCARE_EXCEPTION")
+        if experience_code is None:
+            return self.result("AIP", UNKNOWN, "MOST_RELIED_ON_OCCUPATION_REQUIRED")
+        experience_teer = self.teer(experience_code)
+        ranks = rule["teer_rank_higher_is_higher"]
+        if (experience_teer in rule["eligible_experience_teer"] and experience_restricted is False
+                and ranks[str(teer)] >= ranks[str(experience_teer)]):
+            return self.result("AIP", PASS, "OFFER_AND_EXPERIENCE_TEER_CHECK_PASSED")
+        if recent_graduate_verified is not False:
+            return self.result("AIP", UNKNOWN, "GRADUATE_EXEMPTION_STATUS_UNKNOWN")
+        if code in exception["eligible_offer_codes"] and healthcare_exception_verified is not False:
+            if healthcare_experience_code is None or healthcare_experience_code in exception["eligible_experience_codes"]:
+                return self.result("AIP", UNKNOWN, "HEALTHCARE_EXCEPTION_REQUIRES_REVIEW")
+        if experience_teer not in rule["eligible_experience_teer"]:
+            return self.result("AIP", FAIL, "EXPERIENCE_TEER_OUTSIDE_RULE")
+        if experience_restricted is True:
+            return self.result("AIP", FAIL, "RESTRICTED_EXPERIENCE_OCCUPATION")
+        if experience_restricted is not False:
+            return self.result("AIP", UNKNOWN, "EXPERIENCE_RESTRICTION_STATUS_UNKNOWN")
+        return self.result("AIP", FAIL, "OFFER_RANK_BELOW_EXPERIENCE_RANK")
+
+
+def self_test(gate):
+    def expect(expected, program, code, **kwargs):
+        actual = gate.evaluate(program, code, **kwargs)["status"]
+        if actual != expected:
+            raise RuntimeError(f"Unexpected outcome for {program} {code}: {actual}, expected {expected}")
+
+    for code in ("63202", "62200", "72200", "73300"):
+        expect(PASS, "FSTP", code)
+    for code in ("72600", "93200", "33100", "75101"):
+        expect(FAIL, "FSTP", code)
+    expect(PASS, "FSW", "00010", restricted=False)
+    expect(UNKNOWN, "FSW", "00010")
+    expect(FAIL, "CEC", "00010", restricted=True)
+    expect(FAIL, "CEC", "14101", restricted=False)
+    expect(FAIL, "FSW", "75101", restricted=False)
+    expect(FAIL, "AIP", "75101", recent_graduate_verified=True)
+    ordinary = {"experience_restricted": False, "recent_graduate_verified": False,
+                "healthcare_exception_verified": False}
+    expect(PASS, "AIP", "22220", experience_code="63202", **ordinary)
+    expect(PASS, "AIP", "63202", experience_code="22220", **ordinary)
+    expect(FAIL, "AIP", "63202", experience_code="21231", **ordinary)
+    expect(PASS, "AIP", "44101", healthcare_experience_code="31301", healthcare_exception_verified=True)
+    expect(UNKNOWN, "AIP", "44101", experience_code="31301", experience_restricted=False,
+           recent_graduate_verified=False)
+    expect(PASS, "AIP", "14101", recent_graduate_verified=True)
+    expect(UNVERIFIED, "PNP_NON_EXPRESS_ENTRY", "75101")
+    for bad in ("0001", "00000", "1234\n", 10, "１２３４５"):
+        try:
+            gate.evaluate("FSW", bad)
+        except ValueError:
+            continue
+        raise RuntimeError(f"Invalid code accepted: {bad!r}")
+    print("Occupation gate checks passed.")
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--self-test", action="store_true")
+    parser.add_argument("--input", help="Path to JSON object with program, code and optional verified facts")
+    args = parser.parse_args()
+    if args.self_test == bool(args.input):
+        parser.error("provide exactly one of --self-test or --input")
+    gate = OccupationalGate()
+    if args.self_test:
+        self_test(gate)
+    else:
+        raw = json.loads(Path(args.input).read_text(encoding="utf-8"))
+        print(json.dumps(gate.evaluate(**raw), ensure_ascii=False))
+
+
+if __name__ == "__main__":
+    main()
