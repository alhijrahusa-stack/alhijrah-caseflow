+// NOC 2021 Version 1.0 reference catalog inside the office database: version-pinned snapshots (staging → active),
+// code validation and lookup, the keyword retrieval engine over the official published texts, and the occupational
+// gate from the imported policy. Everything here is deterministic and server-side; the model never supplies a code,
+// a title or a reference — it can only ask for them. Search rank is a display order, never proof of duty performance.
+import { and, eq, inArray, sql } from 'drizzle-orm';
+import { getDb } from '@/db';
+import { nocSnapshots, nocNodes, nocElements, nocCrosswalk, nocPolicies } from '@/db/schema';
+
+export const NOC_VERSION = '2021-v1.0';
+export const SECTIONS = ['illustrative_examples', 'all_examples', 'inclusions', 'exclusions', 'main_duties', 'employment_requirements', 'additional_information'] as const;
+export type Section = typeof SECTIONS[number];
+export type Level = 1 | 2 | 3 | 4 | 5;
+
+// A unit group code is exactly five ASCII digits whose 2nd digit (TEER) is 0–5. Never store or compare codes as numbers.
+export const isUnitCode = (code: unknown): code is string => typeof code === 'string' && /^[0-9][0-5][0-9]{3}$/.test(code);
+export const isAnyCode = (code: unknown): code is string => typeof code === 'string' && /^[0-9]{1,5}$/.test(code) && (code.length === 1 || /^[0-5]$/.test(code.charAt(1)));
+
+export type ActiveSnapshot = { snapshotId: string; nocVersion: string; catalogSha256: string; activatedAt: string | null; licenseSource: string };
+export async function activeSnapshot(): Promise<ActiveSnapshot | null> {
+  const [s] = await getDb().select().from(nocSnapshots).where(eq(nocSnapshots.status, 'ACTIVE')).limit(1);
+  return s ? { snapshotId: s.snapshotId, nocVersion: s.nocVersion, catalogSha256: s.catalogSha256, activatedAt: s.activatedAt, licenseSource: s.licenseSource } : null;
+}
+
+export type NodeRow = { code: string; level: number; parentCode: string | null; teer: number | null; titleEn: string; titleFr: string; definitionEn: string; definitionFr: string; sourceRecordEn: number; sourceRecordFr: number };
+export async function nodeOf(snapshotId: string, code: string): Promise<NodeRow | null> {
+  if (!isAnyCode(code)) return null;
+  const [n] = await getDb().select().from(nocNodes).where(and(eq(nocNodes.snapshotId, snapshotId), eq(nocNodes.code, code))).limit(1);
+  return n ? { code: n.code, level: n.level, parentCode: n.parentCode, teer: n.teer, titleEn: n.titleEn, titleFr: n.titleFr, definitionEn: n.definitionEn, definitionFr: n.definitionFr, sourceRecordEn: n.sourceRecordEn, sourceRecordFr: n.sourceRecordFr } : null;
+}
+
+export type ElementRow = { section: Section; sourceRecord: number; text: string };
+export async function elementsOf(snapshotId: string, code: string, lang: 'en' | 'fr', sections: readonly Section[] = SECTIONS): Promise<ElementRow[]> {
+  const rows = await getDb().select({ section: nocElements.section, sourceRecord: nocElements.sourceRecord, text: nocElements.text }).from(nocElements)
+    .where(and(eq(nocElements.snapshotId, snapshotId), eq(nocElements.code, code), eq(nocElements.lang, lang), inArray(nocElements.section, [...sections])))
+    .orderBy(nocElements.sourceRecord);
+  return rows as ElementRow[];
+}
+
+// Published duty lines include generic lead-ins ("This group performs some or all of the following duties:") and branch
+// headings ending in a colon. They are kept with their source record, but flagged so they are never counted as duties.
+const LEAD_IN = /(performs? some or all of the following duties|effectuent une partie ou l'ensemble des fonctions suivantes|exercent une partie ou l'ensemble des fonctions suivantes)/i;
+export const dutyLineKind = (text: string): 'lead_in' | 'heading' | 'duty' => {
+  const t = text.trim();
+  if (LEAD_IN.test(t)) return 'lead_in';
+  if (/:\s*$/.test(t)) return 'heading';
+  return 'duty';
+};
+
+export type UnitDetail = {
+  snapshotId: string; code: string; teer: number; level: number; parentCode: string | null;
+  title: { en: string; fr: string }; leadStatement: { en: string; fr: string };
+  sections: Record<Section, { sourceRecord: number; text: string; kind?: 'lead_in' | 'heading' | 'duty' }[]>;
+  reference: { url: string; date: string; license: string };
+};
+export const SOURCE_URL = { en: 'https://www.statcan.gc.ca/en/subjects/standard/noc/2021/indexV1', fr: 'https://www.statcan.gc.ca/fr/sujets/norme/cnp/2021/indexV1' };
+export const LICENSE = 'Statistics Canada Open Licence — https://www.statcan.gc.ca/en/terms-conditions/open-licence';
+
+export async function unitDetail(code: string, lang: 'en' | 'fr' = 'en'): Promise<UnitDetail | null> {
+  const snap = await activeSnapshot(); if (!snap || !isUnitCode(code)) return null;
+  const node = await nodeOf(snap.snapshotId, code); if (!node || node.level !== 5 || node.teer === null) return null;
+  const rows = await elementsOf(snap.snapshotId, code, lang);
+  const sections = Object.fromEntries(SECTIONS.map(s => [s, [] as { sourceRecord: number; text: string; kind?: 'lead_in' | 'heading' | 'duty' }[]])) as UnitDetail['sections'];
+  for (const r of rows) sections[r.section].push(r.section === 'main_duties' ? { sourceRecord: r.sourceRecord, text: r.text, kind: dutyLineKind(r.text) } : { sourceRecord: r.sourceRecord, text: r.text });
+  return { snapshotId: snap.snapshotId, code, teer: node.teer, level: node.level, parentCode: node.parentCode,
+    title: { en: node.titleEn, fr: node.titleFr }, leadStatement: { en: node.definitionEn, fr: node.definitionFr },
+    sections, reference: { url: SOURCE_URL[lang], date: snap.activatedAt?.slice(0, 10) || '', license: LICENSE } };
+}
+
+// ---- Retrieval. NFKC + case folding + whitespace collapse on the search copy only; the stored text stays as published.
+export const searchNormalize = (s: string) => s.normalize('NFKC').toLowerCase().replace(/[ـً-ْ]/g, '').replace(/\s+/g, ' ').trim();
+const STOP = new Set(['and', 'or', 'the', 'of', 'to', 'in', 'for', 'with', 'a', 'an', 'on', 'by', 'as', 'at', 'from', 'et', 'ou', 'le', 'la', 'les', 'des', 'de', 'du', 'en', 'un', 'une']);
+export function searchTerms(text: string, max = 24): string[] {
+  const out: string[] = [], seen = new Set<string>();
+  for (const raw of searchNormalize(text).split(/[^\p{L}\p{N}]+/u)) {
+    const t = raw.trim();
+    if (t.length < 3 || STOP.has(t) || seen.has(t)) continue;
+    seen.add(t); out.push(t);
+    if (out.length >= max) break;
+  }
+  return out;
+}
+const SECTION_WEIGHT: Record<string, number> = { main_duties: 4, lead_statement: 3, all_examples: 2, illustrative_examples: 2, inclusions: 2, employment_requirements: 1, exclusions: 0.5, additional_information: 0.5 };
+
+export type Candidate = { code: string; title: string; teer: number; score: number; matches: { section: string; sourceRecord: number; lang: 'en' | 'fr'; snippet: string }[]; exact: boolean };
+// Candidate set = the explicit code (when valid) ∪ title matches ∪ duty/definition/inclusion matches. Ranked for display:
+// duty relevance, then definition, then title/inclusion, then code ascending. This is a search order, not a match ratio.
+export async function searchUnits(query: string, opts: { lang?: 'en' | 'fr'; limit?: number; code?: string } = {}): Promise<{ snapshotId: string; candidates: Candidate[]; terms: string[] } | null> {
+  const snap = await activeSnapshot(); if (!snap) return null;
+  const lang = opts.lang || 'en', limit = Math.min(Math.max(opts.limit ?? 4, 1), 20), terms = searchTerms(query);
+  const db = getDb(), scores = new Map<string, Candidate>();
+  const add = (code: string, title: string, teer: number, weight: number, m?: Candidate['matches'][number], exact = false) => {
+    const c = scores.get(code) || { code, title, teer, score: 0, matches: [], exact: false };
+    c.score += weight; c.exact = c.exact || exact;
+    if (m && c.matches.length < 6 && !c.matches.some(x => x.section === m.section && x.sourceRecord === m.sourceRecord)) c.matches.push(m);
+    scores.set(code, c);
+  };
+  if (opts.code && isUnitCode(opts.code)) {
+    const n = await nodeOf(snap.snapshotId, opts.code);
+    if (n && n.level === 5 && n.teer !== null) add(n.code, lang === 'fr' ? n.titleFr : n.titleEn, n.teer, 1000, undefined, true);
+  }
+  if (terms.length) {
+    const match = terms.map(t => `"${t.replace(/"/g, '')}"`).join(' OR ');
+    const hits = await db.all<{ code: string; section: string; source_record: number; body: string }>(sql`
+      SELECT code, section, source_record, snippet(noc_fts, 5, '[', ']', '…', 12) AS body FROM noc_fts
+      WHERE noc_fts MATCH ${match} AND snapshot_id = ${snap.snapshotId} AND lang = ${lang}
+      ORDER BY bm25(noc_fts) LIMIT 400`);
+    // Keep the hits of the strongest codes only: D1 allows at most 100 bound parameters per statement, and a broad
+    // query can touch hundreds of units. Ordering by bm25 above means the ones dropped here are the weakest.
+    const ranked: string[] = [];
+    for (const h of hits) { if (!ranked.includes(h.code)) ranked.push(h.code); if (ranked.length >= 60) break; }
+    const keep = new Set(ranked);
+    if (ranked.length) {
+      const nodes = await db.select({ code: nocNodes.code, teer: nocNodes.teer, titleEn: nocNodes.titleEn, titleFr: nocNodes.titleFr })
+        .from(nocNodes).where(and(eq(nocNodes.snapshotId, snap.snapshotId), inArray(nocNodes.code, ranked)));
+      const byCode = new Map(nodes.map(n => [n.code, n]));
+      for (const h of hits) {
+        if (!keep.has(h.code)) continue;
+        const n = byCode.get(h.code); if (!n || n.teer === null) continue;
+        add(h.code, lang === 'fr' ? n.titleFr : n.titleEn, n.teer, SECTION_WEIGHT[h.section] ?? 1,
+          { section: h.section, sourceRecord: h.source_record, lang, snippet: h.body.slice(0, 220) });
+      }
+    }
+  }
+  const candidates = [...scores.values()].sort((a, b) => b.score - a.score || a.code.localeCompare(b.code)).slice(0, limit);
+  return { snapshotId: snap.snapshotId, candidates, terms };
+}
+
+// ---- Occupational gate (data/noc-policy.json). Mirrors tools/occupational_gate.py; status values are the package's.
+export type GateStatus = 'PASS_OCCUPATION_GATE' | 'FAIL_OCCUPATION_GATE' | 'INDETERMINATE' | 'RULE_NOT_VERIFIED';
+export type GateFacts = { restricted?: boolean; experienceCode?: string; experienceRestricted?: boolean; recentGraduateVerified?: boolean; healthcareExperienceCode?: string; healthcareExceptionVerified?: boolean };
+export type GateResult = { programId: string; status: GateStatus; reasonCode: string; sourceIds: string[]; teer: number; policySnapshotId: string };
+type Policy = { policy_snapshot_id: string; programs: Record<string, Record<string, unknown>> };
+
+export async function activePolicy(): Promise<Policy | null> {
+  const [p] = await getDb().select().from(nocPolicies).where(eq(nocPolicies.status, 'ACTIVE')).limit(1);
+  return p ? JSON.parse(p.policyJson) as Policy : null;
+}
+
+export async function occupationGate(programId: string, code: string, facts: GateFacts = {}): Promise<GateResult | { error: string }> {
+  const snap = await activeSnapshot(), policy = await activePolicy();
