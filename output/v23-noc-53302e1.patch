+  await json(await send('/api/office'));
+
+  // The package exactly as shipped in the repository, verified against its own manifest before anything is imported.
+  const ROOT = path.resolve('reference/noc-2021-v1.0');
+  const sums = Object.fromEntries((await readFile(path.join(ROOT, 'SHA256SUMS'), 'utf8')).trim().split('\n').map(l => { const [d, p] = l.split('  '); return [p, d]; }));
+  const jsonl = async rel => { const raw = gunzipSync(await readFile(path.join(ROOT, rel + '.gz'))); assert.equal(sha(raw), sums[rel], rel); return raw.toString('utf8').trim().split('\n').map(l => JSON.parse(l)); };
+  const policyJson = await readFile(path.join(ROOT, 'data/noc-policy.json'), 'utf8');
+  assert.equal(sha(Buffer.from(policyJson)), sums['data/noc-policy.json']);
+  pkg = { catalog: await jsonl('data/catalog.jsonl'), crosswalk: await jsonl('data/crosswalk.jsonl'), policyJson, manifestSha256: sha(await readFile(path.join(ROOT, 'SHA256SUMS'))) };
+});
+test.after(async () => { await mf?.dispose(); });
+
+const chainNext = (prev, chunkSha) => sha(prev + ':' + chunkSha);
+const chunkOf = (rows, size) => { const out = []; for (let i = 0; i < rows.length; i += size) out.push(rows.slice(i, i + size)); return out; };
+let parts = [], chain = '0'.repeat(64), snapshotId = '';
+const buildParts = () => {
+  parts = [...chunkOf(pkg.catalog, 20).map(rows => ({ action: 'nodes', rows })), ...chunkOf(pkg.crosswalk, 300).map(rows => ({ action: 'crosswalk', rows }))];
+  chain = '0'.repeat(64);
+  for (const p of parts) { p.chunkSha256 = sha(Buffer.from(JSON.stringify(p.rows))); chain = chainNext(chain, p.chunkSha256); }
+  snapshotId = `noc-2021-v1.0-${chain.slice(0, 12)}`;
+};
+
+test('import: chunk digests are enforced, counts and parentage verified, one snapshot activated (admin only)', async () => {
+  buildParts();
+  assert.equal((await send('/api/office/noc-catalog?action=status', 'GET', undefined, outsider)).status, 403);
+  assert.equal((await send('/api/office/noc-catalog', 'POST', { action: 'begin', chain, manifestSha256: pkg.manifestSha256 }, outsider)).status, 403);
+  const before = await json(await send('/api/office/noc-catalog?action=status'), 200);
+  assert.equal(before.configured, false);
+
+  const begun = await json(await send('/api/office/noc-catalog', 'POST', { action: 'begin', chain, manifestSha256: pkg.manifestSha256 }), 201);
+  assert.equal(begun.snapshotId, snapshotId); assert.equal(begun.status, 'STAGING');
+
+  // A chunk whose declared digest does not match its rows is refused outright.
+  assert.equal((await send('/api/office/noc-catalog', 'POST', { action: 'nodes', snapshotId, chunkSha256: 'f'.repeat(64), rows: parts[0].rows })).status, 400);
+  // Activation before the rows are staged fails and never leaves a half-imported catalog active.
+  assert.equal((await send('/api/office/noc-catalog', 'POST', { action: 'activate', snapshotId, chain })).status, 500);
+  assert.equal((await json(await send('/api/office/noc-catalog?action=status'), 200)).configured, false);
+  await db.prepare("UPDATE noc_snapshots SET status='STAGING' WHERE snapshot_id=?").bind(snapshotId).run();
+
+  let last;
+  for (const p of parts) last = await json(await send('/api/office/noc-catalog', 'POST', { ...p, snapshotId }), 200);
+  assert.equal(last.nodes, 822); assert.equal(last.elements, 44037 + 45882); assert.equal(last.crosswalkRows, 1170);
+
+  const r = await json(await send('/api/office/noc-catalog', 'POST', { action: 'activate', snapshotId, chain, policyJson: pkg.policyJson }), 200);
+  assert.equal(r.activated, true); assert.equal(r.policySnapshotId, 'ca-noc-occupation-rules-2026-11-17');
+
+  const levels = (await db.prepare('SELECT level, count(*) n FROM noc_nodes GROUP BY level ORDER BY level').all()).results;
+  assert.deepEqual(levels, [{ level: 1, n: 10 }, { level: 2, n: 45 }, { level: 3, n: 89 }, { level: 4, n: 162 }, { level: 5, n: 516 }]);
+  const orphans = await db.prepare('SELECT count(*) n FROM noc_nodes c WHERE c.parent_code IS NOT NULL AND NOT EXISTS (SELECT 1 FROM noc_nodes p WHERE p.snapshot_id=c.snapshot_id AND p.code=c.parent_code)').first();
+  assert.equal(orphans.n, 0);
+  const teerMismatch = await db.prepare('SELECT count(*) n FROM noc_nodes WHERE level>=2 AND teer <> CAST(substr(code,2,1) AS INTEGER)').first();
+  assert.equal(teerMismatch.n, 0);
+  assert.equal((await db.prepare("SELECT count(DISTINCT code) n FROM noc_elements WHERE lang='en'").first()).n, 516);
+  assert.equal((await db.prepare("SELECT count(DISTINCT code) n FROM noc_elements WHERE lang='fr'").first()).n, 516);
+  assert.equal((await db.prepare("SELECT count(*) n FROM noc_snapshots WHERE status='ACTIVE'").first()).n, 1);
+
+  const status = await json(await send('/api/office/noc-catalog?action=status'), 200);
+  assert.equal(status.configured, true); assert.equal(status.snapshot.nocVersion, '2021-v1.0');
+  assert.match(status.license, /statcan\.gc\.ca\/en\/terms-conditions\/open-licence/);
+
+  // Idempotent: re-sending the same fingerprint changes nothing and never duplicates rows.
+  await json(await send('/api/office/noc-catalog', 'POST', { action: 'begin', chain, manifestSha256: pkg.manifestSha256 }), 201);
+  const again = await json(await send('/api/office/noc-catalog', 'POST', { ...parts[0], snapshotId }), 200);
+  assert.equal(again.nodes, 822);
+  const final = await json(await send('/api/office/noc-catalog', 'POST', { action: 'activate', snapshotId, chain, policyJson: pkg.policyJson }), 200);
+  assert.equal(final.activated, false); assert.equal(final.status, 'ACTIVE');
+  assert.equal((await db.prepare('SELECT count(*) n FROM noc_nodes').first()).n, 822);
+  assert.equal((await db.prepare('SELECT count(*) n FROM noc_elements').first()).n, 44037 + 45882);
+});
+
+test('codes and published text: 00010 is a unit, 0001 is not a job code, numeric coercion is rejected, duty lead-ins are marked', async () => {
+  const unit = await json(await send('/api/office/noc-catalog?action=unit&code=00010'), 200);
+  assert.equal(unit.code, '00010'); assert.equal(unit.teer, 0); assert.equal(unit.title.en, 'Legislators');
