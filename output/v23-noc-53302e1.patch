+
+test('occupation gate: FSTP trade set, AIP TEER 2/3 both directions, TEER 5 fails, healthcare exception; other programs are not verified', async () => {
+  const gate = async (program, code, extra = '') => json(await send(`/api/office/noc-catalog?action=gate&program=${program}&code=${code}${extra}`), 200);
+  for (const code of ['63202', '62200', '72200', '73300']) assert.equal((await gate('FSTP', code)).status, 'PASS_OCCUPATION_GATE', code);
