diff --git a/drizzle/0035_v23_noc_catalog.sql b/drizzle/0035_v23_noc_catalog.sql
new file mode 100644
index 0000000..5329d65
--- /dev/null
+++ b/drizzle/0035_v23_noc_catalog.sql
@@ -0,0 +1,65 @@
+-- v2.3 NOC 2021 Version 1.0 reference catalog (Statistics Canada / ESDC, open licence). Version-pinned snapshots are
+-- imported into a staging state, verified by fingerprint and counts, and activated in one statement; one snapshot is
+-- active at a time. Nodes, elements and crosswalk rows are immutable. Codes are ASCII digit strings, never numbers.
+CREATE TABLE noc_snapshots(
+ snapshot_id TEXT PRIMARY KEY NOT NULL,
+ noc_version TEXT NOT NULL,
+ manifest_sha256 TEXT NOT NULL CHECK(length(manifest_sha256)=64),
+ catalog_sha256 TEXT NOT NULL CHECK(length(catalog_sha256)=64),
+ crosswalk_sha256 TEXT NOT NULL CHECK(length(crosswalk_sha256)=64),
+ license_source TEXT NOT NULL,
+ status TEXT NOT NULL CHECK(status IN('STAGING','ACTIVE','SUPERSEDED','FAILED')),
+ expected_nodes INTEGER NOT NULL,
+ expected_elements INTEGER NOT NULL,
+ expected_crosswalk INTEGER NOT NULL,
+ imported_by TEXT NOT NULL,
+ imported_at TEXT NOT NULL,
+ activated_at TEXT);--> statement-breakpoint
+CREATE UNIQUE INDEX noc_one_active ON noc_snapshots(status) WHERE status='ACTIVE';--> statement-breakpoint
+CREATE TABLE noc_nodes(
+ snapshot_id TEXT NOT NULL REFERENCES noc_snapshots(snapshot_id),
+ code TEXT NOT NULL CHECK(code GLOB '[0-9]*' AND code NOT GLOB '*[^0-9]*' AND length(code) BETWEEN 1 AND 5),
+ level INTEGER NOT NULL CHECK(level=length(code)),
+ parent_code TEXT,
+ broad_category TEXT NOT NULL CHECK(broad_category=substr(code,1,1)),
+ teer INTEGER CHECK(teer IS NULL OR (teer BETWEEN 0 AND 5 AND teer=CAST(substr(code,2,1) AS INTEGER))),
+ title_en TEXT NOT NULL, title_fr TEXT NOT NULL,
+ definition_en TEXT NOT NULL, definition_fr TEXT NOT NULL,
+ source_record_en INTEGER NOT NULL, source_record_fr INTEGER NOT NULL,
+ PRIMARY KEY(snapshot_id,code));--> statement-breakpoint
+CREATE INDEX noc_nodes_parent ON noc_nodes(snapshot_id,parent_code);--> statement-breakpoint
+CREATE TABLE noc_elements(
+ snapshot_id TEXT NOT NULL REFERENCES noc_snapshots(snapshot_id),
+ code TEXT NOT NULL,
+ lang TEXT NOT NULL CHECK(lang IN('en','fr')),
+ section TEXT NOT NULL CHECK(section IN('illustrative_examples','all_examples','inclusions','exclusions','main_duties','employment_requirements','additional_information')),
+ source_record INTEGER NOT NULL CHECK(source_record>=1),
+ text TEXT NOT NULL,
+ PRIMARY KEY(snapshot_id,code,lang,source_record),
+ FOREIGN KEY(snapshot_id,code) REFERENCES noc_nodes(snapshot_id,code));--> statement-breakpoint
+CREATE INDEX noc_elements_section ON noc_elements(snapshot_id,code,lang,section);--> statement-breakpoint
+CREATE TABLE noc_crosswalk(
+ snapshot_id TEXT NOT NULL REFERENCES noc_snapshots(snapshot_id),
+ source_language TEXT NOT NULL CHECK(source_language IN('en','fr')),
+ source_record INTEGER NOT NULL,
+ from_version TEXT NOT NULL, to_version TEXT NOT NULL,
+ from_code TEXT NOT NULL CHECK(length(from_code)=4), to_code TEXT NOT NULL CHECK(length(to_code)=5),
+ from_title TEXT NOT NULL, to_title TEXT NOT NULL, gsim_change TEXT NOT NULL, notes TEXT NOT NULL DEFAULT '',
+ PRIMARY KEY(snapshot_id,source_language,source_record));--> statement-breakpoint
+CREATE INDEX noc_crosswalk_from ON noc_crosswalk(snapshot_id,from_code);--> statement-breakpoint
+CREATE TABLE noc_policies(
+ policy_snapshot_id TEXT PRIMARY KEY NOT NULL,
+ noc_version TEXT NOT NULL,
+ reviewed_on TEXT NOT NULL,
+ sha256 TEXT NOT NULL CHECK(length(sha256)=64),
+ policy_json TEXT NOT NULL CHECK(json_valid(policy_json)),
+ status TEXT NOT NULL CHECK(status IN('STAGING','ACTIVE','SUPERSEDED')),
+ imported_at TEXT NOT NULL);--> statement-breakpoint
+CREATE UNIQUE INDEX noc_policy_one_active ON noc_policies(status) WHERE status='ACTIVE';--> statement-breakpoint
+CREATE VIRTUAL TABLE noc_fts USING fts5(snapshot_id UNINDEXED, code UNINDEXED, lang UNINDEXED, section UNINDEXED, source_record UNINDEXED, body, tokenize='unicode61 remove_diacritics 2');--> statement-breakpoint
+CREATE TRIGGER noc_nodes_no_update BEFORE UPDATE ON noc_nodes BEGIN SELECT RAISE(ABORT,'NOC_IMMUTABLE'); END;--> statement-breakpoint
+CREATE TRIGGER noc_nodes_no_delete BEFORE DELETE ON noc_nodes BEGIN SELECT RAISE(ABORT,'NOC_IMMUTABLE'); END;--> statement-breakpoint
+CREATE TRIGGER noc_elements_no_update BEFORE UPDATE ON noc_elements BEGIN SELECT RAISE(ABORT,'NOC_IMMUTABLE'); END;--> statement-breakpoint
+CREATE TRIGGER noc_elements_no_delete BEFORE DELETE ON noc_elements BEGIN SELECT RAISE(ABORT,'NOC_IMMUTABLE'); END;--> statement-breakpoint
+CREATE TRIGGER noc_crosswalk_no_update BEFORE UPDATE ON noc_crosswalk BEGIN SELECT RAISE(ABORT,'NOC_IMMUTABLE'); END;--> statement-breakpoint
+CREATE TRIGGER noc_crosswalk_no_delete BEFORE DELETE ON noc_crosswalk BEGIN SELECT RAISE(ABORT,'NOC_IMMUTABLE'); END;
