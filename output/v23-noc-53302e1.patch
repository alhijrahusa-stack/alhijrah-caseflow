   const profile=JSON.parse(c.profile) as Profile,a=JSON.parse(c.assessment) as EngineAssessment;
   const facts=[['الاسم',profile.fullName],['رقم الملف',c.reference],['الهاتف',profile.phone],['البريد',profile.email],['بلد الإقامة',profile.country],['الجنسية',profile.nationality],['المهنة',profile.occupation],['NOC / TEER',`${profile.noc||'—'} / ${a.derived?.teer??'—'}`],['الخبرة (مشتقة من الوظائف)',a.derived?`${a.derived.experience3??'غير محسوبة'} شهرًا خلال 3 سنوات · ${a.derived.experience10??'غير محسوبة'} خلال 10 سنوات`:'—'],['المؤهل',educationLabels[profile.education]],['المجتمع',profile.community],['حالة المتابعة',statusLabels[c.status]],['المسار',pathwayLabels[c.pathway]],['الأولوية',priorityLabels[c.priority]],['مسؤول المتابعة',c.assignedTo],['جهة الإحالة المسجلة',c.referralTo],['موافقة المشاركة المسجلة',c.sharingConsent?'مسجلة بواسطة الموظف':'غير مسجلة']];
   return <main className="report-page"><header><div><strong>ALHIJRAH SERVICES</strong><p>CANADA DESK · تقرير متابعة داخلي</p></div><div className="print-controls"><a className="button subtle" href={'/?candidate='+encodeURIComponent(c.id)}>العودة للملف</a><PrintButton/></div></header><h1>ملخص ملف المتقدم</h1><p className="report-meta">وقت إعداد التقرير (UTC): {new Date().toISOString()} · نسخة القواعد: {a.ruleVersion}</p><dl className="report-facts">{facts.map(([label,value])=><div key={label}><dt>{label}</dt><dd>{value||'غير متحقق'}</dd></div>)}</dl><div className="report-notice">اكتمال البيانات: {a.completeness}% · الإجراء المقترح: {a.nextAction}<br/>المؤشرات مبنية على المدخلات، ولا تمثل اعتماد أهلية أو قبولًا حكوميًا.</div>{a.pathways.map(p=><section key={p.id} className="report-section"><h2>{p.title} · {p.state==='potential'?'مؤشرات أولية مستوفاة':p.state==='incomplete'?'يحتاج استكمالًا':'لا يطابق بعض المدخلات'}</h2><table><thead><tr><th>الشرط</th><th>المؤشر</th></tr></thead><tbody>{p.checks.map((c,i)=><tr key={i}><td><a href={c.source}>{c.label}</a></td><td>{c.state==='pass'?'بحسب المدخلات':c.state==='fail'?'غير مطابق':'غير متحقق'}</td></tr>)}</tbody></table><p>{p.caveat}</p></section>)}<section className="report-section"><h2>المستندات المسجلة</h2>{files.length?<table><thead><tr><th>المستند</th><th>التصنيف</th><th>مراجعة الموظف</th></tr></thead><tbody>{files.map(f=><tr key={f.id}><td>{f.name}</td><td>{documentLabels[f.category]}</td><td>{f.verified?'تمت':'لم تتم'}</td></tr>)}</tbody></table>:<p>لم ترفع مستندات.</p>}</section><section className="report-section"><h2>مهام المتابعة</h2>{work.length?<table><thead><tr><th>المهمة</th><th>موعد المتابعة</th><th>الحالة</th></tr></thead><tbody>{work.map(t=><tr key={t.id}><td>{t.title}</td><td>{t.dueDate||'بلا موعد'}</td><td>{t.status==='done'?'منجزة':'مفتوحة'}</td></tr>)}</tbody></table>:<p>لا توجد مهام مسجلة.</p>}</section><footer>تقرير داخلي من بيانات الملف. مواعيد المتابعة ليست مهلًا حكومية.</footer></main>;
