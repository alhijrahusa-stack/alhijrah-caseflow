+  const digest = sha(await readFile(path.join(ROOT, rel)));
+  if (sums[rel] !== digest) throw new Error(`manifest mismatch: ${rel}`);
+  present.push(rel);
+}
+const readJsonl = async rel => {
+  const gz = path.join(ROOT, rel + '.gz');
+  const raw = await readFile(gz).then(gunzipSync);
+  const digest = sha(raw);
+  if (sums[rel] !== digest) throw new Error(`manifest mismatch: ${rel} (decompressed)`);
+  return { rows: raw.toString('utf8').trim().split('\n').map(l => JSON.parse(l)), digest };
+};
+const catalog = await readJsonl('data/catalog.jsonl');
+const crosswalk = await readJsonl('data/crosswalk.jsonl');
+const policyJson = await readFile(path.join(ROOT, 'data/noc-policy.json'), 'utf8');
+const manifestSha256 = sha(await readFile(path.join(ROOT, 'SHA256SUMS')));
+
+const chainNext = (prev, chunkSha) => sha(prev + ':' + chunkSha);
+const chunk = (rows, size) => { const out = []; for (let i = 0; i < rows.length; i += size) out.push(rows.slice(i, i + size)); return out; };
+const NODE_CHUNK = 20, CROSS_CHUNK = 300;
+const parts = [
+  ...chunk(catalog.rows, NODE_CHUNK).map(rows => ({ action: 'nodes', rows })),
+  ...chunk(crosswalk.rows, CROSS_CHUNK).map(rows => ({ action: 'crosswalk', rows })),
+];
+let chain = '0'.repeat(64);
+for (const p of parts) { p.chunkSha256 = sha(JSON.stringify(p.rows)); chain = chainNext(chain, p.chunkSha256); }
+const snapshotId = `noc-2021-v1.0-${chain.slice(0, 12)}`;
+
+const summary = { verifiedFiles: present.length + 2, nodes: catalog.rows.length, units: catalog.rows.filter(r => r.level === 'unit_group').length,
+  crosswalkRows: crosswalk.rows.length, catalogSha256: catalog.digest, crosswalkSha256: crosswalk.digest, manifestSha256, chain, snapshotId, requests: parts.length + 2 };
+console.log(JSON.stringify(summary, null, 2));
+if (args.get('dry-run') === 'true' || !args.get('url')) { console.log('dry run: nothing posted'); process.exit(0); }
+
+const headers = { 'content-type': 'application/json' };
+for (let i = 2; i < process.argv.length; i++) if (process.argv[i] === '--header') { const [k, ...v] = process.argv[i + 1].split(':'); headers[k.trim().toLowerCase()] = v.join(':').trim(); }
+const url = new URL('/api/office/noc-catalog', args.get('url'));
+const post = async body => {
+  for (let attempt = 1; ; attempt++) {
+    const res = await fetch(url, { method: 'POST', headers, body: JSON.stringify(body) });
+    const text = await res.text();
+    if (res.ok) return JSON.parse(text);
+    if (attempt >= 4 || res.status < 500) throw new Error(`${body.action} failed ${res.status}: ${text.slice(0, 300)}`);
+    await new Promise(r => setTimeout(r, 400 * attempt));
+  }
+};
+console.log('begin', JSON.stringify(await post({ action: 'begin', chain, manifestSha256 })));
+let done = 0;
+for (const p of parts) {
+  const r = await post({ ...p, snapshotId });
+  if (++done % 10 === 0 || done === parts.length) console.log(`staged ${done}/${parts.length} · nodes ${r.nodes} · elements ${r.elements} · crosswalk ${r.crosswalkRows}`);
+}
+const final = await post({ action: 'activate', snapshotId, chain, policyJson });
+console.log('activated', JSON.stringify(final));
+process.exit(final.activated || final.status === 'ACTIVE' ? 0 : 1);
