+    if (facts.restricted === true) return out('FAIL_OCCUPATION_GATE', 'RESTRICTED_OCCUPATION');
+    if (facts.restricted !== false) return out('INDETERMINATE', 'RESTRICTED_OCCUPATION_STATUS_UNKNOWN');
