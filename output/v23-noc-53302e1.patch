+  assert.equal((await gate('AIP', '63202', '&experienceCode=22220' + ordinary)).status, 'PASS_OCCUPATION_GATE');
+  assert.equal((await gate('AIP', '63202', '&experienceCode=21231' + ordinary)).status, 'FAIL_OCCUPATION_GATE');
+  assert.equal((await gate('AIP', '75101', '&recentGraduateVerified=true')).status, 'FAIL_OCCUPATION_GATE');
+  assert.equal((await gate('AIP', '44101', '&healthcareExperienceCode=31301&healthcareExceptionVerified=true')).status, 'PASS_OCCUPATION_GATE');
+  assert.equal((await gate('AIP', '44101', '&experienceCode=31301&experienceRestricted=false&recentGraduateVerified=false')).status, 'INDETERMINATE');
+  const pnp = await gate('PNP_NON_EXPRESS_ENTRY', '75101');
