diff --git a/app/api/office/noc-catalog/route.ts b/app/api/office/noc-catalog/route.ts
new file mode 100644
index 0000000..3a65047
--- /dev/null
+++ b/app/api/office/noc-catalog/route.ts
@@ -0,0 +1,83 @@
+import { z } from 'zod';
+import { activeSnapshot, activePolicy, searchUnits, unitDetail, occupationGate, crosswalkFrom, isUnitCode, NOC_VERSION, LICENSE, SOURCE_URL } from '@/lib/noc-catalog';
+import { beginSnapshot, stageNodes, stageCrosswalk, activateSnapshot, sha256Hex, type CatalogRecord, type CrosswalkRecord } from '@/lib/noc-import';
+import { staffWith, sameOrigin, readJson, errorResponse, ApiError } from '@/lib/server';
+import { appendAudit } from '@/lib/audit-chain';
+
+// Office-only NOC 2021 reference catalog. GET reports the active snapshot, searches the official texts, opens one unit
+// group, runs the occupational gate, or resolves a 2016 code. POST (admin) imports and activates a version-pinned
+// snapshot. The catalog is reference data: it never decides a case and never writes to a client file.
+export async function GET(request: Request) {
+  try {
+    await staffWith('view_crm');
+    const q = new URL(request.url).searchParams, action = q.get('action') || 'status';
+    const snap = await activeSnapshot();
+    if (action === 'status') {
+      const policy = await activePolicy();
+      return Response.json({ configured: !!snap, snapshot: snap, policySnapshotId: policy?.policy_snapshot_id ?? null, nocVersion: NOC_VERSION, license: LICENSE, sources: SOURCE_URL });
+    }
+    if (!snap) throw new ApiError(409, 'كتالوج NOC 2021 غير مفعّل في قواعد المكتب.');
+    if (action === 'search') {
+      const text = (q.get('q') || '').slice(0, 600), code = q.get('code') || undefined;
+      if (!text.trim() && !code) throw new ApiError(400, 'اكتب نص المهام أو الرمز للبحث.');
+      const r = await searchUnits(text, { lang: q.get('lang') === 'fr' ? 'fr' : 'en', limit: Number(q.get('limit') || 4), code });
+      return Response.json({ ...r, note: 'ترتيب بحث للعرض فقط؛ لا يثبت أداء المهام ولا يتحول إلى نسبة مطابقة.' });
+    }
+    if (action === 'unit') {
+      const code = q.get('code') || '';
+      if (!isUnitCode(code)) throw new ApiError(400, 'رمز الوحدة المهنية خمس خانات، والخانة الثانية TEER من 0 إلى 5.');
+      const unit = await unitDetail(code, q.get('lang') === 'fr' ? 'fr' : 'en');
+      if (!unit) throw new ApiError(404, 'الرمز غير منشور في اللقطة المفعّلة.');
+      return Response.json(unit);
+    }
+    if (action === 'gate') {
+      const r = await occupationGate(q.get('program') || '', q.get('code') || '', {
+        restricted: bool(q.get('restricted')), experienceCode: q.get('experienceCode') || undefined, experienceRestricted: bool(q.get('experienceRestricted')),
+        recentGraduateVerified: bool(q.get('recentGraduateVerified')), healthcareExperienceCode: q.get('healthcareExperienceCode') || undefined, healthcareExceptionVerified: bool(q.get('healthcareExceptionVerified')),
+      });
+      if ('error' in r) throw new ApiError(400, r.error);
+      return Response.json({ ...r, note: 'بوابة مهنية فقط؛ الأهلية الكاملة وCRS والترشيح والدعوة تُقيَّم مستقلة.' });
+    }
+    if (action === 'crosswalk') {
+      const r = await crosswalkFrom(q.get('code') || '', q.get('lang') === 'fr' ? 'fr' : 'en');
+      if (!r) throw new ApiError(400, 'رمز NOC 2016 من أربع خانات.');
+      return Response.json(r);
+    }
+    throw new ApiError(400, 'إجراء غير معروف.');
+  } catch (e) { return errorResponse(e); }
+}
+
+const bool = (v: string | null) => v === null || v === '' ? undefined : v === 'true' || v === '1';
+
+const importSchema = z.discriminatedUnion('action', [
+  z.object({ action: z.literal('begin'), chain: z.string().regex(/^[0-9a-f]{64}$/), manifestSha256: z.string().regex(/^[0-9a-f]{64}$/) }).strict(),
+  z.object({ action: z.literal('nodes'), snapshotId: z.string().max(80), chunkSha256: z.string().regex(/^[0-9a-f]{64}$/), rows: z.array(z.record(z.string(), z.unknown())).min(1).max(60) }).strict(),
+  z.object({ action: z.literal('crosswalk'), snapshotId: z.string().max(80), chunkSha256: z.string().regex(/^[0-9a-f]{64}$/), rows: z.array(z.record(z.string(), z.unknown())).min(1).max(400) }).strict(),
+  z.object({ action: z.literal('activate'), snapshotId: z.string().max(80), chain: z.string().regex(/^[0-9a-f]{64}$/), policyJson: z.string().max(60_000).optional() }).strict(),
+]);
+
+// Staged import: begin → nodes/crosswalk chunks (each verified by its own digest) → activate. Admin capability only.
+export async function POST(request: Request) {
+  try {
+    sameOrigin(request);
+    const s = await staffWith('seal_rules'), actor = s.user.email;
+    const data = await readJson(request, importSchema, 900_000);
+    if (data.action === 'begin') {
+      const staged = await beginSnapshot(data.chain, data.manifestSha256, actor);
+      return Response.json({ ...staged, expectedChain: data.chain }, { status: 201 });
+    }
+    if (data.action === 'nodes' || data.action === 'crosswalk') {
+      const body = JSON.stringify(data.rows);
+      if (await sha256Hex(body) !== data.chunkSha256) throw new ApiError(400, 'بصمة الدفعة لا تطابق محتواها.');
+      const staged = data.action === 'nodes'
+        ? await stageNodes(data.snapshotId, data.rows as unknown as CatalogRecord[])
+        : await stageCrosswalk(data.snapshotId, data.rows as unknown as CrosswalkRecord[]);
+      return Response.json(staged);
+    }
+    const result = await activateSnapshot(data.snapshotId, data.chain, data.policyJson ? { json: data.policyJson, sha256: await sha256Hex(data.policyJson) } : undefined);
+    if (result.activated) await appendAudit({ caseId: null, actor, event: 'NOC_CATALOG_IMPORT', version: result.snapshotId,
+      diff: { nodes: result.nodes, elements: result.elements, crosswalk: result.crosswalkRows, policy: result.policySnapshotId, chain: result.chain } });
+    return Response.json(result);
+  } catch (e) { return errorResponse(e); }
+}
+
