+  const c = await json(await send('/api/candidates', 'POST', { fullName: 'NOC Synthetic Case', phone: '+15557770001', consent: true, occupation: 'Industrial electrician', noc: '72201',
+    jobs: [{ title: 'Industrial electrician', employer: 'Synthetic Employer LLC', country: 'Yemen', start: '2020-01', end: '2025-06', weekly_hours: 40, duties: 'Install, examine, replace and repair electrical wiring, receptacles, switch boxes and conduits in an industrial plant; test circuits and troubleshoot motors.' }] }), 201);
