From 53302e1aff92d493aeeb4a2f0a5f64f3ae41db13 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 17 Nov 2026 06:48:38 +0000
Subject: [PATCH 2/2] NOC seed as SQL for the operator path (same chain
 fingerprint, same activation gate)

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01RQZ57XDCVxFYqkyqLENrNp
---
 scripts/noc-seed-sql.mjs | 45 ++++++++++++++++++++++++++++++++++++++++
 1 file changed, 45 insertions(+)
 create mode 100644 scripts/noc-seed-sql.mjs

diff --git a/scripts/noc-seed-sql.mjs b/scripts/noc-seed-sql.mjs
new file mode 100644
index 0000000..f309424
--- /dev/null
+++ b/scripts/noc-seed-sql.mjs
@@ -0,0 +1,45 @@
+#!/usr/bin/env node
+// Generate the staged NOC 2021 import as plain SQL for `wrangler d1 execute --file` (operator path when no office session
+// is available). Same package verification, same chain fingerprint and snapshot id as scripts/noc-import.mjs, same
+// counts gate: activation statements only take effect when every expected row is present.
+import { readFile, writeFile } from 'node:fs/promises';
+import { createHash } from 'node:crypto';
+import { gunzipSync } from 'node:zlib';
+import path from 'node:path';
+const ROOT = path.resolve('reference/noc-2021-v1.0'), out = process.argv[2] || 'noc-seed.sql';
+const actor = process.argv[3] || 'operator';
+const sha = b => createHash('sha256').update(b).digest('hex');
+const sums = Object.fromEntries((await readFile(path.join(ROOT, 'SHA256SUMS'), 'utf8')).trim().split('\n').map(l => { const [d, p] = l.split('  '); return [p, d]; }));
+const jsonl = async rel => { const raw = gunzipSync(await readFile(path.join(ROOT, rel + '.gz'))); if (sha(raw) !== sums[rel]) throw new Error('manifest mismatch ' + rel); return raw.toString('utf8').trim().split('\n').map(l => JSON.parse(l)); };
+const catalog = await jsonl('data/catalog.jsonl'), crosswalk = await jsonl('data/crosswalk.jsonl');
+const policyJson = await readFile(path.join(ROOT, 'data/noc-policy.json'), 'utf8'); if (sha(Buffer.from(policyJson)) !== sums['data/noc-policy.json']) throw new Error('manifest mismatch policy');
+const manifestSha256 = sha(await readFile(path.join(ROOT, 'SHA256SUMS')));
+const chunk = (rows, n) => { const o = []; for (let i = 0; i < rows.length; i += n) o.push(rows.slice(i, i + n)); return o; };
+const parts = [...chunk(catalog, 20).map(rows => ({ rows })), ...chunk(crosswalk, 300).map(rows => ({ rows }))];
+let chain = '0'.repeat(64); for (const p of parts) chain = sha(chain + ':' + sha(JSON.stringify(p.rows)));
+const snapshotId = `noc-2021-v1.0-${chain.slice(0, 12)}`, now = new Date().toISOString();
+const q = v => v === null || v === undefined ? 'NULL' : typeof v === 'number' ? String(v) : `'${String(v).replace(/\0/g, '').replace(/'/g, "''")}'`;
+const EXP = { nodes: 822, elements: 44037 + 45882, crosswalk: 1170 };
+const lines = [];
+lines.push(`INSERT OR IGNORE INTO noc_snapshots (snapshot_id,noc_version,manifest_sha256,catalog_sha256,crosswalk_sha256,license_source,status,expected_nodes,expected_elements,expected_crosswalk,imported_by,imported_at,activated_at) VALUES (${q(snapshotId)},'2021-v1.0',${q(manifestSha256)},${q(chain)},${q(chain)},'Statistics Canada Open Licence — https://www.statcan.gc.ca/en/terms-conditions/open-licence','STAGING',${EXP.nodes},${EXP.elements},${EXP.crosswalk},${q(actor)},${q(now)},NULL);`);
+for (const part of chunk(catalog, 50)) lines.push('INSERT OR IGNORE INTO noc_nodes (snapshot_id,code,level,parent_code,broad_category,teer,title_en,title_fr,definition_en,definition_fr,source_record_en,source_record_fr) VALUES ' + part.map(r => `(${q(snapshotId)},${q(r.code)},${r.code.length},${q(r.parent_code)},${q(r.broad_category)},${q(r.teer)},${q(r.localized.en.title)},${q(r.localized.fr.title)},${q(r.localized.en.definition)},${q(r.localized.fr.definition)},${r.localized.en.source_record},${r.localized.fr.source_record})`).join(',') + ';');
+const elements = [], fts = [];
+for (const r of catalog) for (const lang of ['en', 'fr']) {
+  const sections = r.localized[lang].sections; if (!sections) continue;
+  fts.push([r.code, lang, 'lead_statement', r.localized[lang].source_record, `${r.localized[lang].title}\n${r.localized[lang].definition}`]);
+  for (const [section, items] of Object.entries(sections)) for (const it of items) { elements.push([r.code, lang, section, it.source_record, it.text]); fts.push([r.code, lang, section, it.source_record, it.text]); }
+}
+for (const part of chunk(elements, 200)) lines.push('INSERT OR IGNORE INTO noc_elements (snapshot_id,code,lang,section,source_record,text) VALUES ' + part.map(e => `(${q(snapshotId)},${e.map(q).join(',')})`).join(',') + ';');
+lines.push(`DELETE FROM noc_fts WHERE snapshot_id=${q(snapshotId)};`);
+for (const part of chunk(fts, 200)) lines.push('INSERT INTO noc_fts (snapshot_id,code,lang,section,source_record,body) VALUES ' + part.map(e => `(${q(snapshotId)},${e.map(q).join(',')})`).join(',') + ';');
+for (const part of chunk(crosswalk, 200)) lines.push('INSERT OR IGNORE INTO noc_crosswalk (snapshot_id,source_language,source_record,from_version,to_version,from_code,to_code,from_title,to_title,gsim_change,notes) VALUES ' + part.map(c => `(${q(snapshotId)},${q(c.source_language)},${c.source_record},${q(c.from_version)},${q(c.to_version)},${q(c.from_code)},${q(c.to_code)},${q(c.from_title)},${q(c.to_title)},${q(c.gsim_change)},${q(c.notes || '')})`).join(',') + ';');
+const policy = JSON.parse(policyJson);
+lines.push(`INSERT OR IGNORE INTO noc_policies (policy_snapshot_id,noc_version,reviewed_on,sha256,policy_json,status,imported_at) VALUES (${q(policy.policy_snapshot_id)},${q(policy.noc_version)},${q(policy.reviewed_on)},${q(sha(Buffer.from(policyJson)))},${q(policyJson)},'STAGING',${q(now)});`);
+// Activation gate: every count must match, and the chain-derived snapshot id is the only one promoted.
+const gate = `(SELECT count(*) FROM noc_nodes WHERE snapshot_id=${q(snapshotId)})=${EXP.nodes} AND (SELECT count(*) FROM noc_elements WHERE snapshot_id=${q(snapshotId)})=${EXP.elements} AND (SELECT count(*) FROM noc_crosswalk WHERE snapshot_id=${q(snapshotId)})=${EXP.crosswalk} AND (SELECT count(*) FROM noc_nodes c WHERE c.snapshot_id=${q(snapshotId)} AND c.parent_code IS NOT NULL AND NOT EXISTS (SELECT 1 FROM noc_nodes p WHERE p.snapshot_id=c.snapshot_id AND p.code=c.parent_code))=0`;
+lines.push(`UPDATE noc_snapshots SET status='SUPERSEDED' WHERE status='ACTIVE' AND snapshot_id<>${q(snapshotId)} AND ${gate};`);
+lines.push(`UPDATE noc_snapshots SET status='ACTIVE', activated_at=${q(now)} WHERE snapshot_id=${q(snapshotId)} AND status='STAGING' AND ${gate};`);
+lines.push(`UPDATE noc_policies SET status='SUPERSEDED' WHERE status='ACTIVE' AND policy_snapshot_id<>${q(policy.policy_snapshot_id)} AND EXISTS (SELECT 1 FROM noc_snapshots WHERE snapshot_id=${q(snapshotId)} AND status='ACTIVE');`);
+lines.push(`UPDATE noc_policies SET status='ACTIVE' WHERE policy_snapshot_id=${q(policy.policy_snapshot_id)} AND status='STAGING' AND EXISTS (SELECT 1 FROM noc_snapshots WHERE snapshot_id=${q(snapshotId)} AND status='ACTIVE');`);
+await writeFile(out, lines.join('\n') + '\n');
+console.log(JSON.stringify({ out, snapshotId, chain, statements: lines.length, nodes: catalog.length, elements: elements.length, fts: fts.length, crosswalk: crosswalk.length }));
