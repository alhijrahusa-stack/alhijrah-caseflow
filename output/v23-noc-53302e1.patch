diff --git a/drizzle/rollback/0034_0035_rollback.sql b/drizzle/rollback/0034_0035_rollback.sql
new file mode 100644
index 0000000..d2135e6
--- /dev/null
+++ b/drizzle/rollback/0034_0035_rollback.sql
@@ -0,0 +1,30 @@
+-- Rollback for migrations 0034 (قسم التقييمات) and 0035 (NOC 2021 catalog).
+-- Both migrations are additive: they create new tables, indexes and triggers and change no existing table, so dropping
+-- them restores the pre-0034 schema exactly. Any evaluation versions, audit answers, office actions, attachment
+-- readings and the imported NOC snapshot are destroyed with them — take a D1 export first, or use time-travel.
+-- Order matters: triggers, then the tables that reference others, then the referenced tables.
+DROP TRIGGER IF EXISTS noc_crosswalk_no_delete;
+DROP TRIGGER IF EXISTS noc_crosswalk_no_update;
+DROP TRIGGER IF EXISTS noc_elements_no_delete;
+DROP TRIGGER IF EXISTS noc_elements_no_update;
+DROP TRIGGER IF EXISTS noc_nodes_no_delete;
+DROP TRIGGER IF EXISTS noc_nodes_no_update;
+DROP TABLE IF EXISTS noc_fts;
+DROP TABLE IF EXISTS noc_crosswalk;
+DROP TABLE IF EXISTS noc_elements;
+DROP TABLE IF EXISTS noc_nodes;
+DROP TABLE IF EXISTS noc_policies;
+DROP TABLE IF EXISTS noc_snapshots;
+
+DROP TRIGGER IF EXISTS audit_answers_no_delete;
+DROP TRIGGER IF EXISTS audit_answers_no_update;
+DROP TRIGGER IF EXISTS evaluation_versions_no_delete;
+DROP TRIGGER IF EXISTS evaluation_versions_no_update;
+DROP TABLE IF EXISTS audit_runs;
+DROP TABLE IF EXISTS attachment_readings;
+DROP TABLE IF EXISTS evaluation_actions;
+DROP TABLE IF EXISTS audit_answers;
+DROP TABLE IF EXISTS evaluation_versions;
+
+-- Drizzle's applied-migration ledger: remove the two entries so a later deploy re-applies them cleanly.
+DELETE FROM d1_migrations WHERE name IN ('0034_v23_evaluations.sql', '0035_v23_noc_catalog.sql');
