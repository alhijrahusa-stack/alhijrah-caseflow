+let mf, db, send, caseId;
+const json = async (r, status = 200) => { const t = await r.text(); assert.equal(r.status, status, t); return t ? JSON.parse(t) : null; };
+const today = torontoDate(Date.now());
+const plusDays = n => new Date(Date.parse(today + 'T12:00:00Z') + n * 86400000).toISOString().slice(0, 10);
+const profile = { fullName: 'QA Desk Applicant', phone: '+15553339001', email: 'qa-desk@example.test', consent: true, jobs: [{ title: 'QA role', employer: 'QA employer', country: 'Yemen', start: '2024-01', end: '2024-12', weekly_hours: 40 }], occupation: 'Synthetic test', noc: '72401', teer: 2, experience3: 12, experience10: 24, englishMin: 5, englishDate: '2026-10-01' };
+
+test.before(async () => {
+  const files = await readdir('dist/server', { recursive: true });
+  mf = new Miniflare({
+    modules: ['index.js', ...files.filter(f => f !== 'index.js' && f.endsWith('.js'))].map(f => ({ type: 'ESModule', path: path.resolve('dist/server', f) })),
+    modulesRoot: path.resolve('dist/server'), compatibilityDate: '2026-05-15', compatibilityFlags: ['nodejs_compat'],
+    d1Databases: { DB: 'desk-db' }, r2Buckets: ['BUCKET'], kvNamespaces: { PERMISSIONS_KV: 'desk-kv' },
+    durableObjects: { CHAT_ROOMS: 'CaseChatRoom' },
+    bindings: { TRUST_SITES_IDENTITY_HEADERS: '1', OFFICE_ADMIN_EMAIL: 'admin@example.test', APP_SECRET: 'd'.repeat(64), PERMISSIONS_KV_NAMESPACE: 'test' },
+    outboundService: async () => new Response('blocked', { status: 599 }),
+  });
+  send = (p, method = 'GET', body, headers = {}) => mf.dispatchFetch(base + p, { method, headers: { ...(body ? { 'content-type': 'application/json' } : {}), ...headers }, body: body ? JSON.stringify(body) : undefined });
+  db = await mf.getD1Database('DB');
+  for (const f of (await readdir('drizzle')).filter(f => f.endsWith('.sql')).sort())
+    for (const s of (await readFile('drizzle/' + f, 'utf8')).split('--> statement-breakpoint').map(s => s.trim()).filter(Boolean)) await db.prepare(s).run();
+  await seedOfficeManager(db, 'admin-1');
+  await json(await send('/api/office', 'GET', undefined, admin));
+  caseId = (await json(await send('/api/candidates', 'POST', profile, admin), 201)).id;
+});
+test.after(async () => { await mf?.dispose(); });
+
+test('staff dashboard is the command desk; classic layout stays reachable; anonymous gets the sign-in entry', async () => {
+  const desk = await (await send('/', 'GET', undefined, admin)).text();
+  assert.match(desk, /data-testid="command-desk"/);
+  assert.doesNotMatch(desk, /INITIAL_APPLICANTS|CANADIAN_EMPLOYERS_DB|Stanton Farms|portal\.careergate\.us\/u\//);
+  const classic = await (await send('/?view=classic', 'GET', undefined, admin)).text();
+  assert.doesNotMatch(classic, /data-testid="command-desk"/);
+  assert.match(classic, /app-shell/);
+  const anon = await (await send('/')).text();
+  assert.doesNotMatch(anon, /data-testid="command-desk"/);
+});
+
+test('desk data sources answer from D1 (cases, case detail, CRS, follow-ups, employers, notices)', async () => {
+  const list = await json(await send('/api/candidates?q=&status=&page=1', 'GET', undefined, admin));
+  assert.ok(list.items.some(c => c.id === caseId) && typeof list.total === 'number' && list.stats);
+  const c = await json(await send(`/api/candidates/${caseId}`, 'GET', undefined, admin));
+  assert.equal(c.profile.fullName, profile.fullName);
+  assert.ok(Array.isArray(c.assessment.missingDocuments));
+  const crs = await json(await send(`/api/candidates/${caseId}/crs`, 'GET', undefined, admin));
+  assert.ok('result' in crs && 'v22' in crs);
+  const tasks = await json(await send(`/api/tasks?candidateId=${caseId}&today=${today}`, 'GET', undefined, admin));
+  assert.ok(Array.isArray(tasks.items) && tasks.items.every(t => !t.dueDate), 'the new case has no scheduled follow-up yet (initial review task is undated)');
+  const board = await json(await send(`/api/office/employers?case=${caseId}`, 'GET', undefined, admin));
+  assert.ok(Array.isArray(board.employers) && Array.isArray(board.vacancies) && Array.isArray(board.applications));
+  // Mail is not configured here: the notice is stored and reported as needing configuration (never faked as sent).
+  const sent = await json(await send(`/api/candidates/${caseId}/messages`, 'POST', { requestKey: crypto.randomUUID(), subject: 'مستندات مطلوبة', body: 'يرجى رفع المستندات الناقصة.' }, admin));
+  assert.equal(sent.needsConfiguration, true);
+  assert.equal((await db.prepare('SELECT count(*) n FROM client_messages WHERE candidate_id=?').bind(caseId).first()).n, 1);
+});
+
+test('work-session gate: 400 FOLLOW_UP_REQUIRED without a follow-up from today on; closes once one is scheduled', async () => {
+  const close = () => send(`/api/candidates/${caseId}/workflow`, 'POST', { action: 'close_session' }, admin);
+  const events = async () => (await db.prepare("SELECT count(*) n FROM events WHERE candidate_id=? AND action='أُغلقت جلسة العمل'").bind(caseId).first()).n;
+  let r = await json(await close(), 400);
+  assert.equal(r.code, 'FOLLOW_UP_REQUIRED');
+  assert.equal(await events(), 0);
+  await json(await send('/api/tasks', 'POST', { mode: 'manual', candidateId: caseId, title: 'متابعة قديمة', dueDate: plusDays(-2) }, admin), 201);
+  await json(await send('/api/tasks', 'POST', { mode: 'manual', candidateId: caseId, title: 'بلا موعد' }, admin), 201);
+  r = await json(await close(), 400);
+  assert.equal(r.code, 'FOLLOW_UP_REQUIRED', 'past-dated and undated tasks are not a next follow-up');
+  await json(await send('/api/candidates/' + caseId + '/workflow', 'POST', { action: 'other' }, admin), 400);
+  await json(await send('/api/tasks', 'POST', { mode: 'manual', candidateId: caseId, title: 'متابعة الملف', dueDate: plusDays(3) }, admin), 201);
+  r = await json(await close());
+  assert.equal(r.nextFollowUp, plusDays(3));
+  assert.equal(await events(), 1);
+  await json(await send(`/api/candidates/${caseId}/workflow`, 'POST', { action: 'close_session' }), 401);
+});
