+'use client';
+// Staff dashboard (owner-supplied design). Every value shown comes from the existing D1-backed APIs:
+// cases /api/candidates, documents /api/candidates/:id/documents + /api/documents/:id, CRS /api/candidates/:id/crs,
+// AI review /api/candidates/:id/ai-review (AiCaseReview), employers /api/office/employers?case=, client notices
+// /api/candidates/:id/messages, follow-ups /api/tasks, work-session gate /api/candidates/:id/workflow (close_session).
+// No sample applicants, employers, cutoffs, scores or client links are embedded here.
+import { useCallback, useEffect, useMemo, useRef, useState } from 'react';
+import Link from 'next/link';
+import {
+  Users, FileText, AlertTriangle, Clock, Sparkles, Search, Plus, Menu, X, Send, ShieldCheck, Calendar, CreditCard,
+  MessageSquare, Briefcase, LayoutDashboard, ArrowUpRight, RefreshCw, FileCheck, Upload, Building, ExternalLink,
+  Inbox, ClipboardList, FileUp, BarChart3, FolderOpen, Route, BookOpen, Settings, LoaderCircle, LogOut, ChevronLeft,
+} from 'lucide-react';
+import { api, makeRequestId } from '@/lib/client';
+import { torontoDate } from '@/lib/v22-core';
+import { statusLabels, documentLabels, pathwayLabels } from '@/lib/model';
+import type { CandidateRecord, DocumentRecord, Profile } from '@/lib/model';
+import { PORTAL_ORIGIN } from '@/lib/branding';
+import { AiCaseReview } from '@/components/operations/ai-review';
+import { CaseIntelligence, EmployersBoard } from '@/components/operations/intelligence';
+import { StaffEligibility } from '@/components/operations/eligibility';
+import { StaffCrs } from '@/components/operations/crs';
+import { ClientReview, ClientMessaging, NewClients, OfficeSettings } from '@/components/operations/clients';
+import { StaffCaseChat, CaseChatInbox } from '@/components/operations/case-chat';
+import { CaseBilling, OfficeBilling } from '@/components/operations/billing';
+import { CandidateTasks, WorkQueue } from '@/components/operations/tasks';
+import { CandidateSettings, DocumentChecklist } from '@/components/operations/profile';
+import { CaseTeamReview, TeamReview } from '@/components/operations/review';
+import { ImportPanel } from '@/components/operations/import';
+import { AnalyticsPanel } from '@/components/operations/analytics';
+import { OperationsArchive } from '@/components/operations/archive';
+import { PathwayHub } from '@/components/operations/pathways';
+import { RulesPanel } from '@/components/operations/rules';
+import { BroadcastPanel } from '@/components/operations/broadcast';
+import { FaqGuide } from '@/components/client/faq';
+import { StaffAssistant } from '@/components/operations/assistant';
+import { NotificationCenter } from '@/components/operations/notifications';
+import { StaffSignOut } from '@/components/auth/sign-out';
+import { Intake } from '@/app/desk';
+
+type Role = 'MANAGER' | 'STAFF';
+type Page = { items: CandidateRecord[]; stats: Record<string, number>; total: number };
+type Nav = 'overview' | 'applicants' | 'active_case' | 'employers' | 'chats' | 'billing' | 'newclients' | 'tasks' | 'teamreview'
+  | 'import' | 'analytics' | 'archive' | 'pathways' | 'knowledge' | 'rules' | 'settings' | 'intake';
+type CaseTab = 'docs' | 'ai' | 'employers' | 'comms' | 'chat' | 'billing' | 'client' | 'review' | 'workflow';
+type CrsView = { v22?: { crs?: { status?: string; total?: number | null } | null } | null; result?: { total?: number } | null; stale?: boolean };
+type Board = {
+  employers: { employerId: string; name: string; sourceUrl: string; sourceCheckedOn: string }[];
+  vacancies: { vacancyId: string; employerId: string; title: string; noc: string | null; sourceUrl: string; postedOn: string; validUntil: string | null; status: string }[];
+  applications: { caseId: string; vacancyId: string; stage: string }[];
+};
+type Dispatch = { subject: string; body: string; docs: string[] };
+
+const STEPS = ['new', 'reviewing', 'documents', 'shortlisted', 'referred'] as const;
+const MAIN_NAV: { id: Nav; label: string; icon: typeof Users }[] = [
+  { id: 'overview', label: 'نظرة عامة والسجل', icon: LayoutDashboard },
+  { id: 'applicants', label: 'بطاقات المتقدمين', icon: Users },
+  { id: 'active_case', label: 'ملف المتقدم النشط', icon: FileCheck },
+  { id: 'employers', label: 'جهات العمل والشواغر', icon: Briefcase },
+  { id: 'chats', label: 'محادثات العملاء', icon: MessageSquare },
+  { id: 'billing', label: 'الفوترة', icon: CreditCard },
+];
+const MORE_NAV: { id: Nav; label: string; icon: typeof Users }[] = [
+  { id: 'newclients', label: 'طلبات جديدة', icon: Inbox },
+  { id: 'tasks', label: 'المهام والمتابعة', icon: ClipboardList },
+  { id: 'teamreview', label: 'مراجعة الفريق', icon: ShieldCheck },
+  { id: 'import', label: 'استيراد الملفات', icon: FileUp },
+  { id: 'analytics', label: 'التحليلات والتدقيق', icon: BarChart3 },
+  { id: 'archive', label: 'الأرشيف والتشغيل', icon: FolderOpen },
+  { id: 'pathways', label: 'مسارات كندا', icon: Route },
+  { id: 'knowledge', label: 'دليل إجابات العملاء', icon: BookOpen },
+  { id: 'rules', label: 'القواعد والمصادر', icon: BookOpen },
+  { id: 'settings', label: 'إعدادات المكتب', icon: Settings },
+];
