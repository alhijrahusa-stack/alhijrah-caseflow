 import { detailsSchema } from '@/lib/intake';
 import { screenIntake } from '@/lib/screening';
 import { pathwayById,pathwayReadiness } from '@/lib/pathways';
@@ -28,3 +30,16 @@ export async function GET(_r:Request,ctx:Context){try{
  const wf=caseWorkflow({profile,officeJobsMissing:!client&&!!officeJobsError(profileSchema.parse({...profile,consent:true}).jobs),status:c.status,assignedTo:c.assignedTo,isClient:!!client,pathway:readiness&&pw?{label:pw.ar,missing:readiness.missing.map(m=>m.ar)}:null,inbox:client?.inbox,requestedDocuments:requested,followUpDate:client?.followUpDate||'',documents:docs,hasAiReview:!!ai,hasEligibility:!!elig,hasCrs:!!crs,openTasks:open,today:new Date().toISOString().slice(0,10)});
  return Response.json({...wf,missingKeys:readiness?readiness.missing.map(m=>m.key):[],missingDocumentKeys:screen?screen.documents.filter(d=>d.state==='missing').map(d=>d.category):[],clientVersion:client?.version??null},{headers:{'Cache-Control':'private, no-store'}});
 }catch(e){return errorResponse(e);}}
+// Work-session gate: a staff member closes a case session only when a next follow-up is scheduled (an open task due today
+// or later, or the client follow-up date). Otherwise 400 FOLLOW_UP_REQUIRED and nothing is written.
+const closeSchema=z.object({action:z.literal('close_session')}).strict();
+export async function POST(request:Request,ctx:Context){try{
+ sameOrigin(request);const o=await owner(),{id}=await ctx.params,c=await candidateOwned(id,o),db=getDb();await readJson(request,closeSchema);
+ const today=torontoDate(Date.now());
+ const [[task],[client]]=await Promise.all([db.select({dueDate:tasks.dueDate}).from(tasks).where(and(eq(tasks.candidateId,id),owned(tasks.ownerId,o),eq(tasks.status,'open'),gte(tasks.dueDate,today))).orderBy(tasks.dueDate).limit(1),
+  db.select({followUpDate:clientCases.followUpDate}).from(clientCases).where(eq(clientCases.candidateId,id)).limit(1)]);
+ const dates=[task?.dueDate||'',client?.followUpDate&&client.followUpDate>=today?client.followUpDate:''].filter(Boolean).sort();
+ if(!dates.length)return Response.json({error:'حدّد موعد المتابعة التالي قبل إغلاق جلسة العمل على الملف.',code:'FOLLOW_UP_REQUIRED'},{status:400,headers:{'Cache-Control':'private, no-store'}});
+ await db.insert(events).values({id:crypto.randomUUID(),ownerId:c.ownerId,candidateId:id,action:'أُغلقت جلسة العمل',note:'المتابعة التالية: '+dates[0],createdAt:new Date().toISOString()});
+ return Response.json({ok:true,nextFollowUp:dates[0]},{headers:{'Cache-Control':'private, no-store'}});
+}catch(e){return errorResponse(e);}}
