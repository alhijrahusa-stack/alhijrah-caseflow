@@ -0,0 +1,15 @@
+'use client';
+// Creates a manual office task. A duplicate open task (same case, same title) is refused by the server with its task id;
+// a second copy is created only after the staff member explicitly confirms.
+import { api,ClientApiError } from '@/lib/client';
+export async function createTask(body:{candidateId:string;title:string;dueDate?:string;priority?:string}):Promise<{created:number;taskId?:string;duplicateOf?:string}>{
+ try{return await api<{created:number;taskId:string}>('/api/tasks',{method:'POST',body:JSON.stringify({mode:'manual',...body})});}
+ catch(e){
+  if(e instanceof ClientApiError&&e.status===409&&e.code==='DUPLICATE_TASK'){
+   const id=(e.message.match(/[0-9a-f-]{36}/)||[''])[0];
+   if(!window.confirm(`توجد مهمة مفتوحة بالعنوان نفسه (رقم المهمة: ${id}).\nإنشاء نسخة ثانية؟`))return {created:0,duplicateOf:id};
+   return api<{created:number;taskId:string}>('/api/tasks',{method:'POST',body:JSON.stringify({mode:'manual',...body,confirmDuplicate:true})});
+  }
+  throw e;
+ }
+}
