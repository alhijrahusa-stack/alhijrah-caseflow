+      const r = await aiStructured({ instructions: READ_INSTRUCTIONS, input: [{ role: 'user', content: [{ type: 'input_text', text: `The document has ${pages} page(s). Transcribe pages 1 to ${Math.min(pages, MAX_PAGES_PER_DOCUMENT)}.` }, d.mime.startsWith('image/') ? { type: 'input_image', image_url: data } : { type: 'input_file', filename: `${d.id}.pdf`, file_data: data }] }], schema: { name: 'document_pages', schema: pagesJsonSchema }, parse: v => pagesSchema.safeParse(v), maxTokens: 16000, timeoutMs: 120000, operation: 'attachment_read' });
