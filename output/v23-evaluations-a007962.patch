+// Case attachment reader for «قسم التقييمات» (read only: SELECT + R2 GET). Every document gets a deterministic page count
+// (pdf-lib for PDFs, 1 for images); pages are then transcribed by the configured model's vision input (scans included),
+// page by page in the structured answer. A page counts as read only when the model returned readable text for it;
+// every other page is listed in unreadable_pages. Results are cached per (document, SHA-256), so a re-run reads only new
+// files. Document text is untrusted: control characters are stripped and instruction-like lines are redacted and flagged.
+import { z } from 'zod';
+import { env } from 'cloudflare:workers';
+import { PDFDocument } from 'pdf-lib';
+import { and, eq } from 'drizzle-orm';
+import { getDb } from '@/db';
+import { documents, documentAiPermissions, attachmentReadings } from '@/db/schema';
+import { aiStructured } from '../openai';
+import { DOCUMENT_PERMISSION_VERSION } from '../generated-documents';
+
+export const MAX_PAGES_PER_DOCUMENT = 30, MAX_BYTES = 8 * 1024 * 1024;
+const READABLE_MIME = ['application/pdf', 'image/jpeg', 'image/png', 'image/webp'];
+export type PageText = { page: number; text: string };
+export type DocumentReading = { documentId: string; name: string; category: string; pages: number; readPages: number[]; unreadablePages: number[]; status: 'READ' | 'PARTIAL' | 'UNREAD'; reason: string | null; injectionFlags: number; cached: boolean; text: PageText[] };
+export type ReadingSummary = { totalDocuments: number; totalPages: number; readPages: number; unreadable_pages: { documentId: string; name: string; page: number; reason: string }[]; complete: boolean; documents: DocumentReading[] };
+
+// Prompt-injection hygiene for document text that will be shown to the evaluator as data.
+const INJECTION = /(ignore|disregard|forget)\s+(all\s+|the\s+|any\s+)?(previous|prior|above|earlier)\s+(instructions?|prompts?|rules?)|you\s+are\s+now|system\s+prompt|act\s+as\s+(an?\s+)?(admin|assistant|system)|تجاهل\s+(كل\s+|جميع\s+)?(التعليمات|الأوامر)|أنت\s+الآن|تعليمات\s+النظام/i;
+export function sanitizeDocumentText(raw: string): { text: string; flags: number } {
+  let flags = 0;
+  const lines = raw.replace(/[\u0000-\u0008\u000b\u000c\u000e-\u001f\u007f​-‏‪-‮⁦-⁩]/g, '').split(/\r?\n/).map(line => {
+    if (INJECTION.test(line)) { flags++; return '[سطر بتعليمات مضمّنة حُذف]'; }
+    return line;
+  });
+  return { text: lines.join('\n').replace(/\n{3,}/g, '\n\n').trim().slice(0, 4000), flags };
+}
+export async function pageCount(bytes: Uint8Array, mime: string): Promise<number> {
+  if (mime.startsWith('image/')) return 1;
+  try { return (await PDFDocument.load(bytes, { ignoreEncryption: true, updateMetadata: false })).getPageCount(); } catch { return 0; }
+}
