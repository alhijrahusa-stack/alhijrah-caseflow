+'use client';
+// «قسم التقييمات» — office only. Four glass cards from the latest evaluation version (instant deterministic, then AI
+// refined on request), the reading coverage, the diff with the previous version, office actions with their states and
+// the seven wired buttons. Nothing here is visible to the client portal; client files are never modified from here.
+import { useCallback, useEffect, useRef, useState } from 'react';
+import { ClipboardCheck, Copy, Download, FileSearch, FileText, GitCompare, LoaderCircle, MessageSquareText, RefreshCw, ScanText, Sparkles, Stamp, UserRoundPen } from 'lucide-react';
+import { api } from '@/lib/client';
+
+type Tagged = { text: string; tag: string; ref?: { documentId?: string; page?: number; name?: string } };
+type Cards = {
+  summary: { facts: Tagged[]; coverage: { documents: number; pages: number; readPages: number; unreadable: { documentId: string; name: string; page: number; reason: string }[]; complete: boolean }; blockers: Tagged[]; crs: { total: number | null; tag: string; missing: string[]; jumps: { label: string; delta: number }[] }; nextAction: string };
+  pathways: { id: string; name: string; objective: string; rank: number; reason: string; reference: { url: string | null; date: string; status: string }; unverified: string[]; next: string }[];
+  careers: { occupations: { noc: string; title: string; teer: number | null; tag: string; reference: string; matchPoints: string[]; gaps: string[] }[]; employers: { name: string; identity: string; license: string; vacancy: string; foreignWorkers: string; source: string }[] };
+  strengths: { items: Tagged[]; gaps: { text: string; tag: string; action: { kind: string; ref: string; label: string } }[]; questions: { key: string; question: string }[] };
+};
+type Version = { versionId: string; versionNo: number; source: 'DETERMINISTIC' | 'AI'; model: string | null; createdAt: string; crs: number | null; cards: Cards };
+type Action = { actionId: string; kind: string; title: string; state: string; stateLabel: string; output: Record<string, unknown> | null; error: string | null; updatedAt: string };
+type State = { reference: string; latest: Version; history: { versionId: string; versionNo: number; source: string; createdAt: string; trigger: string }[]; diff: { from: number; to: number; changes: Record<string, { added: string[]; removed: string[] }>; reasons: string[]; unresolved: string[] } | null; answers: { key: string; question: string; answer: string; source: string; createdAt: string }[]; actions: Action[]; engine: { model: string | null; configured: boolean; tools: string[] } };
