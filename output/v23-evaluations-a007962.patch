+// «قسم التقييمات» — office-only case audit. The first evaluation is deterministic and immediate (database only, no model):
+// verified facts with evidence tags, reading coverage, CRS from the deterministic calculator with score-jump scenarios,
+// ranked pathways from the rule engine, NOC/TEER and hiring entities from the office's own reference catalog, strengths,
+// gaps linked to one-click office actions, and only the strengthening questions that are still unanswered. Every
+// evaluation is an immutable version bound to an input hash; identical inputs reuse the existing version (no duplicate
+// runs). AI refinement (agent.ts) adds a new version on top; client files are never modified from here.
+import { and, desc, eq, inArray, max, sql } from 'drizzle-orm';
+import { getDb } from '@/db';
+import { candidates, clientCases, documents, extractedFacts, caseCrs, auditAnswers, evaluationVersions, evaluationActions, attachmentReadings, officeEmployers, officeVacancies, tasks, events } from '@/db/schema';
+import { ApiError } from '../api-error';
+import { calculateCrs, crsSchema, type CrsInput } from '../crs';
+import { teerFromNoc } from '../noc';
+import { documentLabels } from '../model';
+import { RULES_VERSION } from '../pathways';
+import { appendAudit } from '../audit-chain';
+import { readinessOf, coverage } from '../engine/core';
+import { objectiveOf } from '../engine/agent';
+import type { Pathway } from '../assessment';
+
+export const EVALUATION_PROMPT_VERSION = 'audit-2026-11-17.1';
+export const TAGS = ['مسجل بالنظام — غير متحقق', 'مستخرج من مستند', 'إفادة العميل — غير متحقق', 'نتيجة تحقق مسجلة', 'متعارض', 'غير متاح / غير مقروء'] as const;
+export type TagKind = typeof TAGS[number];
+export type Tagged = { text: string; tag: string; ref?: { documentId?: string; page?: number; name?: string } };
+export type ActionKind = 'REVIEW_DOCUMENT' | 'REQUEST_DOCUMENT' | 'CLARIFY_CONFLICT' | 'ESCALATE' | 'UPDATE_REVIEW' | 'PREPARE_CV';
+export type Cards = {
+  summary: { facts: Tagged[]; coverage: Coverage; blockers: Tagged[]; crs: { total: number | null; tag: string; missing: string[]; jumps: { label: string; delta: number }[] }; nextAction: string };
+  pathways: { id: string; name: string; objective: string; rank: number; reason: string; reference: { url: string | null; date: string; status: string }; unverified: string[]; next: string }[];
+  careers: { occupations: { noc: string; title: string; teer: number | null; tag: string; reference: string; matchPoints: string[]; gaps: string[] }[]; employers: { name: string; identity: string; license: string; vacancy: string; foreignWorkers: string; source: string }[] };
+  strengths: { items: Tagged[]; gaps: { text: string; tag: string; action: { kind: ActionKind; ref: string; label: string } }[]; questions: { key: string; question: string }[] };
+};
+export type Coverage = { documents: number; pages: number; readPages: number; unreadable: { documentId: string; name: string; page: number; reason: string }[]; complete: boolean };
+export const ruleDate = () => RULES_VERSION.replace(/^\D+/, '');
+export const tag = { system: '[مسجل بالنظام — غير متحقق]', client: '[إفادة العميل — غير متحقق]', conflict: '[متعارض]', missing: '[غير متاح / غير مقروء]', doc: (name: string, where: string) => `[مستخرج من مستند: ${name}${where ? ' / ' + where : ''}]`, verified: (ref: string, date: string) => `[نتيجة تحقق مسجلة: ${ref} / ${date}]` };
