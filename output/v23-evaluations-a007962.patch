+-- v2.3 «قسم التقييمات» (office only): immutable evaluation versions bound to their evidence, append-only strengthening
+-- answers, tracked office actions with explicit states, and a page-level reading cache for case attachments.
+CREATE TABLE evaluation_versions(
+ version_id TEXT PRIMARY KEY NOT NULL,
+ case_id TEXT NOT NULL REFERENCES candidates(id),
+ version_no INTEGER NOT NULL CHECK(version_no>=1),
+ source TEXT NOT NULL CHECK(source IN('DETERMINISTIC','AI')),
+ input_hash TEXT NOT NULL CHECK(length(input_hash)=64),
+ data_revision INTEGER NOT NULL,
+ prompt_version TEXT NOT NULL,
+ rule_version TEXT NOT NULL,
+ model TEXT,
+ cards_json TEXT NOT NULL CHECK(json_valid(cards_json)),
+ coverage_json TEXT NOT NULL CHECK(json_valid(coverage_json)),
+ crs INTEGER,
+ trigger TEXT NOT NULL,
+ created_by TEXT NOT NULL,
+ created_at TEXT NOT NULL,
+ UNIQUE(case_id,version_no),
+ UNIQUE(case_id,source,input_hash));
+--> statement-breakpoint
+CREATE INDEX evaluation_versions_case ON evaluation_versions(case_id,version_no);
+--> statement-breakpoint
+CREATE TRIGGER evaluation_versions_no_update BEFORE UPDATE ON evaluation_versions BEGIN SELECT RAISE(ABORT,'EVALUATION_IMMUTABLE'); END;
+--> statement-breakpoint
+CREATE TRIGGER evaluation_versions_no_delete BEFORE DELETE ON evaluation_versions BEGIN SELECT RAISE(ABORT,'EVALUATION_IMMUTABLE'); END;
+--> statement-breakpoint
+CREATE TABLE audit_answers(
+ answer_id TEXT PRIMARY KEY NOT NULL,
+ case_id TEXT NOT NULL REFERENCES candidates(id),
+ question_key TEXT NOT NULL CHECK(length(question_key) BETWEEN 2 AND 80),
+ question TEXT NOT NULL,
+ answer TEXT NOT NULL CHECK(length(answer) BETWEEN 1 AND 2000),
+ source TEXT NOT NULL CHECK(source IN('CLIENT','STAFF')),
+ actor TEXT NOT NULL,
+ created_at TEXT NOT NULL);
+--> statement-breakpoint
+CREATE INDEX audit_answers_case ON audit_answers(case_id,question_key,created_at);
+--> statement-breakpoint
+CREATE TRIGGER audit_answers_no_update BEFORE UPDATE ON audit_answers BEGIN SELECT RAISE(ABORT,'AUDIT_ANSWER_IMMUTABLE'); END;
+--> statement-breakpoint
+CREATE TRIGGER audit_answers_no_delete BEFORE DELETE ON audit_answers BEGIN SELECT RAISE(ABORT,'AUDIT_ANSWER_IMMUTABLE'); END;
+--> statement-breakpoint
+CREATE TABLE evaluation_actions(
+ action_id TEXT PRIMARY KEY NOT NULL,
+ case_id TEXT NOT NULL REFERENCES candidates(id),
+ version_id TEXT REFERENCES evaluation_versions(version_id),
+ kind TEXT NOT NULL CHECK(kind IN('REVIEW_DOCUMENT','REQUEST_DOCUMENT','CLARIFY_CONFLICT','ESCALATE','UPDATE_REVIEW','PREPARE_CV')),
+ title TEXT NOT NULL,
+ payload_json TEXT NOT NULL DEFAULT '{}' CHECK(json_valid(payload_json)),
+ state TEXT NOT NULL CHECK(state IN('PROPOSED','PENDING_APPROVAL','RUNNING','DONE','FAILED')),
+ output_json TEXT CHECK(output_json IS NULL OR json_valid(output_json)),
+ error TEXT,
+ dedupe_key TEXT NOT NULL UNIQUE,
+ created_by TEXT NOT NULL,
+ decided_by TEXT,
+ version INTEGER NOT NULL DEFAULT 1,
+ created_at TEXT NOT NULL,
+ updated_at TEXT NOT NULL);
+--> statement-breakpoint
+CREATE INDEX evaluation_actions_case ON evaluation_actions(case_id,created_at);
+--> statement-breakpoint
+CREATE TABLE attachment_readings(
+ document_id TEXT NOT NULL REFERENCES documents(id),
+ sha256 TEXT NOT NULL,
+ case_id TEXT NOT NULL REFERENCES candidates(id),
+ pages INTEGER NOT NULL CHECK(pages>=0),
+ read_pages_json TEXT NOT NULL CHECK(json_valid(read_pages_json)),
+ unreadable_pages_json TEXT NOT NULL CHECK(json_valid(unreadable_pages_json)),
+ text_json TEXT NOT NULL CHECK(json_valid(text_json)),
+ injection_flags INTEGER NOT NULL DEFAULT 0,
+ method TEXT NOT NULL,
+ model TEXT,
+ created_at TEXT NOT NULL,
+ PRIMARY KEY(document_id,sha256));
+--> statement-breakpoint
+CREATE TABLE audit_runs(
+ run_id TEXT PRIMARY KEY NOT NULL,
+ case_id TEXT NOT NULL REFERENCES candidates(id),
+ status TEXT NOT NULL CHECK(status IN('RUNNING','SUCCEEDED','FAILED')),
+ trigger TEXT NOT NULL,
+ model TEXT,
+ input_tokens INTEGER NOT NULL DEFAULT 0,
+ output_tokens INTEGER NOT NULL DEFAULT 0,
+ tool_calls INTEGER NOT NULL DEFAULT 0,
+ retries INTEGER NOT NULL DEFAULT 0,
+ error_code TEXT,
+ version_id TEXT REFERENCES evaluation_versions(version_id),
+ started_at TEXT NOT NULL,
+ finished_at TEXT);
+--> statement-breakpoint
+CREATE INDEX audit_runs_case ON audit_runs(case_id,started_at);
