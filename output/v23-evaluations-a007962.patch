+import { eq } from 'drizzle-orm';
+// v2.3 «قسم التقييمات» — office only (staff session + capability + case ownership; the client portal has no route here).
+// GET: latest evaluation (an instant deterministic version is created when none exists), version history, diff with the
+// previous version, answers, actions with states, AI runs, model and tool registry. ?export=<versionId> → Markdown report.
+type Ctx={params:Promise<{id:string}>};
+const headers={'Cache-Control':'private, no-store'};
+export async function GET(request:Request,ctx:Ctx){try{
+ const s=await staffWith('view_crm'),{id}=await ctx.params,c=await candidateOwned(id,s.scope),u=new URL(request.url),exportId=u.searchParams.get('export');
+ if(exportId){const v=(await versions(id)).find(x=>x.versionId===exportId);if(!v)throw new ApiError(404,'النسخة غير موجودة.');await appendAudit({caseId:id,actor:s.user.userId,event:'EVALUATION_EXPORT',version:v.versionId,diff:{versionNo:v.versionNo}});
+  return new Response(reportMarkdown(c.reference,v),{headers:{...headers,'Content-Type':'text/markdown; charset=utf-8','Content-Disposition':`attachment; filename="evaluation-${c.reference}-v${v.versionNo}.md"`}});}
+ let list=await versions(id);if(!list.length){await evaluateNow(id,s.user.userId,'first_open');list=await versions(id);}
+ const d=await caseDossier(id),cfg=openaiConfig();
+ return Response.json({reference:c.reference,latest:list[0],history:list.map(v=>({versionId:v.versionId,versionNo:v.versionNo,source:v.source,createdAt:v.createdAt,trigger:v.trigger,crs:v.crs})),diff:list[1]?compareVersions(list[1],list[0],d):null,
+  answers:latestAnswers(d.answers).map(a=>({key:a.questionKey,question:a.question,answer:a.answer,source:a.source,createdAt:a.createdAt})),actions:await actionsOf(id),runs:await auditRunsOf(id),
+  engine:{model:cfg.configured?cfg.model:null,configured:cfg.configured,tools:AUDIT_TOOL_NAMES,promptChars:EVALUATOR_SYSTEM_PROMPT.length},states:STATE_LABEL},{headers});
+}catch(e){return errorResponse(e);}}
+const tag=z.string().trim().regex(/^[a-z0-9_:-]{2,80}$/);
+const schema=z.discriminatedUnion('action',[
+ z.object({action:z.literal('evaluate')}).strict(),
+ z.object({action:z.literal('read_attachments'),documentIds:z.array(z.string().uuid()).max(20).default([])}).strict(),
+ z.object({action:z.literal('refine')}).strict(),
+ z.object({action:z.literal('answers'),items:z.array(z.object({key:tag,question:z.string().trim().min(3).max(400),answer:z.string().trim().min(1).max(2000),source:z.enum(['CLIENT','STAFF'])}).strict()).min(1).max(10)}).strict(),
+ z.object({action:z.literal('propose'),kind:z.enum(['REVIEW_DOCUMENT','REQUEST_DOCUMENT','CLARIFY_CONFLICT','ESCALATE','UPDATE_REVIEW','PREPARE_CV']),ref:z.string().trim().min(2).max(200),title:z.string().trim().max(200).optional(),versionId:z.string().uuid().nullable().optional()}).strict(),
+ z.object({action:z.literal('approve'),actionId:z.string().uuid()}).strict(),
+]);
+export async function POST(request:Request,ctx:Ctx){try{
+ sameOrigin(request);const {id}=await ctx.params,d=await readJson(request,schema,40000);
+ const need=d.action==='refine'?'request_assessment':d.action==='read_attachments'?'view_documents':d.action==='evaluate'?'view_crm':'edit_case';
+ const s=await staffWith(need);await candidateOwned(id,s.scope);const actor=s.user.userId;
+ if(d.action==='evaluate'){const r=await evaluateNow(id,actor,'manual');return Response.json(r,{status:r.deduped?200:201,headers});}
+ if(d.action==='read_attachments'){await rateLimit(request,'audit-read:'+id,20,3600);const reading=await readCaseAttachments(id,{documentIds:d.documentIds});const r=await evaluateNow(id,actor,'attachments_read');return Response.json({reading:{totalDocuments:reading.totalDocuments,totalPages:reading.totalPages,readPages:reading.readPages,unreadable_pages:reading.unreadable_pages,complete:reading.complete,documents:reading.documents.map(x=>({documentId:x.documentId,name:x.name,pages:x.pages,readPages:x.readPages,unreadablePages:x.unreadablePages,status:x.status,reason:x.reason,injectionFlags:x.injectionFlags,cached:x.cached}))},evaluation:r},{headers});}
+ if(d.action==='refine'){await rateLimit(request,'audit-refine:'+id,10,3600);const r=await refineEvaluation(id,actor,{trigger:'manual_refine'});return Response.json(r,{status:r.deduped?200:201,headers});}
+ if(d.action==='answers'){const saved=await saveAnswers(id,actor,d.items);const r=await evaluateNow(id,actor,'answers');return Response.json({...saved,evaluation:r},{status:201,headers});}
+ if(d.action==='propose'){const r=await proposeAction(id,actor,{kind:d.kind,ref:d.ref,title:d.title,versionId:d.versionId??null});return Response.json(r,{status:r.deduped?200:201,headers});}
+ // «اعتماد الحفظ»: executes an approved action; its state moves to قيد التنفيذ then منفذ or فاشلة (never success before completion).
+ const db=getDb(),[row]=await db.select().from(evaluationActions).where(eq(evaluationActions.actionId,d.actionId)).limit(1);
+ if(!row||row.caseId!==id)throw new ApiError(404,'الإجراء غير موجود.');
+ if(row.state!=='PENDING_APPROVAL')throw new ApiError(409,'الإجراء ليس بانتظار الموافقة (الحالة: '+(STATE_LABEL[row.state]||row.state)+').');
+ const claimed=await db.update(evaluationActions).set({state:'RUNNING',decidedBy:actor,updatedAt:new Date().toISOString()}).where(eq(evaluationActions.actionId,row.actionId)).returning({id:evaluationActions.actionId});
+ if(!claimed.length)throw new ApiError(409,'الإجراء قيد التنفيذ.');
+ try{
+  if(row.kind==='UPDATE_REVIEW'){await rateLimit(request,'audit-refine:'+id,10,3600);const r=await refineEvaluation(id,actor,{trigger:'approved_update'});return Response.json({action:await finishAction(row.actionId,'DONE',{versionId:r.version.versionId,versionNo:r.version.versionNo,model:r.model},null,actor),result:r},{headers});}
+  if(row.kind==='PREPARE_CV'){await rateLimit(request,'career-generation:'+id,6,3600);const r=await createCareerDraft(id,'cv',s.user.email,row.actionId);return Response.json({action:await finishAction(row.actionId,'DONE',r,null,actor),result:r},{headers});}
+  throw new ApiError(409,'هذا الإجراء يُنفذ مباشرة دون اعتماد.');
+ }catch(e){const a=await finishAction(row.actionId,'FAILED',null,(e as Error).message,actor);if(e instanceof ApiError)return Response.json({error:e.message,action:a},{status:e.status,headers});throw e;}
+}catch(e){return errorResponse(e);}}
