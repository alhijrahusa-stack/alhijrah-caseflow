index 0000000..334b46d
--- /dev/null
+++ b/lib/db-errors.ts
@@ -0,0 +1,8 @@
+// Drizzle wraps D1 failures ("Failed query: …") and keeps the SQLite reason (UNIQUE constraint, trigger RAISE) in `cause`.
+// Retry loops must match on the whole chain, or a lost race surfaces as HTTP 500 instead of a retry.
+export function dbErrorText(e: unknown): string {
+  const parts: string[] = [];
+  for (let x: unknown = e, i = 0; x && i < 5; i++) { parts.push(String((x as Error).message ?? x)); x = (x as { cause?: unknown }).cause; }
+  return parts.join(' | ');
+}
+export const isUniqueViolation = (e: unknown) => /UNIQUE constraint failed|SQLITE_CONSTRAINT/i.test(dbErrorText(e));
