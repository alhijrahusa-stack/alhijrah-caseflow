+  const pathways = (assessment.pathways || []).map(p => ({ id: p.id, name: p.title, objective: objectiveOf(p.id), readiness: readinessOf(p), coverage: coverage(p.checks), checks: p.checks.map(k => ({ label: k.label, state: k.state, source: k.source })) }))
+    .sort((a, b) => ({ READY_FOR_REVIEW: 0, NEEDS_COMPLETION: 1, BLOCKED: 2 }[a.readiness] - { READY_FOR_REVIEW: 0, NEEDS_COMPLETION: 1, BLOCKED: 2 }[b.readiness]) || b.coverage.percent - a.coverage.percent);
+  const [crsRow] = await db.select({ inputs: caseCrs.inputs }).from(caseCrs).where(eq(caseCrs.candidateId, caseId)).limit(1);
+  const crsParsed = crsRow ? crsSchema.safeParse(JSON.parse(crsRow.inputs)) : null;
+  let crs: { total: number | null; missing: string[] } = { total: null, missing: ['العمر', 'نتائج اللغة الأربع', 'المؤهل', 'سنوات الخبرة'] };
+  if (crsParsed?.success) { try { crs = { total: calculateCrs(crsParsed.data).total, missing: [] }; } catch (e) { crs = { total: null, missing: [(e as Error).message] }; } }
+  const ext = await db.select({ id: extractedFacts.extractionId, field: extractedFacts.fieldKey, value: extractedFacts.valueJson, documentId: extractedFacts.documentId, location: extractedFacts.location, confidence: extractedFacts.confidence, state: extractedFacts.evidenceState }).from(extractedFacts).where(eq(extractedFacts.caseId, caseId)).orderBy(desc(extractedFacts.extractedAt)).limit(60);
+  const factKeys = new Set([...Object.keys(input.profile), 'crs', ...ext.map(e => e.field)]), docIds = new Set(ext.map(e => e.documentId).filter(Boolean) as string[]);
+  const run = await startRun(caseId, 'ANALYSIS', revision, { profile: input.profile, documents: input.documents, pathways, crs, ext: ext.map(e => [e.field, e.value, e.state]) }, AGENT_PROMPT_VERSION);
+  const tool = async (name: string, args: Record<string, unknown>) => {
+    if (name === 'get_case') return { profile: input.profile, documentsOnFile: input.documents, missingDocuments: assessment.missingDocuments || [], ruleEngine: input.ruleEngine };
+    if (name === 'get_ranked_pathways') return { pathways };
+    if (name === 'get_extracted_evidence') return { evidence: ext.map(e => ({ ref: e.field, documentId: e.documentId, value: JSON.parse(e.value), location: e.location, confidence: e.confidence, state: e.state })) };
+    if (name === 'calculate_crs') return crs;
+    if (name === 'evaluate_scenario') { const ch = Object.fromEntries(Object.entries(args).filter(([, v]) => v !== null)); const parsed = scenarioSchema.safeParse(ch); if (!parsed.success) return { error: 'invalid scenario' }; const r = await runScenario(caseId, parsed.data); return { impact: r.impact, crsNote: r.crsNote }; }
+    return { error: 'unknown tool' };
+  };
+  const io: unknown[] = [{ role: 'user', content: 'Assess this case now.' }];
+  const searched = new Set<string>();
+  let saved: AgentAssessment | null = null, toolCalls = 0, inTok = 0, outTok = 0, model = cfg.model, retries = 0;
+  try {
+    for (let round = 0; round < 8 && !saved; round++) {
+      const { raw, model: m } = await openaiResponse({ instructions: INSTRUCTIONS(opts.locale || 'ar'), input: io as never, maxTokens: 6000, officialSearch: true, tools: TOOLS, reasoning: 'low', timeoutMs: 150000, operation: 'analysis' });
+      model = m; inTok += raw.usage?.input_tokens || 0; outTok += raw.usage?.output_tokens || 0;
+      for (const u of searchedOfficialUrls(raw)) searched.add(u);
+      const calls = functionCalls(raw);
+      if (!calls.length) { if (round === 7 || !outputText(raw)) break; io.push(...(raw.output || [])); io.push({ role: 'user', content: 'Call save_assessment now.' }); retries++; continue; }
