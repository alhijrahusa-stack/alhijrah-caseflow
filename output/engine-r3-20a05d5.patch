+    pathways: { type: 'array', maxItems: 3, items: { type: 'object', additionalProperties: false, required: ['pathwayId', 'objective', 'eligibility', 'rankingReason', 'evidence', 'blockers', 'unresolved', 'nextActions', 'officialSources'], properties: {
+      pathwayId: S, objective: { type: 'string', enum: ['PERMANENT_RESIDENCE', 'WORK', 'STUDY', 'VISIT'] }, eligibility: { type: 'string', enum: ['ELIGIBLE_PENDING_REVIEW', 'NOT_ELIGIBLE', 'UNRESOLVED'] }, rankingReason: S,
+      evidence: { type: 'array', maxItems: 12, items: { type: 'object', additionalProperties: false, required: ['ref', 'note'], properties: { ref: S, note: S } } },
