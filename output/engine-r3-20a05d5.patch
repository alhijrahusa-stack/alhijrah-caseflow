+import { runScenario, scenarioSchema, refreshEngine } from './store';
+import { startRun, finishRun } from './runs';
+import type { Pathway } from '../assessment';
+
+export const AGENT_PROMPT_VERSION = 'analysis-2026-11-16.1';
+const OBJECTIVE: Record<string, 'PERMANENT_RESIDENCE' | 'WORK' | 'STUDY' | 'VISIT'> = { fsw: 'PERMANENT_RESIDENCE', cec: 'PERMANENT_RESIDENCE', fst: 'PERMANENT_RESIDENCE', rcip: 'PERMANENT_RESIDENCE', french: 'PERMANENT_RESIDENCE', fcip: 'PERMANENT_RESIDENCE', pnp: 'PERMANENT_RESIDENCE', aip: 'PERMANENT_RESIDENCE', lmia: 'WORK', work_offer: 'WORK', study_permit: 'STUDY', visitor_visa: 'VISIT' };
+export const objectiveOf = (id: string) => OBJECTIVE[id] || 'PERMANENT_RESIDENCE';
+
+const assessmentSchema = z.object({
+  summary: z.string().min(10).max(3000),
+  pathways: z.array(z.object({
