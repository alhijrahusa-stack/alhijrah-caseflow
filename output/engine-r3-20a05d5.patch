+// ALHIJRAH analysis agent (OpenAI tool calling). The model works only through server-bound tools for ONE case: it cannot
+// name or reach another case (no case parameter exists), documents never enter the prompt as instructions (only extracted,
+// validated values), points come from the deterministic calculator, and pathways come from the deterministic rule
+// evaluation. save_assessment is validated server-side for schema, evidence references, official sources actually
+// retrieved, CRS equality and cross-field consistency, then committed only if the case revision did not move.
+import { z } from 'zod';
+import { getDb } from '@/db';
+import { candidates, caseCrs, extractedFacts, tasks, events } from '@/db/schema';
+import { and, desc, eq } from 'drizzle-orm';
+import { ApiError } from '../server';
