+  fn('get_ranked_pathways', 'Deterministic rule evaluation of THIS case: every pathway with its checks (pass/fail/unknown), readiness and coverage, already ranked. Use these pathway ids only.'),
+  fn('get_extracted_evidence', 'Values extracted from THIS case\'s documents with document id, location, reading-confidence label and review state.'),
+  fn('calculate_crs', 'Deterministic CRS from the staff-verified inputs of THIS case, or the list of missing inputs.'),
+  fn('evaluate_scenario', 'Deterministic What-If for THIS case (nothing is saved).', { type: 'object', additionalProperties: false, required: ['englishClb', 'frenchClb', 'canadianYears', 'foreignYears'], properties: { englishClb: { type: ['integer', 'null'] }, frenchClb: { type: ['integer', 'null'] }, canadianYears: { type: ['integer', 'null'] }, foreignYears: { type: ['integer', 'null'] } } }),
