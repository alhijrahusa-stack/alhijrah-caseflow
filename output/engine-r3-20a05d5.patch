+  await api(`/api/candidates/${st.client.id}/engine`, 'POST', { action: 'ack_alerts' }).catch(() => null);
+  for (const [w, h, name] of [[1440, 900, 'engine-r3-staff-1440.png'], [390, 844, 'engine-r3-staff-390.png']] as const) {
