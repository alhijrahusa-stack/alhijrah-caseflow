+
+export async function runAnalysis(caseId: string, actor: string, opts: { locale?: 'ar' | 'en'; trigger: string }) {
+  const cfg = openaiConfig(); if (!cfg.configured) throw new ApiError(503, 'محرك ALHIJRAH غير مفعّل على الخادم.');
