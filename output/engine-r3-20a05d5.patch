+export function validate(args: unknown, ctx: { pathways: { id: string; readiness: string; checks: { state: string }[] }[]; crs: number | null; factKeys: Set<string>; docIds: Set<string>; searched: Set<string> }): { data: AgentAssessment } | { error: string } {
