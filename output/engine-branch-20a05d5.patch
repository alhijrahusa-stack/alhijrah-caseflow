+  employers: Employer[]; draws: NonNullable<ReturnType<typeof drawStats>>[]; expiries: { label: string; date: string }[];
+  live: Record<string, { url: string; checkedOn: string }[]>; community: string; aiRef: string;
+};
+const FIELDS: [keyof z.infer<typeof profileSchema>, string, boolean][] = [['occupation', 'المهنة', true], ['noc', 'رمز NOC', true], ['education', 'المؤهل', true], ['englishMin', 'الإنجليزية (أدنى CLB)', true], ['englishDate', 'تاريخ اختبار الإنجليزية', false], ['frenchMin', 'الفرنسية (أدنى NCLC)', true], ['eca', 'معادلة المؤهل ECA', true], ['jobOffer', 'عرض العمل', true], ['funds', 'أموال الاستقرار', false], ['country', 'بلد الإقامة', false], ['nationality', 'الجنسية', false]];
+export const FRESHNESS_DAYS = 30;
+const ageDays = (d: string) => (d && /^\d{4}-\d{2}-\d{2}/.test(d) ? Math.floor((Date.now() - Date.parse(d.slice(0, 10) + 'T00:00:00Z')) / 86400000) : 9999);
+const empty = (v: unknown) => v === null || v === undefined || v === '' || v === 'unknown';
+
+async function collect(caseId: string): Promise<Raw | null> {
+  const db = getDb(), [c] = await db.select().from(candidates).where(eq(candidates.id, caseId)).limit(1);
+  if (!c) return null;
+  const profile = JSON.parse(c.profile) as Record<string, unknown>, assessment = JSON.parse(c.assessment) as { ruleVersion: string; pathways: Pathway[]; missingDocuments: string[] };
+  const today = torontoDate(Date.now());
+  const [crsRow] = await db.select({ result: caseCrs.result }).from(caseCrs).where(eq(caseCrs.candidateId, caseId)).limit(1);
+  const v22 = await latestV22(caseId).catch(() => ({ verified: null, rapid: null })), a = (v22 as { verified: { crs?: { total?: number | null; missingFields?: string[] } } | null; rapid: { crs?: { total?: number | null; missingFields?: string[] } } | null }).verified ?? (v22 as { rapid: { crs?: { total?: number | null; missingFields?: string[] } } | null }).rapid;
