+  let saved: AgentAssessment | null = null, toolCalls = 0, inTok = 0, outTok = 0, model = cfg.model, retries = 0;
+  try {
+    for (let round = 0; round < 8 && !saved; round++) {
+      const { raw, model: m } = await openaiResponse({ instructions: INSTRUCTIONS(opts.locale || 'ar'), input: io as never, maxTokens: 6000, officialSearch: true, tools: TOOLS, reasoning: 'low', timeoutMs: 150000, operation: 'analysis' });
+      model = m; inTok += raw.usage?.input_tokens || 0; outTok += raw.usage?.output_tokens || 0;
+      for (const u of searchedOfficialUrls(raw)) searched.add(u);
+      const calls = functionCalls(raw);
+      if (!calls.length) { if (round === 7 || !outputText(raw)) break; io.push(...(raw.output || [])); io.push({ role: 'user', content: 'Call save_assessment now.' }); retries++; continue; }
+      io.push(...(raw.output || []).filter(o => o.type !== 'reasoning'));
+      for (const call of calls) {
+        toolCalls++;
+        let out: unknown;
+        try {
+          const args = JSON.parse(call.arguments || '{}');
+          if (call.name === 'save_assessment') {
+            const v = validate(args, { pathways, crs: crs.total, factKeys, docIds, searched });
+            if ('error' in v) { out = { saved: false, error: v.error }; retries++; } else { saved = v.data; out = { saved: true }; }
+          } else out = await tool(call.name || '', args);
+        } catch { out = { error: 'invalid arguments' }; }
+        io.push({ type: 'function_call_output', call_id: call.call_id, output: JSON.stringify(out) });
+      }
+    }
+    if (!saved) throw new ApiError(502, 'لم يُكمل محرك ALHIJRAH حفظ تقييم صالح.');
+  } catch (e) { await finishRun(run, 'FAILED', { model, inputTokens: inTok, outputTokens: outTok, toolCalls, retries, errorCode: e instanceof ApiError ? 'HTTP_' + e.status : 'ERROR' }); throw e; }
