       if (f.type === "MESSAGE_COMMITTED" && f.message?.actorType === "STAFF") f.message.senderDisplayRef = "office";
       return JSON.stringify(f);
-    } catch { return frame; }
+    } catch { return null; }
   }
   // Contract frames (2.0.0): SEND_MESSAGE and RECEIPT go through the same canonical lib/case-chat writers as HTTP (D1
