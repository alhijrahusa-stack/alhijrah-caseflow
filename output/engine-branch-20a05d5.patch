+CREATE INDEX assessment_packages_case ON assessment_packages(case_id,version DESC);
+--> statement-breakpoint
+CREATE TRIGGER assessment_packages_no_update BEFORE UPDATE ON assessment_packages BEGIN SELECT RAISE(ABORT,'PACKAGE_IMMUTABLE'); END;
+--> statement-breakpoint
+-- Deletion is refused except for a case erased through the privacy workflow (profile.erased=1).
+CREATE TRIGGER assessment_packages_no_delete BEFORE DELETE ON assessment_packages WHEN NOT EXISTS(SELECT 1 FROM candidates c WHERE c.id=OLD.case_id AND json_extract(c.profile,'$.erased')=1) BEGIN SELECT RAISE(ABORT,'PACKAGE_IMMUTABLE'); END;
