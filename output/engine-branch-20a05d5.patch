+ package_id TEXT PRIMARY KEY NOT NULL, case_id TEXT NOT NULL REFERENCES candidates(id), version INTEGER NOT NULL CHECK(version>=1),
+ data_revision INTEGER NOT NULL, rules_ref TEXT NOT NULL, engine_version TEXT NOT NULL, ai_ref TEXT NOT NULL DEFAULT '',
+ package_json TEXT NOT NULL CHECK(json_valid(package_json)), package_sha256 TEXT NOT NULL CHECK(length(package_sha256)=64),
+ created_by TEXT NOT NULL, created_at TEXT NOT NULL, UNIQUE(case_id,version), UNIQUE(case_id,package_sha256));
