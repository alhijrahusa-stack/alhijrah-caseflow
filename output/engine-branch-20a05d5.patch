+// Provider chain bookkeeping: approved providers, a per-provider circuit breaker (D1) and usage rows without PII
+// (provider, model, operation, status, duration, token counts, fallback flag, error code).
+import { env } from 'cloudflare:workers';
+import { getDb } from '@/db';
+import { aiUsage,aiProviderHealth } from '@/db/schema';
+import { eq,gte,sql } from 'drizzle-orm';
+export type ProviderId='openai';
+const vars=()=>env as unknown as Record<string,unknown>;
+// Data may go only to providers the office approved (AI_APPROVED_PROVIDERS, default "openai") that are also configured.
+export function approvedProviders():ProviderId[]{return String(vars().AI_APPROVED_PROVIDERS||'openai').split(',').map(s=>s.trim()).filter((s):s is ProviderId=>s==='openai');}
+// OpenAI is the sole provider. Status reflects the integration actually used: approval, server configuration, breaker.
+export function providerStatus(){const v=vars();const approved=approvedProviders().includes('openai'),configured=!!v.OPENAI_API_KEY&&!!v.OPENAI_MODEL;return [{provider:'openai' as const,model:String(v.OPENAI_MODEL||''),approved,configured,implemented:true,usable:approved&&configured}];}
+export const BREAKER_THRESHOLD=3,BREAKER_OPEN_MS=120_000;
+export async function breakerAllows(p:ProviderId,now=Date.now()){const [h]=await getDb().select().from(aiProviderHealth).where(eq(aiProviderHealth.provider,p)).limit(1);return !h||h.state!=='OPEN'||h.openUntilMs<=now;}
+export async function recordOutcome(p:ProviderId,ok:boolean,now=Date.now()){
+ const db=getDb(),[h]=await db.select().from(aiProviderHealth).where(eq(aiProviderHealth.provider,p)).limit(1),at=new Date(now).toISOString();
+ const failures=ok?0:(h?.failures||0)+1,state=ok?'CLOSED':failures>=BREAKER_THRESHOLD?'OPEN':'CLOSED';
+ await db.insert(aiProviderHealth).values({provider:p,state,failures,openUntilMs:state==='OPEN'?now+BREAKER_OPEN_MS:0,updatedAt:at}).onConflictDoUpdate({target:aiProviderHealth.provider,set:{state,failures,openUntilMs:state==='OPEN'?now+BREAKER_OPEN_MS:0,updatedAt:at}});
+}
+export async function logUsage(u:{provider:ProviderId;model:string;operation:string;status:'OK'|'ERROR'|'SKIPPED';durationMs:number;inputTokens?:number;outputTokens?:number;fallback?:boolean;errorCode?:string}){
+ try{await getDb().insert(aiUsage).values({usageId:crypto.randomUUID(),provider:u.provider,model:u.model,operation:u.operation.slice(0,60),status:u.status,durationMs:Math.max(0,Math.round(u.durationMs)),inputTokens:u.inputTokens||0,outputTokens:u.outputTokens||0,fallback:u.fallback?1:0,errorCode:(u.errorCode||'').slice(0,60),createdAt:new Date().toISOString()});}catch{/* usage logging never breaks the call */}
+}
+
+// Daily token budget (AI_DAILY_TOKEN_LIMIT, default 2,000,000 per Toronto day): above it, calls are refused (429) and logged.
+export function dailyTokenLimit(){const n=Number(vars().AI_DAILY_TOKEN_LIMIT||2_000_000);return Number.isFinite(n)&&n>0?n:2_000_000;}
+export async function tokensToday(day:string){const r=await getDb().select({n:sql<number>`COALESCE(SUM(${aiUsage.inputTokens}+${aiUsage.outputTokens}),0)`}).from(aiUsage).where(gte(aiUsage.createdAt,day));return Number(r[0]?.n||0);}
diff --git a/lib/audit-chain.ts b/lib/audit-chain.ts
new file mode 100644
index 0000000..a17e8c9
--- /dev/null
+++ b/lib/audit-chain.ts
@@ -0,0 +1,39 @@
+// Tamper-evident audit log (append-only, hash-chained). Each entry stores SHA-256(prev_hash | stable(entry)); the database
+// refuses inserts that do not extend the current head and any UPDATE/DELETE (0032 triggers). A concurrent writer that moved
+// the head makes the insert fail; the append retries on the new head. Diffs are redacted summaries: no documents, secrets
+// or contact details. This detects tampering after the fact; it is not an absolute guarantee against it.
+import { env } from 'cloudflare:workers';
+import { getDb } from '@/db';
+import { auditChain } from '@/db/schema';
+import { asc, desc } from 'drizzle-orm';
+import { chainHash, GENESIS, stable, sha256Hex } from './engine/core';
+import { torontoDate } from './v22-core';
+import { dbErrorText } from './db-errors';
+export type AuditInput={caseId:string|null;actor:string;event:string;version?:string;diff?:Record<string,unknown>};
+export async function appendAudit(i:AuditInput){
+ const db=getDb();
+ for(let attempt=0;attempt<6;attempt++){
+  const [head]=await db.select({h:auditChain.entryHash}).from(auditChain).orderBy(desc(auditChain.seq)).limit(1);
+  const entry={entryId:crypto.randomUUID(),caseId:i.caseId,actor:i.actor,event:i.event,version:i.version||'',diff:i.diff||{},createdAt:new Date().toISOString()};
+  const prev=head?.h||GENESIS,hash=await chainHash(prev,entry);
+  try{await db.insert(auditChain).values({entryId:entry.entryId,caseId:entry.caseId,actor:entry.actor,event:entry.event,version:entry.version,diffJson:stable(entry.diff),prevHash:prev,entryHash:hash,createdAt:entry.createdAt});return {entryId:entry.entryId,hash};}
+  catch(e){if(!/AUDIT_CHAIN_HEAD_MOVED|UNIQUE constraint failed/i.test(dbErrorText(e)))throw e;}
+ }
+ throw new Error('AUDIT_CHAIN_CONTENTION');
+}
+// Full verification: recompute every hash from genesis. Returns the first broken sequence number, if any.
+export async function verifyAuditChain(){
+ const rows=await getDb().select().from(auditChain).orderBy(asc(auditChain.seq));let prev=GENESIS;
+ for(const r of rows){const h=await chainHash(prev,{entryId:r.entryId,caseId:r.caseId,actor:r.actor,event:r.event,version:r.version,diff:JSON.parse(r.diffJson),createdAt:r.createdAt});
+  if(r.prevHash!==prev||r.entryHash!==h)return {ok:false,entries:rows.length,brokenAt:r.seq};prev=r.entryHash;}
+ return {ok:true,entries:rows.length,head:prev,brokenAt:null as number|null};
+}
+// Independent anchor: the verified head is written once per Toronto day to private R2 (outside the D1 database).
+export async function anchorAuditHead(){
+ const v=await verifyAuditChain();const day=torontoDate(Date.now()),key=`audit-anchors/${day}.json`;
+ if(!env.BUCKET)return {...v,anchored:false};
+ if(await env.BUCKET.head(key))return {...v,anchored:false};
+ const body=JSON.stringify({day,verifiedAt:new Date().toISOString(),...v});
+ await env.BUCKET.put(key,body,{customMetadata:{sha256:await sha256Hex(body)}});
+ return {...v,anchored:true};
+}
