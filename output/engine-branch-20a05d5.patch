+// Versioned reference-data cache in KV (non-sensitive data only: official draw statistics). The database stays the
+// authority; KV entries carry a version and expiry and are invalidated when a validated update lands. Without a KV binding
+// (REFERENCE_KV) the cache is simply bypassed.
+import { env } from 'cloudflare:workers';
+type KV={get(k:string):Promise<string|null>;put(k:string,v:string,o?:{expirationTtl?:number}):Promise<void>};
+const kv=():KV|null=>{const k=(env as unknown as {REFERENCE_KV?:KV}).REFERENCE_KV;return k&&typeof k.get==='function'?k:null;};
+export const REFERENCE_TTL_S=6*3600;
+async function version(ns:string){const k=kv();if(!k)return '0';return (await k.get('ver:'+ns))||'1';}
+export async function cachedReference<T>(ns:string,key:string,load:()=>Promise<T>):Promise<{value:T;cached:boolean}>{
+ const k=kv();if(!k)return {value:await load(),cached:false};
+ const full=`ref:${ns}:v${await version(ns)}:${key}`,hit=await k.get(full);
+ if(hit){try{return {value:JSON.parse(hit) as T,cached:true};}catch{/* reload */}}
+ const value=await load();await k.put(full,JSON.stringify(value),{expirationTtl:REFERENCE_TTL_S});return {value,cached:false};
+}
+export async function invalidateReference(ns:string){const k=kv();if(!k)return;await k.put('ver:'+ns,String(Number(await version(ns))+1));}
+export const referenceCacheEnabled=()=>!!kv();
