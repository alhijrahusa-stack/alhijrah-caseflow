+  const outs = outputsOf(body), done = outs.find(o => JSON.parse(o.output).saved === true);
+  if (done) return [{ type: 'message', content: [{ type: 'output_text', text: 'saved' }] }];
+  if (!outs.length) return [{ type: 'web_search_call', status: 'completed', action: { type: 'search', sources: [{ url: OFFICIAL + '?iframe=true' }, { url: 'https://blog.example/x' }] } },
