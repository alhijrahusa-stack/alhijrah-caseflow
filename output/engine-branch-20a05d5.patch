+  });
+  return { caseId: raw.caseId, version, dataRevision: raw.dataRevision, ruleVersion: raw.ruleVersion, generatedAt, crs: raw.crs, pathways, missingDocuments: raw.missingDocuments, roadmap: buildRoadmap(pathways[0], raw.missingDocuments, raw.expiries, torontoDate(Date.now())), notRanked };
+}
+
+async function latestPackage(caseId: string) { const [p] = await getDb().select().from(assessmentPackages).where(eq(assessmentPackages.caseId, caseId)).orderBy(desc(assessmentPackages.version)).limit(1); return p ?? null; }
+export async function staffEdits(caseId: string) { const [e] = await getDb().select().from(assessmentStaffEdits).where(eq(assessmentStaffEdits.caseId, caseId)).limit(1); return { edits: (e ? JSON.parse(e.editsJson) : {}) as StaffEdits, version: e?.version ?? 0 }; }
+export async function latestPublication(caseId: string, includeWithdrawn = false) {
+  const [p] = await getDb().select().from(assessmentPublications).where(includeWithdrawn ? eq(assessmentPublications.caseId, caseId) : and(eq(assessmentPublications.caseId, caseId), isNull(assessmentPublications.withdrawnAt))).orderBy(desc(assessmentPublications.version)).limit(1);
+  return p ?? null;
+}
+
+// Build and store a package when the content changed. Returns the latest package (new or existing), or null when the case
+// changed during the build (the next trigger rebuilds it).
+export async function refreshEngine(caseId: string, actor: string, reason = 'data_changed') {
+  const raw = await collect(caseId); if (!raw) return null;
+  const sha = await sha256Hex(stable({ engine: ENGINE_VERSION, raw }));
+  const db = getDb(), last = await latestPackage(caseId);
+  if (last?.packageSha256 === sha) return last;
+  const [now] = await db.select({ r: candidates.dataRevision }).from(candidates).where(eq(candidates.id, caseId)).limit(1);
+  if (!now || now.r !== raw.dataRevision) return null;
+  for (let attempt = 0; attempt < 4; attempt++) {
+    const prev = await latestPackage(caseId); if (prev?.packageSha256 === sha) return prev;
+    const row = { packageId: crypto.randomUUID(), caseId, version: (prev?.version ?? 0) + 1, dataRevision: raw.dataRevision, rulesRef: raw.ruleVersion, engineVersion: ENGINE_VERSION, aiRef: raw.aiRef, packageJson: JSON.stringify(raw), packageSha256: sha, createdBy: actor, createdAt: new Date().toISOString() };
+    try { await db.insert(assessmentPackages).values(row); }
+    catch (e) { if (isUniqueViolation(e)) continue; throw e; }
+    await appendAudit({ caseId, actor, event: 'ASSESSMENT_PACKAGE_CREATED', version: String(row.version), diff: { reason, dataRevision: raw.dataRevision, ruleVersion: raw.ruleVersion, pathways: raw.pathways.map(p => p.id + ':' + p.state) } });
+    if (await latestPublication(caseId)) await db.insert(staffAlerts).values({ alertId: crypto.randomUUID(), caseId, kind: 'ASSESSMENT_CHANGED', payloadJson: JSON.stringify({ packageVersion: row.version, reason }), dedupeKey: 'pkg:' + row.packageId, createdAt: row.createdAt }).onConflictDoNothing();
