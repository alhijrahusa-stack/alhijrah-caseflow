+// Event hooks: a data change refreshes the deterministic package in the background (no AI, deduplicated by content hash,
+// discarded if the case moved on) and notifies staff sockets. Failures are logged without PII and retried on the next event.
+import { waitUntil } from 'cloudflare:workers';
+import { refreshEngine } from './store';
+import { getDb } from '@/db';
+import { candidates } from '@/db/schema';
+import { eq } from 'drizzle-orm';
+import { enqueueJob } from '../jobs';
+import { openaiConfig } from '../openai';
+import { SYSTEM_USER_ID } from '../rbac';
+export function onCaseChanged(caseId:string,actor:string,reason:string){
+ try{waitUntil(refreshEngine(caseId,actor,reason).then(()=>queueAnalysis(caseId,reason)).then(()=>{}).catch(e=>console.error('engine_refresh_failed',e instanceof Error?e.name:'unknown')));}catch{/* outside a request context */}
+}
+// Queue the AI analysis for the case's current data revision (revision-keyed: one job per revision; obsolete ones are
+// skipped by the handler). Debounced by 30 s so a burst of edits is assessed once on the latest revision.
+export async function queueAnalysis(caseId:string,_reason:string){void _reason;
+ if(!openaiConfig().configured)return null;
+ const [c]=await getDb().select({r:candidates.dataRevision}).from(candidates).where(eq(candidates.id,caseId)).limit(1);if(!c)return null;
+ return enqueueJob({kind:'ASSESSMENT',caseId,requestKey:`analyze:${caseId}:${c.r}`,payload:{op:'analyze',revision:c.r},actor:SYSTEM_USER_ID,nextAtMs:Date.now()+30_000});
+}
