+  }
+  throw new ApiError(409, 'تعذّر حفظ التقييم بسبب تحديثات متزامنة؛ أعد المحاولة.');
+}
+
+export async function engineView(caseId: string, actor: string) {
+  const db = getDb(), [c] = await db.select({ r: candidates.dataRevision }).from(candidates).where(eq(candidates.id, caseId)).limit(1);
+  if (!c) throw new ApiError(404, 'الملف غير موجود.');
+  let pkg = await latestPackage(caseId);
