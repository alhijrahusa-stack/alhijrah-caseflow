+  const employers: Employer[] = vac.filter(r => noc && r.v.noc === noc && (!r.v.validUntil || r.v.validUntil >= today)).map(r => ({ employerId: r.e.employerId, name: r.e.name, address: r.e.address ?? null, vacancyId: r.v.vacancyId, title: r.v.title, noc: r.v.noc, evidenceKind: r.v.evidenceKind as Employer['evidenceKind'], sourceUrl: r.v.sourceUrl, checkedOn: r.e.sourceCheckedOn, vacancyStatus: r.v.evidenceKind === 'CURRENT_VACANCY' || r.v.evidenceKind === 'CLIENT_OFFER' ? 'ACTIVE' : 'REFERENCE_ONLY', validUntil: r.v.validUntil, matchReason: `رمز NOC ${noc} في الملف يطابق رمز الشاغر.` }));
