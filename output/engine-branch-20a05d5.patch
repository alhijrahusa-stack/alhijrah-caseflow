+import { z } from 'zod';
+import { staffWith,candidateOwned,sameOrigin,readJson,errorResponse,ApiError } from '@/lib/server';
+import { requireCapability,requireManager } from '@/lib/rbac';
+import { rateLimit } from '@/lib/security';
