+++ b/tests/v22/radar-live.mjs
@@ -0,0 +1,50 @@
+// LIVE official-source check (opt-in: LIVE_RADAR=1). The built Worker's draw radar fetches IRCC's published Express Entry
+// rounds JSON for real (only www.canada.ca is reachable; the request is forwarded unchanged from the Worker, User-Agent
+// included), then validates, stores, snapshots to R2, bumps the KV reference version and alerts staff for a synthetic case
+// whose stored CRS meets a recent cut-off. A second run must be UNCHANGED. Prints counts, dates, hashes and URLs only.
+import assert from 'node:assert/strict';
+import { createRequire } from 'node:module';
+import { readFile, readdir, writeFile } from 'node:fs/promises';
+import path from 'node:path';
+import { seedOfficeManager } from './office-fixture.mjs';
+if (process.env.LIVE_RADAR !== '1') { console.log('radar-live SKIPPED (set LIVE_RADAR=1)'); process.exit(0); }
+const require = createRequire(import.meta.url);
+const { Miniflare } = createRequire(require.resolve('wrangler/package.json'))('miniflare');
+const base = 'http://canada-desk.test', admin = { 'oai-authenticated-user-id': 'admin-1', 'oai-authenticated-user-email': 'admin@example.test' };
+const files = await readdir('dist/server', { recursive: true }), fetched = [];
+const mf = new Miniflare({
+  modules: ['index.js', ...files.filter(f => f !== 'index.js' && f.endsWith('.js'))].map(f => ({ type: 'ESModule', path: path.resolve('dist/server', f) })),
+  modulesRoot: path.resolve('dist/server'), compatibilityDate: '2026-05-15', compatibilityFlags: ['nodejs_compat'],
+  d1Databases: { DB: 'radar-live-db' }, r2Buckets: ['BUCKET'], kvNamespaces: { PERMISSIONS_KV: 'radar-kv', REFERENCE_KV: 'radar-ref' }, durableObjects: { CHAT_ROOMS: 'CaseChatRoom' },
+  bindings: { TRUST_SITES_IDENTITY_HEADERS: '1', OFFICE_ADMIN_EMAIL: 'admin@example.test', APP_SECRET: 'd'.repeat(64), PERMISSIONS_KV_NAMESPACE: 'test' },
+  outboundService: async req => {
+    const u = new URL(req.url); if (u.hostname !== 'www.canada.ca') return new Response('blocked in live test', { status: 599 });
+    const t = Date.now(), r = await fetch(req.url, { headers: req.headers }); const body = await r.arrayBuffer();
+    fetched.push({ url: req.url, status: r.status, ms: Date.now() - t, userAgent: req.headers.get('user-agent') });
+    return new Response(body, { status: r.status, headers: { 'content-type': r.headers.get('content-type') || 'application/json', ...(r.headers.get('last-modified') ? { 'last-modified': r.headers.get('last-modified') } : {}) } });
+  },
+});
+const send = (p, method = 'GET', body) => mf.dispatchFetch(base + p, { method, headers: { ...(body ? { 'content-type': 'application/json' } : {}), ...admin }, body: body ? JSON.stringify(body) : undefined });
+const json = async (r, status = 200) => { const t = await r.text(); assert.equal(r.status, status, t); return t ? JSON.parse(t) : null; };
+const out = { mode: 'LIVE www.canada.ca through the Worker runtime (Miniflare); everything else blocked' };
+try {
+  const db = await mf.getD1Database('DB');
+  for (const f of (await readdir('drizzle')).filter(f => f.endsWith('.sql')).sort()) for (const s of (await readFile('drizzle/' + f, 'utf8')).split('--> statement-breakpoint').map(s => s.trim()).filter(Boolean)) await db.prepare(s).run();
+  await seedOfficeManager(db, 'admin-1'); await json(await send('/api/office'));
+  const c = await json(await send('/api/candidates', 'POST', { fullName: 'Radar Synthetic', phone: '+15557770001', consent: true, jobs: [{ title: 'Driver', employer: 'QA', country: 'Jordan', start: '2020-01', end: '2025-01', weekly_hours: 40 }], occupation: 'Driver', noc: '73300', teer: 3, englishMin: 7, englishDate: '2026-09-01' }), 201);
+  await db.prepare("INSERT INTO case_crs(candidate_id,inputs,result,source_hash,reviewed_by,reviewed_at) VALUES(?,?,?,?,?,?)").bind(c.id, '{}', JSON.stringify({ total: 600 }), 'b'.repeat(64), 'admin-1', new Date().toISOString()).run().catch(e => { out.crsSeed = 'skipped: ' + String(e.message).slice(0, 120); });
+  const r1 = await json(await send('/api/office/engine-health', 'POST', { action: 'radar' }));
+  const run = await db.prepare('SELECT status, http_status h, source_updated_at u, bytes, rounds_added n, affected_cases a, content_sha256 sha FROM rule_watch_runs ORDER BY fetched_at DESC').first();
+  out.first = { result: r1, run };
+  assert.equal(r1.status, 'UPDATED', JSON.stringify(r1)); assert.equal(run.h, 200); assert.ok(run.u, 'Last-Modified stored'); assert.ok(run.n > 100, 'rounds stored');
+  const latest = await db.prepare('SELECT category, draw_date d, crs_min c, invitations i FROM draw_thresholds ORDER BY draw_date DESC LIMIT 3').all();
+  out.latestStored = latest.results; out.storedRounds = (await db.prepare('SELECT count(*) n FROM draw_thresholds').first()).n;
+  const snap = await db.prepare('SELECT object_key k, content_sha256 s FROM source_snapshots ORDER BY fetched_at DESC').first();
+  assert.ok(snap && (await (await mf.getR2Bucket('BUCKET')).head(snap.k)), 'raw snapshot kept in private R2'); out.snapshot = snap;
+  out.kvVersion = await (await mf.getKVNamespace('REFERENCE_KV')).get('ver:draws');
+  out.alerts = (await db.prepare("SELECT count(*) n FROM staff_alerts WHERE kind='DRAW_CHANGE'").first()).n;
+  const r2 = await json(await send('/api/office/engine-health', 'POST', { action: 'radar' }));
+  assert.equal(r2.status, 'UNCHANGED'); out.second = r2;
+  out.fetched = fetched; out.passed = true; console.log('radar-live PASSED');
+} catch (e) { out.passed = false; out.error = String(e.message || e).slice(0, 1200); out.fetched = fetched; console.log('radar-live FAILED: ' + out.error); process.exitCode = 1; }
+finally { await writeFile(process.env.LIVE_OUT || 'radar-live.json', JSON.stringify(out, null, 2)); await mf.dispose(); }
