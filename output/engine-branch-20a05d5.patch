+// ALHIJRAH assessment engine — deterministic core (no I/O, no AI). Everything here is a pure function of its inputs so it
+// can be replayed and unit-tested: pathway ranking, the requirement-coverage indicator, explanation traces, the
+// time-to-PR roadmap, draw statistics, What-If deltas, the client-safe snapshot and the draft/published diff.
+// Points (CRS) come only from the deterministic CRS calculator elsewhere; nothing here estimates points or probabilities.
+import type { Pathway, Check } from '../assessment.ts';
+
+export const ENGINE_VERSION = 'alhijrah-engine-2026-11-16.1';
+export type Readiness = 'READY_FOR_REVIEW' | 'NEEDS_COMPLETION' | 'BLOCKED';
+export type EvidenceState = 'REPORTED' | 'EXTRACTED' | 'REVIEWED' | 'MISSING' | 'CONFLICTED' | 'EXPIRED';
+export type FieldEvidence = { key: string; label: string; value: string | number | null; state: EvidenceState; source: string; updatedAt: string; reviewedBy: string | null; confidence: 'HIGH' | 'MEDIUM' | 'LOW' | null; impactful: boolean };
+export type TraceFact = { key: string; label: string; value: string | number | null; state: EvidenceState; source: string };
+export type ExplanationTrace = {
+  facts: TraceFact[]; rule: { ruleVersion: string; engineVersion: string; checks: { label: string; state: Check['state']; source: string }[] };
+  officialSources: { url: string; checkedOn: string; basis: 'RULE_CATALOGUE' | 'LIVE_VERIFICATION' }[];
+  met: string[]; missing: string[]; blockers: string[]; rankingReason: string; assumptions: string[];
+};
+export type Employer = { employerId: string; name: string; address: string | null; vacancyId: string; title: string; noc: string | null; evidenceKind: 'LMIA_HISTORICAL' | 'PROGRAM_DESIGNATION' | 'CURRENT_VACANCY' | 'CLIENT_OFFER'; sourceUrl: string; checkedOn: string; vacancyStatus: string; validUntil: string | null; matchReason: string };
+export type RankedPathway = {
+  rank: number; pathwayId: string; name: string; region: string; readiness: Readiness; indicator: { met: number; evaluated: number; percent: number; method: string };
+  reason: string; met: string[]; missing: string[]; blockers: string[]; nextAction: string; employers: Employer[]; pinned: boolean; trace: ExplanationTrace;
+};
+export type StaffEdits = { pinned?: string[]; excluded?: { pathwayId: string; reason: string }[]; excludedEmployers?: string[]; internalNotes?: string; publicNotes?: string; publicGuidance?: string[] };
+
+export const INDICATOR_METHOD = 'نسبة شروط القاعدة المستوفاة بحسب بيانات الملف إلى مجموع شروط المسار المُقيَّمة (ليست احتمال قبول).';
+export function coverage(checks: Check[]) {
+  const met = checks.filter(c => c.state === 'pass').length, evaluated = checks.length;
+  return { met, evaluated, percent: evaluated ? Math.round((met / evaluated) * 100) : 0, method: INDICATOR_METHOD };
+}
+export function readinessOf(p: Pathway): Readiness {
+  if (p.checks.some(c => c.state === 'fail') || p.state === 'mismatch') return 'BLOCKED';
+  return p.checks.some(c => c.state === 'unknown') || p.state === 'incomplete' ? 'NEEDS_COMPLETION' : 'READY_FOR_REVIEW';
+}
+const stateWeight: Record<Readiness, number> = { READY_FOR_REVIEW: 0, NEEDS_COMPLETION: 1, BLOCKED: 2 };
+
+// Top ≤3 pathways supported by the rule evaluation. BLOCKED pathways are never padded in to reach three; excluded ones are
+// reported with the staff reason; pinned ones are kept (and first) as a staff decision.
+export function rankPathways(pathways: Pathway[], edits: StaffEdits = {}) {
+  const excluded = new Map((edits.excluded || []).map(e => [e.pathwayId, e.reason]));
+  const pinned = new Set(edits.pinned || []);
+  const scored = pathways.map(p => ({ p, r: readinessOf(p), c: coverage(p.checks) }));
+  const eligible = scored.filter(s => !excluded.has(s.p.id) && (s.r !== 'BLOCKED' || pinned.has(s.p.id)));
+  eligible.sort((a, b) => Number(pinned.has(b.p.id)) - Number(pinned.has(a.p.id)) || stateWeight[a.r] - stateWeight[b.r] || b.c.percent - a.c.percent || a.p.id.localeCompare(b.p.id));
+  const top = eligible.slice(0, 3);
+  const notRanked = scored.filter(s => !top.includes(s)).map(s => ({ pathwayId: s.p.id, name: s.p.title, reason: excluded.has(s.p.id) ? `استبعده الموظف: ${excluded.get(s.p.id)}` : s.r === 'BLOCKED' ? 'شرط واحد على الأقل لا يطابق بيانات الملف بحسب القاعدة.' : 'خارج أقوى ثلاثة مسارات بحسب الترتيب.' }));
+  return { top, notRanked, pinned, excluded };
+}
+export function rankingReason(r: Readiness, c: { met: number; evaluated: number }, pinned: boolean, position: number) {
+  if (pinned) return 'ثبّته الموظف في هذا الترتيب.';
+  const base = r === 'READY_FOR_REVIEW' ? 'جميع شروط القاعدة المُقيَّمة مستوفاة بحسب بيانات الملف' : r === 'NEEDS_COMPLETION' ? 'لا شرط مخالف، وبعض الشروط تحتاج بيانات أو مستندات' : 'مثبّت رغم وجود شرط مخالف';
+  return `${base}؛ ${c.met} من ${c.evaluated} شروط مستوفاة. الترتيب #${position} حسب الجاهزية ثم نسبة الشروط المستوفاة.`;
+}
+export function ruleDate(ruleVersion: string) { const m = /^(\d{4}-\d{2}-\d{2})/.exec(ruleVersion); return m ? m[1] : ''; }
+
+export function buildTrace(p: Pathway, facts: TraceFact[], opts: { ruleVersion: string; live?: { url: string; checkedOn: string }[]; position: number; pinned: boolean; assumptions: string[] }): ExplanationTrace {
+  const c = coverage(p.checks), r = readinessOf(p), date = ruleDate(opts.ruleVersion);
+  const catalogue = [...new Set(p.checks.map(k => k.source).filter(Boolean))].map(url => ({ url, checkedOn: date, basis: 'RULE_CATALOGUE' as const }));
+  return {
+    facts, rule: { ruleVersion: opts.ruleVersion, engineVersion: ENGINE_VERSION, checks: p.checks.map(k => ({ label: k.label, state: k.state, source: k.source })) },
+    officialSources: [...(opts.live || []).map(s => ({ ...s, basis: 'LIVE_VERIFICATION' as const })), ...catalogue],
+    met: p.checks.filter(k => k.state === 'pass').map(k => k.label), missing: p.checks.filter(k => k.state === 'unknown').map(k => k.label), blockers: p.checks.filter(k => k.state === 'fail').map(k => k.label),
+    rankingReason: rankingReason(r, c, opts.pinned, opts.position), assumptions: [...opts.assumptions, p.caveat].filter(Boolean),
+  };
+}
+
+export type RoadmapStep = { id: string; owner: 'CLIENT' | 'OFFICE'; title: string; dependsOn: string[]; documents: { label: string; validUntil: string | null; expired: boolean }[]; estimate: string; source: string };
+// A per-case plan: client actions come from the top pathway's missing requirements and missing documents; office steps
+// depend on them. No fixed timeline: an estimate appears only when an official source is attached (none by default).
+export function buildRoadmap(top: RankedPathway | undefined, missingDocuments: string[], expiries: { label: string; date: string }[], today: string): RoadmapStep[] {
+  const steps: RoadmapStep[] = [];
+  const docs = missingDocuments.map(label => ({ label, validUntil: null, expired: false }));
+  const expired = expiries.filter(e => e.date && e.date < today).map(e => ({ label: e.label, validUntil: e.date, expired: true }));
+  if (docs.length || expired.length) steps.push({ id: 'documents', owner: 'CLIENT', title: 'رفع المستندات الناقصة أو المنتهية', dependsOn: [], documents: [...docs, ...expired], estimate: 'غير محدد', source: '' });
+  (top?.missing || []).forEach((m, i) => steps.push({ id: 'req-' + i, owner: 'CLIENT', title: `استكمال: ${m}`, dependsOn: [], documents: [], estimate: 'غير محدد', source: '' }));
+  const clientIds = steps.map(s => s.id);
+  if (top) {
+    steps.push({ id: 'office-review', owner: 'OFFICE', title: `مراجعة الملف مقابل متطلبات ${top.name}`, dependsOn: clientIds, documents: [], estimate: 'غير محدد', source: '' });
+    steps.push({ id: 'office-prepare', owner: 'OFFICE', title: 'تجهيز الطلب للمختص المرخّص واعتماده', dependsOn: ['office-review'], documents: [], estimate: 'غير محدد', source: '' });
+  }
+  const soon = expiries.filter(e => e.date && e.date >= today);
+  for (const e of soon) steps.push({ id: 'expiry-' + e.label, owner: 'CLIENT', title: `متابعة صلاحية ${e.label}`, dependsOn: [], documents: [{ label: e.label, validUntil: e.date, expired: false }], estimate: 'غير محدد', source: '' });
+  return steps;
+}
+
+export type Round = { category: string; drawDate: string; crsMin: number; invitations: number; sourceUrl: string };
+// Same-category rounds in a window: count, period, trend and conservative/median/optimistic cut-offs (highest/median/lowest).
+// The comparison is descriptive only: no probability and no invitation is implied.
+export function drawStats(rounds: Round[], category: string, crs: number | null, window = 6) {
+  const same = rounds.filter(r => r.category === category).sort((a, b) => b.drawDate.localeCompare(a.drawDate)).slice(0, window);
+  if (!same.length) return null;
+  const cut = same.map(r => r.crsMin).sort((a, b) => a - b), mid = cut.length % 2 ? cut[(cut.length - 1) / 2] : Math.round((cut[cut.length / 2 - 1] + cut[cut.length / 2]) / 2);
+  const newest = same[0].crsMin, oldest = same[same.length - 1].crsMin;
+  const trend = same.length < 2 ? 'STABLE' : newest > oldest ? 'RISING' : newest < oldest ? 'FALLING' : 'STABLE';
+  const scen = { conservative: cut[cut.length - 1], median: mid, optimistic: cut[0] };
+  return { category, count: same.length, period: { from: same[same.length - 1].drawDate, to: same[0].drawDate }, trend, scenarios: scen, latest: same[0],
+    gap: crs === null ? null : { conservative: crs - scen.conservative, median: crs - scen.median, optimistic: crs - scen.optimistic },
+    limits: 'مقارنة وصفية بسحوبات سابقة من الفئة نفسها؛ لا تعني دعوة ولا احتمال دعوة، والفئات المستهدفة تتغير.', sourceUrl: same[0].sourceUrl };
+}
+
+export type ScenarioChange = { englishClb?: number; frenchClb?: number; education?: string; canadianYears?: number; foreignYears?: number; eca?: 'yes' | 'no' };
+export function scenarioDelta(baseline: { crs: number | null; pathways: { id: string; name: string; readiness: Readiness; percent: number }[] }, after: { crs: number | null; pathways: { id: string; name: string; readiness: Readiness; percent: number }[] }) {
+  const affected = after.pathways.map(a => { const b = baseline.pathways.find(x => x.id === a.id); return b && (b.readiness !== a.readiness || b.percent !== a.percent) ? { id: a.id, name: a.name, from: { readiness: b.readiness, percent: b.percent }, to: { readiness: a.readiness, percent: a.percent } } : null; }).filter(Boolean);
+  return { crs: { from: baseline.crs, to: after.crs, delta: baseline.crs !== null && after.crs !== null ? after.crs - baseline.crs : null }, affected };
+}
+
+// Client-safe view: only staff-approved content. Internal notes, excluded pathways/employers, raw traces, extraction
+// confidence and AI ids never leave the office.
+export type PackageCore = { caseId: string; version: number; dataRevision: number; ruleVersion: string; generatedAt: string; crs: { value: number | null; source: string; missingInputs: string[] }; pathways: RankedPathway[]; missingDocuments: string[]; roadmap: RoadmapStep[] };
+export function clientSnapshot(pkg: PackageCore, edits: StaffEdits, scenarios: { name: string; result: unknown }[]) {
+  const excludedEmployers = new Set(edits.excludedEmployers || []);
+  return {
+    packageVersion: pkg.version, ruleVersion: pkg.ruleVersion, generatedAt: pkg.generatedAt, crs: pkg.crs.value === null ? null : { value: pkg.crs.value },
+    pathways: pkg.pathways.map(p => ({ rank: p.rank, name: p.name, region: p.region, readiness: p.readiness, coverage: { met: p.indicator.met, evaluated: p.indicator.evaluated }, met: p.met, missing: p.missing, nextAction: p.nextAction,
+      employers: p.employers.filter(e => !excludedEmployers.has(e.vacancyId)).map(e => ({ name: e.name, title: e.title, evidenceKind: e.evidenceKind, checkedOn: e.checkedOn })),
+      sources: p.trace.officialSources.map(s => ({ url: s.url, checkedOn: s.checkedOn })) })),
+    missingDocuments: pkg.missingDocuments, roadmap: pkg.roadmap.map(s => ({ owner: s.owner, title: s.title, documents: s.documents, estimate: s.estimate })),
+    notes: (edits.publicNotes || '').trim(), guidance: (edits.publicGuidance || []).filter(Boolean), scenarios,
+  };
+}
+export function diffSnapshots(draft: ReturnType<typeof clientSnapshot>, published: ReturnType<typeof clientSnapshot> | null) {
+  if (!published) return [{ field: 'publication', change: 'لا توجد نسخة منشورة بعد.' }];
+  const out: { field: string; change: string }[] = [];
+  const order = (s: typeof draft) => s.pathways.map(p => `${p.rank}:${p.name}:${p.readiness}`).join(' | ');
+  if (order(draft) !== order(published)) out.push({ field: 'pathways', change: `المنشور: ${order(published) || '—'} · المسودة: ${order(draft) || '—'}` });
+  if ((draft.crs?.value ?? null) !== (published.crs?.value ?? null)) out.push({ field: 'crs', change: `المنشور: ${published.crs?.value ?? '—'} · المسودة: ${draft.crs?.value ?? '—'}` });
+  const md = (a: string[], b: string[]) => ({ added: a.filter(x => !b.includes(x)), removed: b.filter(x => !a.includes(x)) });
+  const m = md(draft.missingDocuments, published.missingDocuments);
+  if (m.added.length || m.removed.length) out.push({ field: 'missingDocuments', change: `أضيف: ${m.added.join('، ') || '—'} · أزيل: ${m.removed.join('، ') || '—'}` });
+  if (draft.notes !== published.notes) out.push({ field: 'notes', change: 'تغيّرت الملاحظات القابلة للنشر.' });
+  if (JSON.stringify(draft.roadmap) !== JSON.stringify(published.roadmap)) out.push({ field: 'roadmap', change: 'تغيّرت خطة التنفيذ.' });
+  if (JSON.stringify(draft.scenarios) !== JSON.stringify(published.scenarios)) out.push({ field: 'scenarios', change: 'تغيّرت السيناريوهات المدرجة.' });
+  return out;
+}
+
+export async function sha256Hex(text: string) { const d = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(text)); return [...new Uint8Array(d)].map(b => b.toString(16).padStart(2, '0')).join(''); }
+// Stable JSON (sorted keys) so equal content always hashes the same.
+export function stable(v: unknown): string { if (Array.isArray(v)) return '[' + v.map(stable).join(',') + ']'; if (v && typeof v === 'object') return '{' + Object.keys(v as object).sort().map(k => JSON.stringify(k) + ':' + stable((v as Record<string, unknown>)[k])).join(',') + '}'; return JSON.stringify(v ?? null); }
+export const GENESIS = '0'.repeat(64);
+export async function chainHash(prev: string, entry: { entryId: string; caseId: string | null; actor: string; event: string; version: string; diff: unknown; createdAt: string }) { return sha256Hex(prev + '|' + stable(entry)); }
+
+// Express Entry rounds as published by IRCC ({rounds:[{drawDate,drawName,drawSize,drawCRS,...}]}); invalid rows are dropped.
+export type ParsedRound = { category: string; drawDate: string; crsMin: number; invitations: number };
+const int = (v: unknown) => { const n = Number(String(v ?? '').replace(/[,\s]/g, '')); return Number.isInteger(n) ? n : NaN; };
+export function parseRounds(json: unknown): ParsedRound[] {
+  const rows = (json as { rounds?: unknown[] })?.rounds; if (!Array.isArray(rows)) return [];
+  const out: ParsedRound[] = [];
+  for (const r of rows as Record<string, unknown>[]) {
+    const drawDate = String(r.drawDate || '').slice(0, 10), category = String(r.drawName || '').trim().slice(0, 120), crsMin = int(r.drawCRS), invitations = int(r.drawSize);
+    if (!/^\d{4}-\d{2}-\d{2}$/.test(drawDate) || !category || !(crsMin >= 0 && crsMin <= 1200) || !(invitations >= 1 && invitations <= 100000)) continue;
+    out.push({ category, drawDate, crsMin, invitations });
+  }
+  return out;
+}
+
