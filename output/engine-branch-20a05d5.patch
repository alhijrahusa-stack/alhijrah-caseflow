+  if (now.r !== revision) { await finishRun(run, 'STALE_DISCARDED', { model, inputTokens: inTok, outputTokens: outTok, toolCalls, retries, errorCode: 'REVISION_MOVED' }); return { runId: run.runId, status: 'STALE_DISCARDED' as const }; }
+  const result = { ...saved, pathways: saved.pathways.map(p => ({ ...p, officialSources: p.officialSources.map(cleanUrl), checkedOn: torontoDate(Date.now()) })), crs: crs.total, revision, searchedUrls: [...searched].slice(0, 40) };
+  await finishRun(run, 'SUCCEEDED', { model, inputTokens: inTok, outputTokens: outTok, toolCalls, retries, result });
+  const created = await createInternalTasks(caseId, c.ownerId, result);
+  await appendAudit({ caseId, actor, event: 'ASSESSMENT_ANALYSIS', version: run.runId, diff: { trigger: opts.trigger, model, revision, pathways: result.pathways.map(p => p.pathwayId + ':' + p.eligibility), tasksCreated: created } });
+  await refreshEngine(caseId, actor, 'analysis');
+  return { runId: run.runId, status: 'SUCCEEDED' as const, model, tokens: { input: inTok, output: outTok }, toolCalls, tasksCreated: created, result };
+}
+
+// Cross-field consistency: pathway ids from the deterministic evaluation; eligibility agrees with the rule checks; evidence
+// refs exist; sources were actually retrieved on official domains; quoted CRS equals the deterministic value.
+export function validate(args: unknown, ctx: { pathways: { id: string; readiness: string; checks: { state: string }[] }[]; crs: number | null; factKeys: Set<string>; docIds: Set<string>; searched: Set<string> }): { data: AgentAssessment } | { error: string } {
+  const p = assessmentSchema.safeParse(args); if (!p.success) return { error: 'schema: ' + p.error.issues.slice(0, 3).map(i => i.path.join('.')).join(',') };
+  const d = p.data, ids = new Map(ctx.pathways.map(x => [x.id, x]));
+  if (new Set(d.pathways.map(x => x.pathwayId)).size !== d.pathways.length) return { error: 'duplicate pathway' };
+  for (const x of d.pathways) {
+    const det = ids.get(x.pathwayId); if (!det) return { error: 'unknown pathway ' + x.pathwayId };
+    const fail = det.checks.some(k => k.state === 'fail'), unknown = det.checks.some(k => k.state === 'unknown');
+    if (x.eligibility === 'ELIGIBLE_PENDING_REVIEW' && (fail || unknown)) return { error: 'eligibility contradicts rule checks for ' + x.pathwayId };
+    if (x.eligibility === 'NOT_ELIGIBLE' && !fail) return { error: 'NOT_ELIGIBLE without a failing rule check for ' + x.pathwayId };
+    if (x.objective !== objectiveOf(x.pathwayId)) return { error: 'objective mismatch for ' + x.pathwayId };
+    for (const e of x.evidence) if (!ctx.factKeys.has(e.ref) && !ctx.docIds.has(e.ref)) return { error: 'unknown evidence ref ' + e.ref };
+    const retrieved = new Set([...ctx.searched].map(pageKey));
+    for (const u of x.officialSources) if (!retrieved.has(pageKey(u))) return { error: `source not retrieved: ${u.slice(0, 120)}. Cite only pages retrieved in this run: ${[...ctx.searched].slice(0, 8).join(' ')}` };
+  }
+  if (d.crsQuoted !== null && d.crsQuoted !== ctx.crs) return { error: 'crsQuoted differs from the deterministic CRS' };
+  return { data: d };
+}
+
+// Internal office tasks are created automatically (deduplicated by system key); client-facing actions are not sent.
+async function createInternalTasks(caseId: string, ownerId: string, r: { pathways: { pathwayId: string; nextActions: { owner: string; action: string }[] }[] }) {
+  const db = getDb(), now = new Date().toISOString();
+  const items = r.pathways.flatMap(p => p.nextActions.filter(a => a.owner === 'OFFICE').map(a => ({ key: `engine:${p.pathwayId}:${a.action.slice(0, 60)}`, title: a.action.slice(0, 200) }))).slice(0, 6);
+  let created = 0;
+  for (const it of items) { const ins = await db.insert(tasks).values({ id: crypto.randomUUID(), ownerId, candidateId: caseId, title: it.title, systemKey: it.key, createdAt: now, updatedAt: now }).onConflictDoNothing().returning({ id: tasks.id }); created += ins.length; }
+  if (created) await db.insert(events).values({ id: crypto.randomUUID(), ownerId, candidateId: caseId, action: 'أنشأ محرك ALHIJRAH مهام داخلية', note: String(created), createdAt: now });
+  return created;
+}
+export async function latestAnalysis(caseId: string) {
+  const { engineRuns } = await import('@/db/schema');
+  const rows = await getDb().select().from(engineRuns).where(and(eq(engineRuns.caseId, caseId), eq(engineRuns.kind, 'ANALYSIS'))).orderBy(desc(engineRuns.startedAt)).limit(5);
+  const ok = rows.find(r => r.status === 'SUCCEEDED');
+  return { last: rows[0] ? { runId: rows[0].runId, status: rows[0].status, startedAt: rows[0].startedAt, finishedAt: rows[0].finishedAt, errorCode: rows[0].errorCode, model: rows[0].model } : null,
+    valid: ok ? { runId: ok.runId, dataRevision: ok.dataRevision, finishedAt: ok.finishedAt, model: ok.model, promptVersion: ok.promptVersion, ruleVersion: ok.ruleVersion, tokens: { input: ok.inputTokens, output: ok.outputTokens }, toolCalls: ok.toolCalls, result: ok.resultJson ? JSON.parse(ok.resultJson) : null } : null };
+}
