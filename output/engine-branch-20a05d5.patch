+// ALHIJRAH assessment engine — staff sandbox. Reads: view_crm. Edits/scenarios/extraction decisions: edit_case.
+// Publishing to the client: review_case. Withdrawing a publication: MANAGER. Every action is server-checked per case.
+type Context={params:Promise<{id:string}>};
+const headers={'Cache-Control':'private, no-store'};
+const schema=z.discriminatedUnion('action',[
+ z.object({action:z.literal('edits'),expectedVersion:z.number().int().min(0),edits:editsSchema}).strict(),
+ z.object({action:z.literal('publish'),packageVersion:z.number().int().min(1),editsVersion:z.number().int().min(0)}).strict(),
+ z.object({action:z.literal('withdraw'),publicationId:z.string().uuid()}).strict(),
+ z.object({action:z.literal('scenario_run'),changes:scenarioSchema}).strict(),
+ z.object({action:z.literal('scenario_save'),name:z.string().trim().min(2).max(120),changes:scenarioSchema,include:z.boolean().default(false)}).strict(),
+ z.object({action:z.literal('scenario_include'),scenarioId:z.string().uuid(),include:z.boolean()}).strict(),
+ z.object({action:z.literal('extract_text'),text:z.string().trim().min(20).max(20000)}).strict(),
+ z.object({action:z.literal('extract_document'),documentId:z.string().min(8).max(80)}).strict(),
+ z.object({action:z.literal('extraction_decision'),extractionId:z.string().uuid(),decision:z.enum(['accept','reject'])}).strict(),
+ z.object({action:z.literal('ack_alerts'),alertIds:z.array(z.string().uuid()).max(50)}).strict(),
+ z.object({action:z.literal('reassess'),locale:z.enum(['ar','en']).default('ar')}).strict(),
+]);
+export async function GET(_r:Request,ctx:Context){try{const s=await staffWith('view_crm'),{id}=await ctx.params;await candidateOwned(id,s.scope);return Response.json(await engineView(id,s.authority.actor.userId),{headers});}catch(e){return errorResponse(e);}}
+export async function POST(request:Request,ctx:Context){try{
+ sameOrigin(request);const s=await staffWith('view_crm'),{id}=await ctx.params,c=await candidateOwned(id,s.scope),d=await readJson(request,schema,60000),actor=s.authority.actor.userId;void c;
+ const a=s.authority;
+ switch(d.action){
+  case 'edits':requireCapability(a,'edit_case');return Response.json(await saveEdits(id,actor,d.expectedVersion,d.edits),{headers});
+  case 'publish':requireCapability(a,'review_case');return Response.json(await publishAssessment(id,actor,{packageVersion:d.packageVersion,editsVersion:d.editsVersion}),{status:201,headers});
+  case 'withdraw':requireManager(a);return Response.json(await withdrawPublication(id,d.publicationId,actor),{headers});
+  case 'scenario_run':requireCapability(a,'edit_case');return Response.json(await runScenario(id,d.changes),{headers});
+  case 'scenario_save':requireCapability(a,'edit_case');return Response.json(await saveScenario(id,actor,d.name,d.changes,d.include),{status:201,headers});
+  case 'scenario_include':requireCapability(a,'edit_case');await setScenarioInclusion(id,actor,d.scenarioId,d.include);return Response.json({ok:true},{headers});
+  case 'extract_text':requireCapability(a,'review_case');await rateLimit(request,'extract:'+id,20,3600);return Response.json(await runExtraction(id,actor,{text:d.text}),{headers});
+  case 'extract_document':requireCapability(a,'review_case');{const j=await enqueueJob({kind:'ASSESSMENT',caseId:id,requestKey:'extract:'+d.documentId,payload:{op:'extract',documentId:d.documentId},actor});return Response.json({queued:true,job:j},{status:202,headers});}
+  case 'extraction_decision':requireCapability(a,'edit_case');await decideExtraction(id,actor,d.extractionId,d.decision);return Response.json({ok:true},{headers});
+  case 'ack_alerts':return Response.json({acknowledged:await acknowledgeAlerts(id,actor,d.alertIds)},{headers});
+  // Re-assess now: deterministic recompute + package refresh, then the AI tool-calling analysis (no pathway preselection).
+  // A failure keeps the last valid assessment with its timestamp and reports the error.
+  case 'reassess':{requireCapability(a,'review_case');await rateLimit(request,'reassess:'+id,10,3600);await recomputeCase(id,{mode:'write'});await refreshEngine(id,actor,'reassess');
+   if(!openaiConfig().configured)return Response.json({deterministic:true,analysis:{status:'ENGINE_NOT_CONFIGURED'}},{headers});
+   try{const r=await runAnalysis(id,actor,{locale:d.locale,trigger:'reassess'});return Response.json({deterministic:true,analysis:r},{headers});}
+   catch(e){return Response.json({deterministic:true,analysis:{status:'FAILED',error:e instanceof Error?e.message:'error'}},{headers});}}
+ }
+ throw new ApiError(400,'إجراء غير معروف.');
+}catch(e){return errorResponse(e);}}
