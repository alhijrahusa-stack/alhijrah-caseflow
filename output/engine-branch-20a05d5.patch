+// Engine execution records: server-generated run ids bound to the case data revision and a hash of the versioned input
+// snapshot, with model, prompt/rule versions, duration, tokens, tool calls, retries and failures (no secrets, no PII).
+import { getDb } from '@/db';
+import { engineRuns } from '@/db/schema';
+import { eq } from 'drizzle-orm';
+import { sha256Hex, stable } from './core';
+import { RULE_VERSION } from '../assessment';
+export type Run={runId:string;caseId:string;startedMs:number};
+export async function startRun(caseId:string,kind:'ANALYSIS'|'EXTRACTION'|'REASSESS',dataRevision:number,inputSnapshot:unknown,promptVersion:string):Promise<Run>{
+ const runId=crypto.randomUUID(),startedMs=Date.now();
+ await getDb().insert(engineRuns).values({runId,caseId,kind,status:'RUNNING',dataRevision,inputSha256:await sha256Hex(stable(inputSnapshot)),ruleVersion:RULE_VERSION,promptVersion,startedAt:new Date(startedMs).toISOString()});
+ return {runId,caseId,startedMs};
+}
+export async function finishRun(r:Run,status:'SUCCEEDED'|'FAILED'|'STALE_DISCARDED'|'SKIPPED',o:{model?:string;inputTokens?:number;outputTokens?:number;toolCalls?:number;retries?:number;errorCode?:string;result?:unknown}={}){
+ await getDb().update(engineRuns).set({status,model:o.model||'',durationMs:Date.now()-r.startedMs,inputTokens:o.inputTokens||0,outputTokens:o.outputTokens||0,toolCalls:o.toolCalls||0,retries:o.retries||0,errorCode:(o.errorCode||'').slice(0,60),resultJson:o.result===undefined?null:JSON.stringify(o.result),finishedAt:new Date().toISOString()}).where(eq(engineRuns.runId,r.runId));
+}
