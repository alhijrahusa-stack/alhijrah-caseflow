+// Operational health of the engine for the office manager: job states (stuck = RUNNING with an expired lease), dead
+// letters, durations, AI usage/errors/fallbacks and tokens, provider status, last official-source check, audit chain.
+import { getDb } from '@/db';
+import { durableJobs,aiUsage,ruleWatchRuns,staffAlerts } from '@/db/schema';
+import { and,desc,eq,gte,isNull,sql } from 'drizzle-orm';
+import { providerStatus } from '../ai-usage';
+import { verifyAuditChain } from '../audit-chain';
+export async function engineHealth(now=Date.now()){
+ const db=getDb(),since=new Date(now-86400000).toISOString();
+ const [jobs,stuck,durations,usage,lastRun,lastOk,alerts,chain]=await Promise.all([
+  db.select({kind:durableJobs.kind,state:durableJobs.state,n:sql<number>`count(*)`}).from(durableJobs).groupBy(durableJobs.kind,durableJobs.state),
+  db.select({n:sql<number>`count(*)`}).from(durableJobs).where(and(eq(durableJobs.state,'RUNNING'),sql`${durableJobs.leaseUntilMs} < ${now}`)),
+  db.select({kind:durableJobs.kind,avgMs:sql<number>`avg((julianday(${durableJobs.updatedAt})-julianday(${durableJobs.createdAt}))*86400000)`,oldestPendingMs:sql<number>`max(CASE WHEN ${durableJobs.state} IN ('PENDING','RETRY') THEN ${now}-${durableJobs.nextAtMs} ELSE 0 END)`}).from(durableJobs).where(gte(durableJobs.updatedAt,since)).groupBy(durableJobs.kind),
+  db.select({provider:aiUsage.provider,model:aiUsage.model,status:aiUsage.status,n:sql<number>`count(*)`,avgMs:sql<number>`avg(${aiUsage.durationMs})`,inTok:sql<number>`sum(${aiUsage.inputTokens})`,outTok:sql<number>`sum(${aiUsage.outputTokens})`,fallbacks:sql<number>`sum(${aiUsage.fallback})`}).from(aiUsage).where(gte(aiUsage.createdAt,since)).groupBy(aiUsage.provider,aiUsage.model,aiUsage.status),
+  db.select().from(ruleWatchRuns).orderBy(desc(ruleWatchRuns.fetchedAt)).limit(1),
+  db.select().from(ruleWatchRuns).where(sql`${ruleWatchRuns.status} IN ('UPDATED','UNCHANGED')`).orderBy(desc(ruleWatchRuns.fetchedAt)).limit(1),
+  db.select({n:sql<number>`count(*)`}).from(staffAlerts).where(isNull(staffAlerts.acknowledgedAt)),
+  verifyAuditChain(),
+ ]);
+ return {generatedAt:new Date(now).toISOString(),jobs,stuckJobs:stuck[0].n,durations,ai:{last24h:usage,providers:providerStatus(),cost:'غير متاح: لا يوجد سعر وحدة مضبوط؛ تُعرض الرموز المستهلكة فقط.'},officialSources:{lastRun:lastRun[0]??null,lastSuccessfulCheck:lastOk[0]?.fetchedAt??null},openAlerts:alerts[0].n,auditChain:chain};
+}
