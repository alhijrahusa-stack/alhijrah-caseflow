+}
+
+// Ranked view of a stored package with the staff's current edits applied (edits never mutate the package).
+export function rankedView(raw: Raw, edits: StaffEdits, version: number, generatedAt: string): PackageCore & { notRanked: { pathwayId: string; name: string; reason: string }[] } {
+  const facts: TraceFact[] = raw.fields.map(f => ({ key: f.key, label: f.label, value: f.value, state: f.state, source: f.source }));
+  const { top, notRanked, pinned } = rankPathways(raw.pathways, edits);
+  const assumptions = [raw.crs.value === null ? 'لا تتوفر نقاط CRS محسوبة؛ لم تُستخدم في الترتيب.' : 'نقاط CRS معروضة منفصلة ولا تدخل في مؤشر الملاءمة.', 'الشروط بحالة «غير معروف» لا تُحتسب مستوفاة.'];
