+    const trace = buildTrace(s.p, facts, { ruleVersion: raw.ruleVersion, live: raw.live[s.p.id], position: i + 1, pinned: pinned.has(s.p.id), assumptions });
+    const next = trace.missing[0] ? `استكمال: ${trace.missing[0]}` : trace.blockers[0] ? `معالجة: ${trace.blockers[0]}` : 'مراجعة المختص المرخّص واعتماد المسار';
