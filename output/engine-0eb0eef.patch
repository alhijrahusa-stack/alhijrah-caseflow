+import { z } from 'zod';
+import { staff,sameOrigin,readJson,errorResponse } from '@/lib/server';
+import { requireManager } from '@/lib/rbac';
+import { engineHealth } from '@/lib/engine/health';
+import { requeueDeadJob } from '@/lib/jobs';
+import { runDrawRadar } from '@/lib/engine/radar';
+import { anchorAuditHead } from '@/lib/audit-chain';
+// MANAGER-only operational view and safe actions: requeue a dead-letter job (same request key → no duplicate effect),
+// run the official draw radar now, verify/anchor the audit chain.
+const headers={'Cache-Control':'private, no-store'};
+const schema=z.discriminatedUnion('action',[z.object({action:z.literal('requeue'),jobId:z.string().min(8).max(80)}).strict(),z.object({action:z.literal('radar')}).strict(),z.object({action:z.literal('anchor')}).strict()]);
+export async function GET(){try{const s=await staff();requireManager(s.authority);return Response.json(await engineHealth(),{headers});}catch(e){return errorResponse(e);}}
+export async function POST(request:Request){try{sameOrigin(request);const s=await staff();requireManager(s.authority);const d=await readJson(request,schema);
+ if(d.action==='requeue'){const r=await requeueDeadJob(d.jobId) as unknown;return Response.json({requeued:Array.isArray(r)?r.length>0:!!r},{headers});}
+ if(d.action==='radar')return Response.json(await runDrawRadar(),{headers});
+ return Response.json(await anchorAuditHead(),{headers});}catch(e){return errorResponse(e);}}
