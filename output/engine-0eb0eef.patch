+  view: { crs: { value: number | null; source: string; missingInputs: string[] }; pathways: Card[]; notRanked: { pathwayId: string; name: string; reason: string }[]; missingDocuments: string[]; roadmap: { id: string; owner: 'CLIENT' | 'OFFICE'; title: string; dependsOn: string[]; documents: { label: string; validUntil: string | null; expired: boolean }[]; estimate: string }[] };
+  fields: Field[]; conflicts: { field: string; extracted: unknown; current: unknown }[]; draws: Draw[];
+  edits: { pinned?: string[]; excluded?: { pathwayId: string; reason: string }[]; excludedEmployers?: string[]; internalNotes?: string; publicNotes?: string; publicGuidance?: string[] }; editsVersion: number;
+  scenarios: { scenarioId: string; name: string; changes: Record<string, unknown>; result: Scenario; includeInPublication: boolean; createdAt: string }[];
+  draftSnapshot: unknown; published: { publicationId: string; version: number; publishedAt: string } | null; diff: { field: string; change: string }[];
+  history: { publicationId: string; version: number; publishedAt: string; publishedBy: string; withdrawnAt: string | null }[];
