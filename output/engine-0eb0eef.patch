+// ALHIJRAH assessment engine — persistence and the visibility gate.
+// Flow: any data change → refreshEngine() builds a deterministic package (no AI) from the stored rule evaluation, CRS,
+// facts, extraction results, employers and draws; identical content is not stored twice (package hash), and a package
+// computed while the case changed underneath is discarded (data_revision guard). Staff edits live separately and are never
+// overwritten by a refresh. publish() freezes a client-safe snapshot as a numbered publication; clients read only the latest
+// non-withdrawn publication. Every step is written to the hash-chained audit log.
+import { getDb } from '@/db';
+import { candidates, assessmentPackages, assessmentStaffEdits, assessmentPublications, extractedFacts, caseScenarios, staffAlerts, documents, caseCrs, officeVacancies, officeEmployers, drawThresholds } from '@/db/schema';
+import { and, desc, eq, isNull, inArray } from 'drizzle-orm';
+import { z } from 'zod';
+import { ApiError } from '../server';
+import { appendAudit } from '../audit-chain';
+import { publish as publishFrame } from '../chat-transport';
+import { latestV22 } from '../assessment-store';
+import { listReports } from '../decision-support';
+import { documentLabels, educationLabels, profileSchema } from '../model';
+import { calculateCrs, crsSchema } from '../crs';
+import { loadInputs, evaluateCase } from '../case-engine';
+import { torontoDate } from '../v22-core';
+import type { Pathway } from '../assessment';
+import { ENGINE_VERSION, rankPathways, readinessOf, coverage, buildTrace, buildRoadmap, drawStats, clientSnapshot, diffSnapshots, scenarioDelta, sha256Hex, stable,
+  type StaffEdits, type RankedPathway, type TraceFact, type EvidenceState, type FieldEvidence, type Employer, type Round, type PackageCore, type ScenarioChange } from './core';
+
+type Raw = {
+  caseId: string; dataRevision: number; ruleVersion: string; pathways: Pathway[]; missingDocuments: string[]; status: string;
+  crs: { value: number | null; source: string; missingInputs: string[] }; fields: FieldEvidence[]; conflicts: { field: string; extracted: unknown; current: unknown; documentId: string | null }[];
+  employers: Employer[]; draws: NonNullable<ReturnType<typeof drawStats>>[]; expiries: { label: string; date: string }[];
+  live: Record<string, { url: string; checkedOn: string }[]>; community: string; aiRef: string;
+};
+const FIELDS: [keyof z.infer<typeof profileSchema>, string, boolean][] = [['occupation', 'المهنة', true], ['noc', 'رمز NOC', true], ['education', 'المؤهل', true], ['englishMin', 'الإنجليزية (أدنى CLB)', true], ['englishDate', 'تاريخ اختبار الإنجليزية', false], ['frenchMin', 'الفرنسية (أدنى NCLC)', true], ['eca', 'معادلة المؤهل ECA', true], ['jobOffer', 'عرض العمل', true], ['funds', 'أموال الاستقرار', false], ['country', 'بلد الإقامة', false], ['nationality', 'الجنسية', false]];
+const empty = (v: unknown) => v === null || v === undefined || v === '' || v === 'unknown';
+
+async function collect(caseId: string): Promise<Raw | null> {
+  const db = getDb(), [c] = await db.select().from(candidates).where(eq(candidates.id, caseId)).limit(1);
+  if (!c) return null;
+  const profile = JSON.parse(c.profile) as Record<string, unknown>, assessment = JSON.parse(c.assessment) as { ruleVersion: string; pathways: Pathway[]; missingDocuments: string[] };
+  const today = torontoDate(Date.now());
+  const [crsRow] = await db.select({ result: caseCrs.result }).from(caseCrs).where(eq(caseCrs.candidateId, caseId)).limit(1);
+  const v22 = await latestV22(caseId).catch(() => ({ verified: null, rapid: null })), a = (v22 as { verified: { crs?: { total?: number | null; missingFields?: string[] } } | null; rapid: { crs?: { total?: number | null; missingFields?: string[] } } | null }).verified ?? (v22 as { rapid: { crs?: { total?: number | null; missingFields?: string[] } } | null }).rapid;
+  const stored = crsRow ? (JSON.parse(crsRow.result) as { total?: number }).total ?? null : null;
+  const v22Total = a?.crs?.total ?? null;
+  const crs = v22Total !== null && v22Total !== undefined ? { value: v22Total, source: 'محرك القواعد المختومة (v2.2)', missingInputs: [] as string[] }
+    : stored !== null ? { value: stored, source: 'حاسبة CRS المحفوظة (مدخلات الموظف)', missingInputs: [] as string[] }
+    : { value: null, source: '', missingInputs: a?.crs?.missingFields?.length ? a.crs.missingFields : ['العمر', 'نتائج اللغة الأربع', 'المؤهل', 'سنوات الخبرة'] };
+  const ext = await db.select().from(extractedFacts).where(eq(extractedFacts.caseId, caseId)).orderBy(desc(extractedFacts.extractedAt));
+  const docs = await db.select({ id: documents.id, category: documents.category, verified: documents.verified, createdAt: documents.createdAt }).from(documents).where(eq(documents.candidateId, caseId));
+  const reviewed = new Set(docs.filter(d => d.verified).map(d => d.category));
+  const fields: FieldEvidence[] = FIELDS.map(([key, label, impactful]) => {
+    const value = profile[key] as string | number | null | undefined, e = ext.find(x => x.fieldKey === key && ['APPLIED', 'CONFLICTED'].includes(x.evidenceState));
+    let state: EvidenceState = empty(value) ? 'MISSING' : 'REPORTED', source = 'بيانات الملف', confidence: FieldEvidence['confidence'] = null;
+    if (e?.evidenceState === 'CONFLICTED') { state = 'CONFLICTED'; source = 'مستند ' + (e.documentId || '') ; confidence = e.confidence as FieldEvidence['confidence']; }
+    else if (e && !empty(value) && JSON.stringify(JSON.parse(e.valueJson)) === JSON.stringify(value)) { state = 'EXTRACTED'; source = e.location ? `مستند · ${e.location}` : 'مستند مرفوع'; confidence = e.confidence as FieldEvidence['confidence']; }
+    if (key === 'englishMin' && !empty(value) && reviewed.has('language')) state = 'REVIEWED';
+    if (key === 'education' && !empty(value) && (reviewed.has('education') || reviewed.has('eca'))) state = 'REVIEWED';
