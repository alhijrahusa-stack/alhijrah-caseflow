+-- A publication is immutable; the only permitted change is a single withdrawal (who/when), never undone.
+CREATE TRIGGER assessment_publications_guard BEFORE UPDATE ON assessment_publications
+ WHEN OLD.withdrawn_at IS NOT NULL OR NEW.withdrawn_at IS NULL OR NEW.withdrawn_by IS NULL OR NEW.snapshot_json<>OLD.snapshot_json OR NEW.package_id<>OLD.package_id
