+const evidence: Record<string, [string, string]> = { LMIA_HISTORICAL: ['سجل LMIA سابق', 'Past positive LMIA record'], PROGRAM_DESIGNATION: ['اعتماد ضمن برنامج', 'Program designation'], CURRENT_VACANCY: ['شاغر حالي', 'Current vacancy'], CLIENT_OFFER: ['عرض عمل لك', 'Your job offer'] };
+export function PublishedAssessment(){
+ const {lang}=usePortal(),ar=lang==='ar';const [d,setD]=useState<{version:number;publishedAt:string;assessment:Snap}|null|undefined>(undefined),[error,setError]=useState('');
+ useEffect(()=>{let on=true;api<{published:{version:number;publishedAt:string;assessment:Snap}|null}>('/api/client/assessment').then(r=>{if(on)setD(r.published);}).catch(e=>{if(on)setError((e as Error).message);});return()=>{on=false;};},[]);
+ if(error)return <section className="panel"><p className="error-banner" role="alert">{error}</p></section>;
+ if(d===undefined)return null;
+ if(!d)return <section className="panel published-assessment"><h2>{ar?'تقييم ملفك':'Your case assessment'}</h2><p>{ar?'سيظهر تقييم ملفك هنا بعد مراجعة المكتب ونشره.':'Your assessment appears here after the office reviews and publishes it.'}</p></section>;
+ const a=d.assessment;
+ return <section className="panel published-assessment" aria-label={ar?'تقييم ملفك المنشور':'Published assessment'}>
+  <header className="section-title"><div><span className="section-kicker">{ar?`النسخة ${d.version}`:`VERSION ${d.version}`}</span><h2>{ar?'تقييم ملفك':'Your case assessment'}</h2></div><small><bdi>{new Date(d.publishedAt).toLocaleDateString(ar?'ar':'en',{dateStyle:'long'})}</bdi></small></header>
+  {a.notes&&<p className="preserve-lines">{a.notes}</p>}
+  <div className="pa-cards">{a.pathways.map(p=><article key={p.rank} className={'pa-card'+(p.rank===1?' first':'')}><div className="pa-head"><span className="pa-rank">#{p.rank}</span><div><h3>{p.name}</h3><small>{p.region}</small></div><span className="pa-state">{(readiness[p.readiness]||[p.readiness,p.readiness])[ar?0:1]}</span></div>
+   <p className="pa-cover">{ar?`الشروط المستوفاة بحسب ملفك: ${p.coverage.met} من ${p.coverage.evaluated}`:`Requirements met per your file: ${p.coverage.met} of ${p.coverage.evaluated}`}</p>
+   {p.missing.length>0&&<div><strong>{ar?'المطلوب استكماله':'To complete'}</strong><ul>{p.missing.map(m=><li key={m}>{m}</li>)}</ul></div>}
+   <p className="pa-next"><strong>{ar?'الخطوة التالية: ':'Next step: '}</strong>{p.nextAction}</p>
+   {p.employers.map(e=><p key={e.name+e.title} className="pa-employer">{e.name} · {e.title} · {(evidence[e.evidenceKind]||[e.evidenceKind,e.evidenceKind])[ar?0:1]} · {e.checkedOn}</p>)}
+   {p.sources.length>0&&<p className="pa-sources">{p.sources.slice(0,2).map(s=><a key={s.url} href={s.url} target="_blank" rel="noreferrer">{ar?'مصدر رسمي':'Official source'} · {s.checkedOn}</a>)}</p>}
+  </article>)}</div>
+  {a.missingDocuments.length>0&&<div className="pa-block"><h3>{ar?'المستندات المطلوبة':'Documents requested'}</h3><ul>{a.missingDocuments.map(m=><li key={m}>{m}</li>)}</ul><p>{ar?'ارفعها من تبويب المستندات.':'Upload them from the Documents tab.'}</p></div>}
+  {a.guidance.length>0&&<div className="pa-block"><h3>{ar?'توجيهات المكتب':'Office guidance'}</h3><ul>{a.guidance.map(g=><li key={g}>{g}</li>)}</ul></div>}
+  {a.roadmap.length>0&&<div className="pa-block"><h3>{ar?'خطة التنفيذ':'Action plan'}</h3><ol>{a.roadmap.map((s,i)=><li key={i}>{s.owner==='CLIENT'?(ar?'أنت: ':'You: '):(ar?'المكتب: ':'Office: ')}{s.title}</li>)}</ol></div>}
+  <p className="fine-print">{ar?'تقييم استرشادي أعده المكتب وراجعه؛ القرار النهائي للجهات الرسمية الكندية، ولا تُضمن مواعيد أو نتائج.':'An advisory assessment prepared and reviewed by the office; final decisions rest with the Canadian authorities. No timelines or outcomes are guaranteed.'}</p>
+ </section>;
+}
