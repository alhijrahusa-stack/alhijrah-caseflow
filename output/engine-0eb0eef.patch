diff --git a/tests/engine-core.test.mjs b/tests/engine-core.test.mjs
new file mode 100644
index 0000000..19492b7
--- /dev/null
+++ b/tests/engine-core.test.mjs
@@ -0,0 +1,89 @@
+// Unit tests for the deterministic engine core (synthetic data only).
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { coverage, readinessOf, rankPathways, buildTrace, buildRoadmap, drawStats, scenarioDelta, clientSnapshot, diffSnapshots, chainHash, GENESIS, stable, parseRounds, ruleDate } from '../lib/engine/core.ts';
+
+const chk = (label, state, source = 'https://www.canada.ca/x') => ({ label, state, source });
+const P = (id, state, checks) => ({ id, title: id.toUpperCase(), subtitle: 'Federal', state, checks, caveat: 'تحقق المختص.' });
+const ready = P('fsw', 'potential', [chk('لغة', 'pass'), chk('خبرة', 'pass')]);
+const partial = P('rcip', 'incomplete', [chk('لغة', 'pass'), chk('عرض عمل', 'unknown'), chk('توصية', 'unknown')]);
+const partial2 = P('french', 'incomplete', [chk('فرنسية', 'unknown'), chk('خبرة', 'pass')]);
+const blocked = P('lmia', 'mismatch', [chk('عرض', 'fail'), chk('لغة', 'pass')]);
+
+test('coverage is met/evaluated with a stated method (not a probability); readiness follows the rule states', () => {
+  assert.deepEqual({ ...coverage(partial.checks), method: undefined }, { met: 1, evaluated: 3, percent: 33, method: undefined });
+  assert.match(coverage([]).method, /ليست احتمال قبول/);
+  assert.equal(readinessOf(ready), 'READY_FOR_REVIEW'); assert.equal(readinessOf(partial), 'NEEDS_COMPLETION'); assert.equal(readinessOf(blocked), 'BLOCKED');
+});
+
+test('ranking: ready first, then coverage; blocked never padded in; exclusions reported; pins honoured', () => {
+  const r = rankPathways([blocked, partial, ready]);
+  assert.deepEqual(r.top.map(t => t.p.id), ['fsw', 'rcip'], 'only two supported pathways — no padding to three');
+  assert.ok(r.notRanked.some(n => n.pathwayId === 'lmia' && /لا يطابق/.test(n.reason)));
+  const ex = rankPathways([blocked, partial, ready, partial2], { excluded: [{ pathwayId: 'fsw', reason: 'قرار المكتب' }] });
+  assert.deepEqual(ex.top.map(t => t.p.id), ['french', 'rcip']);
+  assert.ok(ex.notRanked.some(n => n.pathwayId === 'fsw' && n.reason.includes('قرار المكتب')));
+  const pin = rankPathways([ready, partial, partial2], { pinned: ['french'] });
+  assert.equal(pin.top[0].p.id, 'french');
+});
+
+test('explanation trace carries facts, rule version, official sources with dates, met/missing/blockers and assumptions', () => {
+  const t = buildTrace(partial, [{ key: 'englishMin', label: 'CLB', value: 6, state: 'REPORTED', source: 'بيانات الملف' }], { ruleVersion: '2026-11-15.v4', live: [{ url: 'https://www.canada.ca/live', checkedOn: '2026-11-16' }], position: 2, pinned: false, assumptions: ['افتراض'] });
+  assert.equal(t.rule.ruleVersion, '2026-11-15.v4'); assert.equal(t.facts[0].state, 'REPORTED');
+  assert.deepEqual(t.officialSources[0], { url: 'https://www.canada.ca/live', checkedOn: '2026-11-16', basis: 'LIVE_VERIFICATION' });
+  assert.equal(t.officialSources[1].checkedOn, ruleDate('2026-11-15.v4'));
+  assert.deepEqual(t.missing, ['عرض عمل', 'توصية']); assert.match(t.rankingReason, /#2/); assert.ok(t.assumptions.includes('تحقق المختص.'));
+});
+
+test('roadmap: client steps from missing items/documents, office steps depend on them, expiries flagged, no fixed durations', () => {
+  const top = { name: 'RCIP', missing: ['عرض عمل'] };
+  const steps = buildRoadmap(top, ['جواز السفر'], [{ label: 'جواز السفر', date: '2026-01-01' }, { label: 'اختبار اللغة', date: '2027-05-01' }], '2026-11-16');
+  assert.equal(steps[0].owner, 'CLIENT'); assert.ok(steps[0].documents.some(d => d.expired));
+  const review = steps.find(s => s.id === 'office-review');
+  assert.deepEqual(review.dependsOn, ['documents', 'req-0']);
+  assert.ok(steps.every(s => s.estimate === 'غير محدد'));
+  assert.deepEqual(buildRoadmap(undefined, [], [], '2026-11-16'), []);
+});
+
+test('draw stats: same-category window, trend and conservative/median/optimistic cut-offs; descriptive gap only', () => {
+  const rounds = [['General', '2026-10-01', 520], ['General', '2026-10-15', 510], ['General', '2026-11-01', 530], ['CEC', '2026-11-02', 540]].map(([category, drawDate, crsMin]) => ({ category, drawDate, crsMin, invitations: 1000, sourceUrl: 'https://www.canada.ca/r' }));
+  const s = drawStats(rounds, 'General', 515);
+  assert.equal(s.count, 3); assert.deepEqual(s.scenarios, { conservative: 530, median: 520, optimistic: 510 }); assert.equal(s.trend, 'RISING');
+  assert.deepEqual(s.gap, { conservative: -15, median: -5, optimistic: 5 }); assert.match(s.limits, /لا تعني دعوة/);
+  assert.equal(drawStats(rounds, 'French', 500), null);
+});
+
+test('scenario delta reports CRS change and only the pathways whose readiness/coverage changed', () => {
+  const d = scenarioDelta({ crs: 450, pathways: [{ id: 'fsw', name: 'FSW', readiness: 'NEEDS_COMPLETION', percent: 50 }, { id: 'rcip', name: 'RCIP', readiness: 'NEEDS_COMPLETION', percent: 33 }] }, { crs: 471, pathways: [{ id: 'fsw', name: 'FSW', readiness: 'READY_FOR_REVIEW', percent: 100 }, { id: 'rcip', name: 'RCIP', readiness: 'NEEDS_COMPLETION', percent: 33 }] });
+  assert.deepEqual(d.crs, { from: 450, to: 471, delta: 21 }); assert.deepEqual(d.affected.map(a => a.id), ['fsw']);
+  assert.equal(scenarioDelta({ crs: null, pathways: [] }, { crs: 400, pathways: [] }).crs.delta, null);
+});
+
+test('client snapshot excludes internal notes, excluded employers, traces and confidence; diff lists real changes', () => {
+  const card = { rank: 1, pathwayId: 'fsw', name: 'FSW', region: 'Federal', readiness: 'READY_FOR_REVIEW', indicator: { met: 2, evaluated: 2, percent: 100, method: 'm' }, reason: 'r', met: ['لغة'], missing: [], blockers: [], nextAction: 'مراجعة', pinned: false,
+    employers: [{ vacancyId: 'v1', name: 'Keep Co', title: 'Welder', evidenceKind: 'CURRENT_VACANCY', checkedOn: '2026-11-01' }, { vacancyId: 'v2', name: 'Hidden Co', title: 'Welder', evidenceKind: 'LMIA_HISTORICAL', checkedOn: '2026-11-01' }],
+    trace: { officialSources: [{ url: 'https://www.canada.ca/x', checkedOn: '2026-11-15', basis: 'RULE_CATALOGUE' }], facts: [{ key: 'k', confidence: 'LOW' }] } };
+  const pkg = { caseId: 'c', version: 3, dataRevision: 7, ruleVersion: 'r', generatedAt: 't', crs: { value: 470, source: 's', missingInputs: [] }, pathways: [card], missingDocuments: ['جواز السفر'], roadmap: [] };
+  const snap = clientSnapshot(pkg, { internalNotes: 'SECRET-INTERNAL', publicNotes: 'ملاحظة عامة', excludedEmployers: ['v2'] }, []);
+  const raw = JSON.stringify(snap);
