+'use client';
+// Client portal: the assessment the office published (latest non-withdrawn version only). Drafts never reach this view.
+import { useEffect, useState } from 'react';
+import { usePortal } from './chrome';
+import { api } from '@/lib/client';
+type Snap = { packageVersion: number; generatedAt: string; crs: { value: number } | null; pathways: { rank: number; name: string; region: string; readiness: string; coverage: { met: number; evaluated: number }; met: string[]; missing: string[]; nextAction: string; employers: { name: string; title: string; evidenceKind: string; checkedOn: string }[]; sources: { url: string; checkedOn: string }[] }[]; missingDocuments: string[]; roadmap: { owner: string; title: string; estimate: string }[]; notes: string; guidance: string[]; scenarios: { name: string }[] };
