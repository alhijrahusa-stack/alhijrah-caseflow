@@ -0,0 +1,57 @@
+// Live rules & draw radar: reads IRCC's published Express Entry rounds data, validates it, stores new rounds once
+// (draw_thresholds UNIQUE(category,draw_date)), keeps a hashed raw snapshot in private R2 + source_snapshots, records the
+// run, then refreshes only the cases that have a stored CRS and alerts staff (never the client) when a new round's cut-off
+// is at or below the case's stored CRS — stated as a descriptive comparison, not an invitation. Unverified web content
+// never edits eligibility rules: only the numeric rounds table is updated, and only after validation.
+import { env } from 'cloudflare:workers';
+import { getDb } from '@/db';
+import { drawThresholds, ruleWatchRuns, sourceSnapshots, staffAlerts, caseCrs, candidates } from '@/db/schema';
+import { desc, eq, ne } from 'drizzle-orm';
+import { sha256Hex, parseRounds, type ParsedRound } from './core';
+export { parseRounds };
+import { refreshEngine } from './store';
+import { SYSTEM_USER_ID } from '../rbac';
+
+export const ROUNDS_URL = 'https://www.canada.ca/content/dam/ircc/documents/json/ee_rounds_123_en.json';
+export async function runDrawRadar(fetcher: typeof fetch = fetch) {
+  const db = getDb(), at = new Date().toISOString(), runId = crypto.randomUUID();
+  let text = '';
+  try {
+    const r = await fetcher(ROUNDS_URL, { headers: { Accept: 'application/json' } });
+    if (!r.ok) throw new Error('HTTP_' + r.status);
+    text = await r.text();
+  } catch (e) {
+    await db.insert(ruleWatchRuns).values({ runId, sourceUrl: ROUNDS_URL, fetchedAt: at, status: 'FAILED', errorCode: String((e as Error).message || 'FETCH').slice(0, 60) });
+    return { status: 'FAILED' as const, roundsAdded: 0, affected: 0 };
+  }
+  const sha = await sha256Hex(text);
+  const [last] = await db.select().from(ruleWatchRuns).where(ne(ruleWatchRuns.status, 'FAILED')).orderBy(desc(ruleWatchRuns.fetchedAt)).limit(1);
+  if (last?.contentSha256 === sha) { await db.insert(ruleWatchRuns).values({ runId, sourceUrl: ROUNDS_URL, fetchedAt: at, contentSha256: sha, status: 'UNCHANGED' }); return { status: 'UNCHANGED' as const, roundsAdded: 0, affected: 0 }; }
+  let parsed: ParsedRound[] = [];
+  try { parsed = parseRounds(JSON.parse(text)); } catch { parsed = []; }
+  if (!parsed.length) { await db.insert(ruleWatchRuns).values({ runId, sourceUrl: ROUNDS_URL, fetchedAt: at, contentSha256: sha, status: 'INVALID', errorCode: 'NO_VALID_ROUNDS' }); return { status: 'INVALID' as const, roundsAdded: 0, affected: 0 }; }
+  if (env.BUCKET) {
+    const key = `sources/ee-rounds/${sha}.json`;
+    await env.BUCKET.put(key, text, { httpMetadata: { contentType: 'application/json' } });
+    await db.insert(sourceSnapshots).values({ sourceId: 'ee-rounds-' + sha.slice(0, 16), officialUrl: ROUNDS_URL, objectKey: key, contentSha256: sha, fetchedAt: at }).onConflictDoNothing();
+  }
+  const added: ParsedRound[] = [];
+  for (const r of parsed) {
+    const ins = await db.insert(drawThresholds).values({ id: crypto.randomUUID(), category: r.category, drawDate: r.drawDate, crsMin: r.crsMin, invitations: r.invitations, sourceUrl: ROUNDS_URL }).onConflictDoNothing().returning({ id: drawThresholds.id });
+    if (ins.length) added.push(r);
+  }
+  let affected = 0;
+  if (added.length) {
+    const rows = await db.select({ id: candidates.id, status: candidates.status, result: caseCrs.result }).from(caseCrs).innerJoin(candidates, eq(candidates.id, caseCrs.candidateId));
+    const newest = [...added].sort((a, b) => b.drawDate.localeCompare(a.drawDate)).slice(0, 10);
+    for (const row of rows.filter(r => r.status !== 'archived')) {
+      const total = (JSON.parse(row.result) as { total?: number }).total; if (typeof total !== 'number') continue;
+      affected++;
+      await refreshEngine(row.id, SYSTEM_USER_ID, 'draw_update');
+      for (const r of newest.filter(n => total >= n.crsMin))
+        await db.insert(staffAlerts).values({ alertId: crypto.randomUUID(), caseId: row.id, kind: 'DRAW_CHANGE', payloadJson: JSON.stringify({ category: r.category, drawDate: r.drawDate, cutoff: r.crsMin, caseCrs: total, note: 'مقارنة وصفية: نقاط الملف المحفوظة ≥ حد هذا السحب. ليست دعوة.' }), dedupeKey: `draw:${row.id}:${r.category}:${r.drawDate}`, createdAt: at }).onConflictDoNothing();
+    }
+  }
+  await db.insert(ruleWatchRuns).values({ runId, sourceUrl: ROUNDS_URL, fetchedAt: at, contentSha256: sha, status: 'UPDATED', roundsAdded: added.length, affectedCases: affected });
+  return { status: 'UPDATED' as const, roundsAdded: added.length, affected };
+}
