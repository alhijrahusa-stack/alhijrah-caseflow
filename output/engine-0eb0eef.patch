+'use client';
+// Manager card: engine operational health (jobs, stuck/dead letters, AI usage and errors, provider status, official
+// source checks, audit chain) with safe actions.
+import { useEffect, useState } from 'react';
+import { Activity, LoaderCircle, RefreshCw } from 'lucide-react';
+import { api } from '@/lib/client';
+type H = { generatedAt: string; jobs: { kind: string; state: string; n: number }[]; stuckJobs: number; durations: { kind: string; avgMs: number | null; oldestPendingMs: number | null }[]; ai: { last24h: { provider: string; model: string; status: string; n: number; avgMs: number | null; inTok: number | null; outTok: number | null; fallbacks: number | null }[]; providers: { provider: string; approved: boolean; configured: boolean; implemented: boolean; usable: boolean }[]; cost: string }; officialSources: { lastRun: { status: string; fetchedAt: string; roundsAdded: number; affectedCases: number; errorCode: string } | null; lastSuccessfulCheck: string | null }; openAlerts: number; auditChain: { ok: boolean; entries: number; brokenAt: number | null } };
+const names: Record<string, string> = { openai: 'المحرك الأساسي', gemini: 'محرك بديل (1)', workers_ai: 'محرك بديل (2)' };
+export function EngineHealth() {
+  const [h, setH] = useState<H | null>(null), [error, setError] = useState(''), [busy, setBusy] = useState(''), [rev, setRev] = useState(0);
+  useEffect(() => { let on = true; api<H>('/api/office/engine-health').then(x => { if (on) setH(x); }).catch(e => { if (on) setError((e as Error).message); }); return () => { on = false; }; }, [rev]);
+  async function act(action: string) { setBusy(action); try { await api('/api/office/engine-health', { method: 'POST', body: JSON.stringify({ action }), timeoutMs: 120000 }); setRev(r => r + 1); } catch (e) { setError((e as Error).message); } finally { setBusy(''); } }
+  if (error) return <section className="panel"><p className="error-banner" role="alert">{error}</p></section>;
+  if (!h) return <section className="panel"><LoaderCircle className="spin" size={18} /></section>;
+  const dead = h.jobs.filter(j => j.state === 'DEAD_LETTER').reduce((n, j) => n + j.n, 0), failed = h.jobs.filter(j => j.state === 'FAILED').reduce((n, j) => n + j.n, 0);
+  return <section className="panel settings-card" aria-label="صحة المحرك"><Activity size={24} /><h2>صحة محرك ALHIJRAH والتكلفة</h2>
+    <ul className="fine-print">
+      <li>المهام: {h.jobs.map(j => `${j.kind}/${j.state}: ${j.n}`).join(' · ') || 'لا مهام'} · عالقة: {h.stuckJobs} · فاشلة: {failed} · طابور الأخطاء: {dead}</li>
+      <li>الأزمنة (24 ساعة): {h.durations.map(d => `${d.kind} متوسط ${Math.round((d.avgMs || 0) / 1000)}ث · أقدم انتظار ${Math.round((d.oldestPendingMs || 0) / 1000)}ث`).join(' · ') || '—'}</li>
+      <li>الاستدعاءات (24 ساعة): {h.ai.last24h.map(u => `${names[u.provider] || u.provider} ${u.status}: ${u.n} (متوسط ${Math.round(u.avgMs || 0)}ms، رموز ${u.inTok || 0}/${u.outTok || 0}، بديل ${u.fallbacks || 0})`).join(' · ') || 'لا استدعاءات'}</li>
+      <li>المحركات: {h.ai.providers.map(p => `${names[p.provider]}: ${p.usable ? 'يعمل' : !p.approved ? 'غير معتمد' : !p.configured ? 'غير مهيأ' : 'غير منفذ في هذا الإصدار'}`).join(' · ')}</li>
+      <li>التكلفة: {h.ai.cost}</li>
+      <li>آخر تحقق رسمي ناجح: {h.officialSources.lastSuccessfulCheck || 'لم يتم بعد'}{h.officialSources.lastRun ? ` · آخر محاولة: ${h.officialSources.lastRun.status}${h.officialSources.lastRun.errorCode ? ' (' + h.officialSources.lastRun.errorCode + ')' : ''}` : ''}</li>
+      <li>سجل التدقيق: {h.auditChain.ok ? `سليم (${h.auditChain.entries} قيدًا)` : `انكسار عند القيد ${h.auditChain.brokenAt}`} · تنبيهات مفتوحة: {h.openAlerts}</li>
+    </ul>
+    <div className="inline-actions"><button type="button" className="button subtle small-button" disabled={!!busy} onClick={() => void act('radar')}>{busy === 'radar' ? <LoaderCircle className="spin" size={15} /> : <RefreshCw size={15} />}فحص السحوبات الرسمية الآن</button><button type="button" className="button subtle small-button" disabled={!!busy} onClick={() => void act('anchor')}>التحقق من سجل التدقيق وتثبيته</button></div>
+  </section>;
+}
