+const TR_SOURCE={url:'https://www.canada.ca/en/immigration-refugees-citizenship/services/application/application-forms-guides/temporary-resident-visa-application-photograph-specifications.html',pageModified:'2023-07-24',reviewedOn:'2026-11-16'};
