+CREATE INDEX access_recovery_events_request ON access_recovery_events(request_id,created_at);
+--> statement-breakpoint
+CREATE TRIGGER access_recovery_events_no_update BEFORE UPDATE ON access_recovery_events BEGIN SELECT RAISE(ABORT,'RECOVERY_EVENT_IMMUTABLE'); END;
+--> statement-breakpoint
+CREATE TRIGGER access_recovery_events_no_delete BEFORE DELETE ON access_recovery_events BEGIN SELECT RAISE(ABORT,'RECOVERY_EVENT_IMMUTABLE'); END;
+--> statement-breakpoint
+-- Photo assistant. Originals are kept byte-for-byte in private R2; derivatives would reference their parent (the reviewed
+-- IRCC rulesets permit no alteration, so none are produced today).
+CREATE TABLE photo_assets(
+ photo_id TEXT PRIMARY KEY NOT NULL,
+ account_key TEXT NOT NULL CHECK(length(account_key)=64),
