+// Display mask for a verified-email screen: the local part keeps its first two characters (a local part of one or two
+// characters is masked entirely); the domain is kept. Code points, not UTF-16 units, so non-ASCII local parts mask cleanly.
+export function maskEmail(email:string){
+ const e=email.trim(),at=e.lastIndexOf('@');if(at<=0)return e;
+ const local=[...e.slice(0,at)],domain=e.slice(at);
+ return (local.length<=2?'*'.repeat(local.length):local.slice(0,2).join('')+'*'.repeat(local.length-2))+domain;
+}
