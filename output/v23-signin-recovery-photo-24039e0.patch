+export const provenanceSchema=z.object({studioName:z.string().trim().max(150).default(''),studioAddress:z.string().trim().max(300).default(''),photoDate:z.string().regex(/^\d{4}-\d{2}-\d{2}$|^$/).default(''),backInfoConfirmed:z.boolean().default(false),childRulesConfirmed:z.boolean().default(false)}).strict();
