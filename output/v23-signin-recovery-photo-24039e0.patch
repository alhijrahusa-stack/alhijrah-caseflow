+export function parseExif(t:Uint8Array):Exif{
+ try{
+  if(t.length<8)return EMPTY;
+  const le=t[0]===0x49&&t[1]===0x49,be=t[0]===0x4d&&t[1]===0x4d;if(!le&&!be)return EMPTY;
