+ candidateId:text('candidate_id').notNull().references(()=>candidates.id),documentId:text('document_id').notNull().unique().references(()=>documents.id),
+ replacedDocumentId:text('replaced_document_id'),requestKey:text('request_key').notNull().unique(),createdAt:text('created_at').notNull(),
+});
