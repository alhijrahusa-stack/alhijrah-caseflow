+const EDITORS=/photoshop|lightroom|gimp|snapseed|picsart|facetune|airbrush|meitu|canva|pixlr|affinity|remini|faceapp|beautyplus|perfect365|youcam/i;
+export const editingSoftware=(s:string|null)=>!!s&&EDITORS.test(s);
