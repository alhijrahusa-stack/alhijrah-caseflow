+// Server-side direct measurements of an uploaded photo: format from the file signature (never the extension or the
+// browser's content-type), pixel dimensions from the JPEG SOF / PNG IHDR header, byte size, and EXIF metadata (capture
+// date, camera, editing software, orientation) from the JPEG APP1 segment. Pure functions over bytes; no decoding of
+// pixels, so the cost stays small inside the Worker. EXIF is supporting information only.
+export type Measured={mime:'image/jpeg'|'image/png';width:number;height:number;bytes:number;exif:Exif};
+export type Exif={dateTimeOriginal:string|null;dateTime:string|null;make:string|null;model:string|null;software:string|null;orientation:number|null;artist:string|null};
+const EMPTY:Exif={dateTimeOriginal:null,dateTime:null,make:null,model:null,software:null,orientation:null,artist:null};
+
+export function sniffMime(b:Uint8Array):'image/jpeg'|'image/png'|null{
+ if(b.length>3&&b[0]===0xff&&b[1]===0xd8&&b[2]===0xff)return 'image/jpeg';
+ if(b.length>8&&[0x89,0x50,0x4e,0x47,0x0d,0x0a,0x1a,0x0a].every((v,i)=>b[i]===v))return 'image/png';
+ return null;
+}
+function pngSize(b:Uint8Array){if(b.length<24||String.fromCharCode(b[12],b[13],b[14],b[15])!=='IHDR')return null;const v=new DataView(b.buffer,b.byteOffset,b.byteLength);return {width:v.getUint32(16),height:v.getUint32(20)};}
+// Walks JPEG markers; SOF0–SOF15 except DHT (C4), JPG (C8) and DAC (CC) carry the frame size. Also returns the APP1 Exif payload.
+function jpegScan(b:Uint8Array){
+ let i=2,size:{width:number;height:number}|null=null,exif:Uint8Array|null=null;
+ while(i+4<=b.length){
+  if(b[i]!==0xff){i++;continue;}
+  const marker=b[i+1];if(marker===0xff){i++;continue;}
+  if(marker===0xd8||(marker>=0xd0&&marker<=0xd7)||marker===0x01){i+=2;continue;}
+  if(marker===0xd9||marker===0xda)break;
+  const len=(b[i+2]<<8)|b[i+3];if(len<2||i+2+len>b.length)break;
+  if(marker>=0xc0&&marker<=0xcf&&marker!==0xc4&&marker!==0xc8&&marker!==0xcc&&len>=7){size={height:(b[i+5]<<8)|b[i+6],width:(b[i+7]<<8)|b[i+8]};}
