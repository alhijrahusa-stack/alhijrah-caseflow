--- /dev/null
+++ b/lib/access-recovery.ts
@@ -0,0 +1,176 @@
+// v2.3 — access recovery for a client who no longer reaches the email on their case file.
+// 1) The requester proves control of a NEW email with a recovery code (recovery_codes; separate from sign-in codes).
+// 2) A request is stored with the normalized lookup (mobile with country code, or case file number) and the typed name.
+//    These are used for matching only; verifying the new email grants no access to the previous account or file.
+// 3) Staff review ownership evidence; a MANAGER completes it: the file's email changes atomically, every previous case
+//    session, account session, pending code and case password is revoked, and both addresses are notified.
+// Every step appends to access_recovery_events (UPDATE/DELETE refused by triggers). Matching details are staff-only.
+import { and,desc,eq,gt,inArray,isNull,lt,sql } from 'drizzle-orm';
+import { z } from 'zod';
+import { getDb } from '@/db';
+import { accessRecoveryEvents,accessRecoveryRequests,authChallenges,candidates,clientCases,clientSessions,events,loginCredentials,recoveryCodes } from '@/db/schema';
+import { ApiError } from './api-error';
+import { decrypt,encrypt,sha } from './security';
+import { codeDigest,targetThrottle } from './otp';
+import { deliverOtp,deliveryOptions } from './otp-delivery';
+import { latinDigits,normalizedIdentity,contactKeys } from './contact-identity';
+import { profileSchema } from './model';
+import { isUniqueViolation } from './db-errors';
+import { sendSystemEmail } from './system-mail';
+import { maskEmail } from './email-mask';
+import { PORTAL_ORIGIN } from './branding';
+
+export const RECOVERY_STATUSES=['NEW','UNDER_REVIEW','INFO_REQUIRED','COMPLETED','UNABLE_TO_VERIFY'] as const;
+export type RecoveryStatus=typeof RECOVERY_STATUSES[number];
+const OPEN:RecoveryStatus[]=['NEW','UNDER_REVIEW','INFO_REQUIRED'];
+type Lookup={type:'PHONE'|'CASE_REFERENCE';value:string};
+
+// Mobile with country code (+ or 00 prefix, 8–15 digits) or a case file number (letters present). Arabic-Indic digits
+// are accepted. The normalized pair is what deduplicates open requests.
+export function normalizeLookup(input:string):Lookup{
+ const raw=latinDigits(input).trim();
+ if(/[A-Za-z]/.test(raw)){
+  const value=raw.toUpperCase().replace(/\s+/g,'');
+  if(!/^[A-Z]{2,4}(-[A-Z0-9]{2,12}){1,3}$/.test(value))throw new ApiError(400,'رقم الملف غير صحيح. مثال: ALH-CA-1A2B3C4D');
+  return {type:'CASE_REFERENCE',value};
+ }
+ let d=raw.replace(/[\s().\-‎‏]/g,'');if(d.startsWith('00'))d='+'+d.slice(2);
+ if(!/^\+[1-9]\d{7,14}$/.test(d))throw new ApiError(400,'أدخل رقم الجوال مع رمز الدولة (مثل +1 أو +967) أو رقم الملف.');
+ return {type:'PHONE',value:d};
+}
+const ticketSchema=z.object({id:z.string().uuid(),email:z.string().email(),expiresAt:z.number(),lookupType:z.enum(['PHONE','CASE_REFERENCE']),lookupValue:z.string().min(4).max(40),fullName:z.string().min(2).max(150),locale:z.enum(['ar','en'])});
+const invalid=()=>new ApiError(400,'الرمز غير صحيح أو انتهت صلاحيته.');
+const cleanName=(n:string)=>n.normalize('NFKC').replace(/\s+/g,' ').trim();
+
+export async function requestRecoveryCode(input:{identifier:string;fullName:string;email:string;requestKey:string;locale:'ar'|'en'}){
+ if(!(await deliveryOptions()).email)throw new ApiError(503,'الاستعادة بالبريد غير متاحة حاليًا. تواصل مع المكتب.');
+ const lookup=normalizeLookup(input.identifier),fullName=cleanName(input.fullName),email=input.email.trim().toLowerCase();
+ if(fullName.length<2||fullName.length>150)throw new ApiError(400,'أدخل الاسم الكامل.');
+ const db=getDb(),key=await sha('recovery-request:'+email+':'+input.requestKey),[prior]=await db.select().from(recoveryCodes).where(eq(recoveryCodes.requestKey,key)).limit(1);
+ const ticketOf=async(id:string,expiresAt:number)=>encrypt(JSON.stringify({id,email,expiresAt,lookupType:lookup.type,lookupValue:lookup.value,fullName,locale:input.locale}));
+ if(prior)return {requestId:prior.codeId,expiresAt:prior.expiresAt,resendAfter:60,ticket:await ticketOf(prior.codeId,prior.expiresAt),maskedEmail:maskEmail(email)};
+ await targetThrottle('recovery-email:'+email,5,3600);
+ const now=Date.now(),cooldown=await db.all<{key:string}>(sql`INSERT INTO rate_limits (key,count,expires) VALUES (${await sha('recovery-cooldown:'+email)},1,${Math.floor(now/1000)+60}) ON CONFLICT(key) DO UPDATE SET expires=excluded.expires WHERE rate_limits.expires<=${Math.floor(now/1000)} RETURNING key`);
+ if(!cooldown.length)throw new ApiError(429,'انتظر 60 ثانية قبل طلب رمز جديد.');
+ const id=crypto.randomUUID(),expiresAt=now+600000,emailHash=await sha(email);let n:number;do{n=crypto.getRandomValues(new Uint32Array(1))[0];}while(n>=4294000000);const code=String(n%1000000).padStart(6,'0');
+ await db.batch([db.update(recoveryCodes).set({expiresAt:now}).where(and(eq(recoveryCodes.emailHash,emailHash),isNull(recoveryCodes.usedAt),gt(recoveryCodes.expiresAt,now))),db.insert(recoveryCodes).values({codeId:id,emailHash,codeHash:await codeDigest(id,code),requestKey:key,state:'created',expiresAt,createdAt:now})]);
+ const delivered=await deliverOtp('email',email,code,input.locale,id,{audience:'client',purpose:'recovery'});
+ await db.update(recoveryCodes).set({state:delivered.state}).where(eq(recoveryCodes.codeId,id));
+ return {requestId:id,expiresAt,resendAfter:60,ticket:await ticketOf(id,expiresAt),maskedEmail:maskEmail(email)};
+}
+
+// Staff-only matching record: which files the lookup points to and whether the name and email agree. Never returned to
+// the requester (a case-number match with a different email stays visible to staff only).
+async function matchFiles(lookup:Lookup,fullName:string,verifiedEmail:string){
+ const db=getDb(),base=db.select({id:candidates.id,reference:candidates.reference,profile:candidates.profile}).from(candidates).innerJoin(clientCases,eq(clientCases.candidateId,candidates.id));
+ const digits=lookup.value.replace(/\D/g,'');
+ const rows=lookup.type==='CASE_REFERENCE'?await base.where(eq(candidates.reference,lookup.value)).limit(5)
+  :await base.where(sql`replace(replace(replace(replace(replace(replace(json_extract(${candidates.profile},'$.phone'),' ',''),'-',''),'(',''),')',''),'+',''),'.','') IN (${digits},${'00'+digits})`).limit(5);
+ const name=normalizedIdentity({fullName,phone:''}).name;
+ const files=rows.map(r=>{const p=JSON.parse(r.profile) as {fullName?:string;email?:string};const fileEmail=(p.email||'').trim().toLowerCase();return {candidateId:r.id,reference:r.reference,nameMatches:normalizedIdentity({fullName:p.fullName||'',phone:''}).name===name,emailDiffers:fileEmail!==verifiedEmail,fileEmailMasked:fileEmail?maskEmail(fileEmail):''};});
+ return {method:lookup.type,files,single:files.length===1?files[0].candidateId:null};
+}
+const reference=()=>'AR-'+Array.from(crypto.getRandomValues(new Uint8Array(4)),b=>b.toString(16).padStart(2,'0')).join('').toUpperCase();
+const event=(requestId:string,actor:string,eventType:string,detail:Record<string,unknown>,fromStatus:string|null=null,toStatus:string|null=null)=>({eventId:crypto.randomUUID(),requestId,actor,eventType,fromStatus,toStatus,detailJson:JSON.stringify(detail),createdAt:new Date().toISOString()});
+
+export async function submitRecoveryRequest(ticket:string,code:string){
+ let d:z.infer<typeof ticketSchema>;try{d=ticketSchema.parse(JSON.parse(await decrypt(ticket)));}catch{throw invalid();}
+ const db=getDb(),now=Date.now(),[row]=await db.select().from(recoveryCodes).where(eq(recoveryCodes.codeId,d.id)).limit(1);
+ if(d.expiresAt<=now||!row||row.emailHash!==await sha(d.email)||row.usedAt||row.expiresAt<=now||row.attempts>=5||!['accepted','unknown'].includes(row.state))throw invalid();
+ const digest=await codeDigest(d.id,code);let diff=0;for(let i=0;i<digest.length;i++)diff|=digest.charCodeAt(i)^row.codeHash.charCodeAt(i);
+ if(diff){await db.update(recoveryCodes).set({attempts:sql`${recoveryCodes.attempts}+1`}).where(and(eq(recoveryCodes.codeId,d.id),isNull(recoveryCodes.usedAt),lt(recoveryCodes.attempts,5)));throw invalid();}
+ const [claimed]=await db.update(recoveryCodes).set({usedAt:now}).where(and(eq(recoveryCodes.codeId,d.id),isNull(recoveryCodes.usedAt),lt(recoveryCodes.attempts,5),gt(recoveryCodes.expiresAt,now),eq(recoveryCodes.codeHash,digest))).returning({id:recoveryCodes.codeId});
+ if(!claimed)throw invalid();
+ const openOne=async()=>{const [r]=await db.select().from(accessRecoveryRequests).where(and(eq(accessRecoveryRequests.verifiedEmail,d.email),eq(accessRecoveryRequests.lookupType,d.lookupType),eq(accessRecoveryRequests.lookupValue,d.lookupValue),inArray(accessRecoveryRequests.status,OPEN))).limit(1);return r;};
+ const existing=await openOne();
+ if(existing){await db.insert(accessRecoveryEvents).values(event(existing.requestId,'client:'+await sha(d.email),'REPLAYED',{codeId:d.id}));return {reference:existing.reference,status:existing.status as RecoveryStatus,existing:true};}
+ const match=await matchFiles({type:d.lookupType,value:d.lookupValue},d.fullName,d.email),requestId=crypto.randomUUID(),at=new Date().toISOString();
+ for(let attempt=0;attempt<3;attempt++){
+  const ref=reference();
+  try{
+   await db.batch([
+    db.insert(accessRecoveryRequests).values({requestId,reference:ref,verifiedEmail:d.email,lookupType:d.lookupType,lookupValue:d.lookupValue,fullName:d.fullName,locale:d.locale,status:'NEW',matchedCandidateId:match.single,matchJson:JSON.stringify(match),createdAt:at,updatedAt:at}),
+    db.insert(accessRecoveryEvents).values(event(requestId,'client:'+await sha(d.email),'CREATED',{verifiedEmail:d.email,lookupType:d.lookupType,lookupValue:d.lookupValue,fullName:d.fullName,codeId:d.id},null,'NEW')),
+   ]);
+   const outcome=await sendSystemEmail({to:d.email,idempotencyKey:'recovery/received/'+requestId,subject:d.locale==='ar'?`استلمنا طلب استعادة الوصول ${ref} | ALHIJRAH`:`Access recovery request ${ref} received | ALHIJRAH`,text:d.locale==='ar'?`استلمنا طلب استعادة الوصول رقم ${ref}.\nسيراجع المكتب ملكية الملف، وسنراسلك على هذا البريد بعد المراجعة.\nلا يمنح هذا الطلب وصولًا إلى أي ملف قبل اكتمال المراجعة.`:`We received access recovery request ${ref}.\nThe office will review ownership of the case file and email you at this address after the review.\nThis request does not grant access to any file before the review is complete.`});
+   await db.insert(accessRecoveryEvents).values(event(requestId,'system','NOTIFICATION',{kind:'RECEIVED',to:d.email,outcome}));
+   return {reference:ref,status:'NEW' as RecoveryStatus,existing:false};
+  }catch(e){
+   if(!isUniqueViolation(e))throw e;
+   const winner=await openOne();if(winner)return {reference:winner.reference,status:winner.status as RecoveryStatus,existing:true};
+  }
+ }
+ throw new ApiError(409,'تعذّر حفظ الطلب. أعد المحاولة.');
+}
+
+// ---- staff side -------------------------------------------------------------------------------------------------
+export async function listRecoveryRequests(status?:RecoveryStatus){
+ const db=getDb(),q=db.select().from(accessRecoveryRequests);
+ const rows=await (status?q.where(eq(accessRecoveryRequests.status,status)):q).orderBy(desc(accessRecoveryRequests.createdAt)).limit(100);
+ return rows.map(r=>({requestId:r.requestId,reference:r.reference,status:r.status,verifiedEmail:r.verifiedEmail,lookupType:r.lookupType,lookupValue:r.lookupValue,fullName:r.fullName,match:JSON.parse(r.matchJson),matchedCandidateId:r.matchedCandidateId,decisionReason:r.decisionReason,decidedBy:r.decidedBy,decidedAt:r.decidedAt,version:r.version,createdAt:r.createdAt,updatedAt:r.updatedAt}));
+}
+export async function recoveryEvents(requestId:string){return (await getDb().select().from(accessRecoveryEvents).where(eq(accessRecoveryEvents.requestId,requestId)).orderBy(accessRecoveryEvents.createdAt)).map(e=>({...e,detail:JSON.parse(e.detailJson)}));}
+const TRANSITIONS:Record<string,RecoveryStatus[]>={NEW:['UNDER_REVIEW','INFO_REQUIRED','UNABLE_TO_VERIFY'],UNDER_REVIEW:['INFO_REQUIRED','UNABLE_TO_VERIFY'],INFO_REQUIRED:['UNDER_REVIEW','UNABLE_TO_VERIFY']};
+async function load(requestId:string){const [r]=await getDb().select().from(accessRecoveryRequests).where(eq(accessRecoveryRequests.requestId,requestId)).limit(1);if(!r)throw new ApiError(404,'طلب الاستعادة غير موجود.');return r;}
+async function notifyRequester(r:typeof accessRecoveryRequests.$inferSelect,kind:'INFO_REQUIRED'|'UNABLE_TO_VERIFY',reason:string){
+ const ar=r.locale==='ar';
+ const subject=kind==='INFO_REQUIRED'?(ar?`طلب الاستعادة ${r.reference}: نحتاج معلومات إضافية`:`Recovery request ${r.reference}: information required`):(ar?`طلب الاستعادة ${r.reference}: تعذّر التحقق`:`Recovery request ${r.reference}: unable to verify`);
+ const text=kind==='INFO_REQUIRED'?(ar?`نحتاج معلومات إضافية لمراجعة طلبك ${r.reference}:\n${reason}\nردّ على هذه الرسالة أو تواصل مع المكتب.`:`We need more information to review request ${r.reference}:\n${reason}\nReply to this email or contact the office.`):(ar?`تعذّر علينا التحقق من ملكية الملف في الطلب ${r.reference}.\nالسبب: ${reason}\nيمكنك التواصل مع المكتب لتقديم أدلة إضافية.`:`We could not verify ownership of the case file in request ${r.reference}.\nReason: ${reason}\nYou can contact the office to provide further evidence.`);
+ const outcome=await sendSystemEmail({to:r.verifiedEmail,subject,text,idempotencyKey:`recovery/${kind}/${r.requestId}/${r.version}`});
+ await getDb().insert(accessRecoveryEvents).values(event(r.requestId,'system','NOTIFICATION',{kind,to:r.verifiedEmail,outcome}));
+}
+export async function setRecoveryStatus(input:{requestId:string;expectedVersion:number;status:RecoveryStatus;reason:string;actor:string}){
+ const r=await load(input.requestId),reason=input.reason.trim();
+ if(!(TRANSITIONS[r.status]||[]).includes(input.status))throw new ApiError(409,'لا يمكن نقل الطلب إلى هذه الحالة من حالته الحالية.');
+ if((input.status==='INFO_REQUIRED'||input.status==='UNABLE_TO_VERIFY')&&reason.length<5)throw new ApiError(400,'اكتب السبب (5 أحرف على الأقل).');
+ const db=getDb(),at=new Date().toISOString();
+ const [updated]=await db.update(accessRecoveryRequests).set({status:input.status,decisionReason:reason||r.decisionReason,decidedBy:input.actor,decidedAt:at,version:r.version+1,updatedAt:at}).where(and(eq(accessRecoveryRequests.requestId,r.requestId),eq(accessRecoveryRequests.version,input.expectedVersion),eq(accessRecoveryRequests.status,r.status))).returning();
+ if(!updated)throw new ApiError(409,'تغيّر الطلب في جلسة أخرى. حدّث الصفحة.');
+ await db.insert(accessRecoveryEvents).values(event(r.requestId,input.actor,'STATUS_CHANGED',{reason},r.status,input.status));
+ if(input.status==='INFO_REQUIRED'||input.status==='UNABLE_TO_VERIFY')await notifyRequester(updated,input.status,reason);
+ return updated;
+}
+export const OWNERSHIP_CHECKS=['IDENTITY_DOCUMENT','CASE_DETAILS_CONFIRMED','PHONE_CONFIRMED','PAYMENT_OR_RECEIPT','OTHER'] as const;
+
