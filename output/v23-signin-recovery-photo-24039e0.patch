+import { z } from 'zod';
+import { readJson,sameOrigin,errorResponse } from '@/lib/server';
+import { clientResponse } from '@/lib/client-access';
+import { rateLimit } from '@/lib/security';
+import { requestRecoveryCode,submitRecoveryRequest } from '@/lib/access-recovery';
+// v2.3 — access recovery request (client side). The code proves control of the NEW email only; it never signs anyone in
+// and never reveals whether the lookup matched a file.
+const code=z.string().transform(s=>s.replace(/[٠-٩]/g,c=>String(c.charCodeAt(0)-1632)).replace(/[۰-۹]/g,c=>String(c.charCodeAt(0)-1776))).pipe(z.string().regex(/^\d{6}$/));
+const schema=z.union([
+ z.object({action:z.literal('request'),identifier:z.string().trim().min(4).max(60),fullName:z.string().trim().min(2).max(150),email:z.string().trim().email().max(254),requestKey:z.string().uuid(),locale:z.enum(['ar','en'])}).strict(),
+ z.object({action:z.literal('verify'),ticket:z.string().min(20).max(4000),code}).strict(),
+]);
+export async function POST(request:Request){try{
+ sameOrigin(request);await rateLimit(request,'client-recovery',20,900);const d=await readJson(request,schema);
+ if(d.action==='request'){await rateLimit(request,'client-recovery-request-day',6,86400);return clientResponse(await requestRecoveryCode(d));}
+ return clientResponse(await submitRecoveryRequest(d.ticket,d.code),201);
+}catch(e){return errorResponse(e);}}
diff --git a/app/api/office/recovery/route.ts b/app/api/office/recovery/route.ts
