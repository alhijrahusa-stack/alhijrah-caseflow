+-- v2.3 — sign-in routing, access recovery and the Canadian photo assistant. Additive only: no existing row changes.
+-- One open (DRAFT) application draft per account, so concurrent or retried «ابدأ الطلب» requests cannot open a second one.
+CREATE UNIQUE INDEX client_drafts_one_open ON client_application_drafts(account_key) WHERE state='DRAFT';
+--> statement-breakpoint
+-- Recovery email verification codes live apart from sign-in codes (auth_challenges): a recovery code can never open a
+-- session, and a sign-in code can never confirm a recovery request.
+CREATE TABLE recovery_codes(
+ code_id TEXT PRIMARY KEY NOT NULL,
+ email_hash TEXT NOT NULL CHECK(length(email_hash)=64),
+ code_hash TEXT NOT NULL,
+ request_key TEXT NOT NULL UNIQUE,
+ state TEXT NOT NULL CHECK(state IN('created','accepted','failed','unknown')),
+ attempts INTEGER NOT NULL DEFAULT 0 CHECK(attempts BETWEEN 0 AND 5),
+ expires_at INTEGER NOT NULL,
+ used_at INTEGER,
+ created_at INTEGER NOT NULL);
+--> statement-breakpoint
+CREATE INDEX recovery_codes_email ON recovery_codes(email_hash,created_at);
+--> statement-breakpoint
+CREATE TABLE access_recovery_requests(
+ request_id TEXT PRIMARY KEY NOT NULL,
+ reference TEXT NOT NULL UNIQUE CHECK(length(reference)=11 AND substr(reference,1,3)='AR-' AND reference=upper(reference)),
+ verified_email TEXT NOT NULL CHECK(verified_email=lower(trim(verified_email)) AND length(verified_email) BETWEEN 3 AND 254),
+ lookup_type TEXT NOT NULL CHECK(lookup_type IN('PHONE','CASE_REFERENCE')),
+ lookup_value TEXT NOT NULL CHECK(length(lookup_value) BETWEEN 4 AND 40),
+ full_name TEXT NOT NULL CHECK(length(full_name) BETWEEN 2 AND 150),
+ locale TEXT NOT NULL DEFAULT 'ar' CHECK(locale IN('ar','en')),
+ status TEXT NOT NULL CHECK(status IN('NEW','UNDER_REVIEW','INFO_REQUIRED','COMPLETED','UNABLE_TO_VERIFY')),
+ matched_candidate_id TEXT REFERENCES candidates(id),
+ match_json TEXT NOT NULL DEFAULT '{}' CHECK(json_valid(match_json)),
+ decision_reason TEXT,
+ decided_by TEXT,
+ decided_at TEXT,
+ old_email TEXT,
+ new_email TEXT,
+ version INTEGER NOT NULL DEFAULT 1 CHECK(version>=1),
+ created_at TEXT NOT NULL,
+ updated_at TEXT NOT NULL);
+--> statement-breakpoint
+-- The same verified email + normalized lookup (type and value) has at most one open request.
+CREATE UNIQUE INDEX access_recovery_open_unique ON access_recovery_requests(verified_email,lookup_type,lookup_value) WHERE status IN('NEW','UNDER_REVIEW','INFO_REQUIRED');
+--> statement-breakpoint
+CREATE INDEX access_recovery_status ON access_recovery_requests(status,created_at);
+--> statement-breakpoint
+CREATE TRIGGER access_recovery_terminal BEFORE UPDATE ON access_recovery_requests WHEN OLD.status IN('COMPLETED','UNABLE_TO_VERIFY') BEGIN SELECT RAISE(ABORT,'RECOVERY_REQUEST_CLOSED'); END;
+--> statement-breakpoint
+CREATE TRIGGER access_recovery_no_delete BEFORE DELETE ON access_recovery_requests BEGIN SELECT RAISE(ABORT,'RECOVERY_REQUEST_IMMUTABLE'); END;
+--> statement-breakpoint
+-- Server-appended decision trail: request, account, staff member, time, decision, reason and both email addresses.
+CREATE TABLE access_recovery_events(
+ event_id TEXT PRIMARY KEY NOT NULL,
+ request_id TEXT NOT NULL REFERENCES access_recovery_requests(request_id),
+ actor TEXT NOT NULL,
+ event_type TEXT NOT NULL CHECK(event_type IN('CREATED','REPLAYED','STATUS_CHANGED','COMPLETED','NOTIFICATION')),
+ from_status TEXT,
+ to_status TEXT,
