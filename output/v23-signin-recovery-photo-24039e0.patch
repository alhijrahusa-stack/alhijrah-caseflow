+import { z } from 'zod';
+import { errorResponse,ApiError } from '@/lib/server';
+import { requireAccount } from '@/lib/application-drafts';
+import { photoFile } from '@/lib/photo-store';
+// Private photo bytes: owner session + a 5-minute HMAC-signed link (never a public URL).
+type Context={params:Promise<{id:string}>};
+export async function GET(request:Request,ctx:Context){try{const a=await requireAccount(request),photoId=z.string().uuid().parse((await ctx.params).id),u=new URL(request.url);return await photoFile(a,photoId,Number(u.searchParams.get('exp')),String(u.searchParams.get('sig')||''));}catch(e){if(e instanceof z.ZodError)return errorResponse(new ApiError(400,'معرّف الصورة غير صحيح.'));return errorResponse(e);}}
