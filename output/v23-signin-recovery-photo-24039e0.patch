+    if(type===2){const s=ascii(count,val,e);if(tag===0x010f)out.make=s;else if(tag===0x0110)out.model=s;else if(tag===0x0131)out.software=s;else if(tag===0x0132)out.dateTime=s;else if(tag===0x013b)out.artist=s;else if(tag===0x9003)out.dateTimeOriginal=s;}
