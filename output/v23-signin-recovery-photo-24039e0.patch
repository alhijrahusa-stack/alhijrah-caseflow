+// v2.3 — browser E2E on the built Worker (Miniflare) behind a local HTTPS server serving dist/client (self-signed, per run),
+// Chromium via Playwright with a fake camera device. Covers: sign-in with masked email (LTR) and a code typed in
+// Arabic-Indic digits; access recovery form → code → reference; photo assistant signed-out gate; the entry card on the
+// account screen; context questions with keyboard; the official ruleset panel; upload → on-device MediaPipe analysis
+// (real models, served locally) → server record; fake-camera capture → analysis; attach, replacement confirmation,
+// deletion; 360/1440 widths without horizontal overflow; RTL then LTR. Synthetic images (no face) only: they exercise
+// the full pipeline and the «one face» RETAKE path; accuracy on real faces needs consented reference photos (not here).
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createRequire } from 'node:module';
+import { readFile, readdir, mkdir } from 'node:fs/promises';
+import path from 'node:path';
+import https from 'node:https';
+import os from 'node:os';
+import { execFileSync } from 'node:child_process';
+import { createReadStream, existsSync, statSync, readFileSync, mkdtempSync } from 'node:fs';
+import { seedOfficeManager } from './office-fixture.mjs';
+import { clientCaseFixture } from './client-case-fixture.mjs';
+
+const require = createRequire(import.meta.url);
+const { Miniflare } = createRequire(require.resolve('wrangler/package.json'))('miniflare');
+const { chromium } = require('playwright');
+const SHOTS = process.env.E2E_SHOTS || '';
+type Db = { prepare: (q: string) => { bind: (...a: unknown[]) => { first: () => Promise<Record<string, unknown> | null>; run: () => Promise<unknown> }; run: () => Promise<unknown> } };
+type Mf = { ready: Promise<URL>; dispatchFetch: (u: string, init?: Record<string, unknown>) => Promise<Response>; getD1Database: (n: string) => Promise<Db>; dispose: () => Promise<void> };
+// eslint-disable-next-line @typescript-eslint/no-explicit-any -- untyped global Playwright handle (test-only)
+type Browser = { newContext: (o: Record<string, unknown>) => Promise<any>; close: () => Promise<void> };
+let mf: Mf, db: Db, url = '', browser: Browser, server: https.Server;
+const MIME: Record<string, string> = { '.js': 'text/javascript', '.mjs': 'text/javascript', '.css': 'text/css', '.svg': 'image/svg+xml', '.png': 'image/png', '.jpg': 'image/jpeg', '.ico': 'image/x-icon', '.woff2': 'font/woff2', '.wasm': 'application/wasm', '.json': 'application/json' };
+const mails: { to: string[]; text: string }[] = [];
+const codeFor = async (email: string, after: number) => {
+  for (let i = 0; i < 200; i++) { const m = mails.slice(after).reverse().find(x => x.to.includes(email)); if (m) return /\b(\d{6})\b/.exec(m.text)![1]; await new Promise(r => setTimeout(r, 25)); }
+  throw new Error('no code for ' + email);
+};
+const arabicDigits = (s: string) => s.replace(/\d/g, d => String.fromCharCode(0x0660 + Number(d)));
+
+test.before(async () => {
+  const files = await readdir('dist/server', { recursive: true });
+  mf = new Miniflare({
+    modules: ['index.js', ...files.filter((f: string) => f !== 'index.js' && f.endsWith('.js'))].map((f: string) => ({ type: 'ESModule', path: path.resolve('dist/server', f) })),
+    modulesRoot: path.resolve('dist/server'), compatibilityDate: '2026-05-15', compatibilityFlags: ['nodejs_compat'],
+    d1Databases: { DB: 'v23-photo-e2e' }, r2Buckets: ['BUCKET'],
+    bindings: { TRUST_SITES_IDENTITY_HEADERS: '1', OFFICE_ADMIN_EMAIL: 'admin@example.test', APP_SECRET: 'd'.repeat(64) },
+    outboundService: async (req: Request) => {
+      const u = new URL(req.url);
+      if (u.hostname === 'api.resend.com') { const b = await req.json() as { to: string[]; text?: string }; mails.push({ to: b.to, text: b.text || '' }); return Response.json({ id: 'm' + mails.length }); }
+      return new Response('blocked', { status: 599 });
+    },
+  }) as unknown as Mf;
+  const dir = mkdtempSync(path.join(os.tmpdir(), 'alh-photo-e2e-')), clientDir = path.resolve('dist/client');
+  execFileSync('openssl', ['req', '-x509', '-newkey', 'rsa:2048', '-nodes', '-keyout', dir + '/k.pem', '-out', dir + '/c.pem', '-days', '1', '-subj', '/CN=127.0.0.1', '-addext', 'subjectAltName=IP:127.0.0.1'], { stdio: 'ignore' });
+  server = https.createServer({ key: readFileSync(dir + '/k.pem'), cert: readFileSync(dir + '/c.pem') }, async (req, res) => {
+    try {
