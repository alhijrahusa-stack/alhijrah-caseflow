@@ -0,0 +1,22 @@
+import { z } from 'zod';
+import { staffWith,sameOrigin,readJson,errorResponse,ApiError } from '@/lib/server';
+import { requireCapability,requireManager } from '@/lib/rbac';
+import { listRecoveryRequests,recoveryEvents,setRecoveryStatus,completeRecovery,RECOVERY_STATUSES,OWNERSHIP_CHECKS } from '@/lib/access-recovery';
+// v2.3 — staff review of access recovery requests. Viewing: view_crm. Status changes: edit_case. Completion (email
+// change + revocation): MANAGER only. Every action is appended to access_recovery_events by the library.
+const headers={'Cache-Control':'private, no-store'};
+const schema=z.discriminatedUnion('action',[
+ z.object({action:z.literal('status'),requestId:z.string().uuid(),expectedVersion:z.number().int().min(1),status:z.enum(['UNDER_REVIEW','INFO_REQUIRED','UNABLE_TO_VERIFY']),reason:z.string().max(1000).default('')}).strict(),
+ z.object({action:z.literal('complete'),requestId:z.string().uuid(),expectedVersion:z.number().int().min(1),candidateId:z.string().min(8).max(80),checks:z.array(z.enum(OWNERSHIP_CHECKS)).min(1).max(5),reason:z.string().min(10).max(1000)}).strict(),
+]);
+export async function GET(request:Request){try{
+ await staffWith('view_crm');const u=new URL(request.url),id=u.searchParams.get('id'),status=u.searchParams.get('status');
+ if(id){if(!/^[0-9a-f-]{36}$/.test(id))throw new ApiError(400,'معرّف الطلب غير صحيح.');return Response.json({events:await recoveryEvents(id)},{headers});}
+ const filter=(RECOVERY_STATUSES as readonly string[]).includes(status||'')?status as typeof RECOVERY_STATUSES[number]:undefined;
+ return Response.json({items:await listRecoveryRequests(filter)},{headers});
+}catch(e){return errorResponse(e);}}
+export async function POST(request:Request){try{
+ sameOrigin(request);const s=await staffWith('view_crm'),d=await readJson(request,schema),actor=s.authority.actor.userId;
+ if(d.action==='status'){requireCapability(s.authority,'edit_case');return Response.json(await setRecoveryStatus({...d,actor}),{headers});}
+ requireManager(s.authority);return Response.json(await completeRecovery({...d,actor}),{headers});
+}catch(e){return errorResponse(e);}}
