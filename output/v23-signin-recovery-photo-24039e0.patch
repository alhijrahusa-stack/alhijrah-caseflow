+  db = await mf.getD1Database('DB');
+  for (const f of (await readdir('drizzle')).filter((f: string) => f.endsWith('.sql')).sort())
+    for (const s of (await readFile('drizzle/' + f, 'utf8')).split('--> statement-breakpoint').map((s: string) => s.trim()).filter(Boolean)) await db.prepare(s).run();
+  await seedOfficeManager(db, 'admin-1');
