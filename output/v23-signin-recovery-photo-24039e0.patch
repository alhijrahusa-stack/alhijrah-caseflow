+// Transactional email through the office's configured provider (Resend; key encrypted in office_settings). The
+// Idempotency-Key makes a retried notification a single message. Returns the delivery outcome; never throws for a
+// provider failure, so a decision that already committed is not reported as failed because a notice was not sent.
+import { eq } from 'drizzle-orm';
+import { getDb } from '@/db';
+import { officeSettings } from '@/db/schema';
+import { decrypt } from './security';
+import { OFFICE } from './branding';
+export type MailOutcome='sent'|'failed'|'unknown'|'not_configured';
+export async function sendSystemEmail(m:{to:string;subject:string;text:string;idempotencyKey:string}):Promise<MailOutcome>{
+ const [s]=await getDb().select().from(officeSettings).where(eq(officeSettings.id,'office')).limit(1);
+ if(!s?.mailKey||!s.mailFrom)return 'not_configured';
+ const controller=new AbortController(),timer=setTimeout(()=>controller.abort(),12000);
+ try{
+  const r=await fetch('https://api.resend.com/emails',{method:'POST',signal:controller.signal,headers:{Authorization:'Bearer '+await decrypt(s.mailKey),'Content-Type':'application/json','Idempotency-Key':m.idempotencyKey.slice(0,256)},body:JSON.stringify({from:s.mailFrom,to:[m.to],subject:m.subject,text:m.text,reply_to:OFFICE.email})});
+  const body=await r.json().catch(()=>null) as {id?:string}|null;
+  if(r.ok&&body?.id)return 'sent';
+  return r.status>=400&&r.status<500&&r.status!==408?'failed':'unknown';
+ }catch{return 'unknown';}finally{clearTimeout(timer);}
+}
