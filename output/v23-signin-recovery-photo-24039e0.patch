+// MediaPipe; the server validates their shape and binds them to the exact image hash, but cannot recompute them) and
+// EVIDENCE (dates, photographer, declarations). The server decides which checks are mandatory for the ruleset and the
+// declared context (child/newborn, glasses, head covering) and derives the status:
+//   RETAKE — a mandatory check failed with a defect that needs a new photo;
+//   REVIEW — a mandatory check is missing evidence/specification, is uncertain, or could not be measured;
+//   PASS   — every mandatory check passed («يجتاز الفحوص الآلية»).
+import { z } from 'zod';
+import type { Ruleset,PhotoContext } from './photo-rules';
