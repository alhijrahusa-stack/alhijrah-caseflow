new file mode 100644
index 0000000..284edc1
--- /dev/null
+++ b/tests/photo-measure.test.mjs
@@ -0,0 +1,51 @@
+// v2.3 — server photo measurement (pure): signature sniffing, JPEG SOF0/SOF2 and PNG IHDR sizes, EXIF in both byte
+// orders, orientation swap, malformed/truncated input never throws, EXIF date parsing and editing-software signal.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { sniffMime, parseExif, measure, exifDate, editingSoftware } from '../lib/photo-measure.ts';
+
+const seg = (m, body) => Buffer.concat([Buffer.from([0xff, m, (body.length + 2) >> 8, (body.length + 2) & 255]), body]);
+const sof = (m, w, h) => Buffer.from([0xff, m, 0, 17, 8, h >> 8, h & 255, w >> 8, w & 255, 3, 1, 0x11, 0, 2, 0x11, 1, 3, 0x11, 1]);
+// Big-endian TIFF with IFD0 {Software, Orientation} and an Exif sub-IFD {DateTimeOriginal}.
+function tiffBE({ software, orientation, date }) {
+  const b = Buffer.alloc(256); b.write('MM', 0, 'latin1'); b.writeUInt16BE(42, 2); b.writeUInt32BE(8, 4);
+  b.writeUInt16BE(3, 8); let p = 10, data = 8 + 2 + 3 * 12 + 4 + 2 + 12 + 4; const subAt = 8 + 2 + 3 * 12 + 4;
+  const sw = Buffer.from(software + '\0', 'latin1');
+  b.writeUInt16BE(0x0112, p); b.writeUInt16BE(3, p + 2); b.writeUInt32BE(1, p + 4); b.writeUInt16BE(orientation, p + 8); p += 12;
+  b.writeUInt16BE(0x0131, p); b.writeUInt16BE(2, p + 2); b.writeUInt32BE(sw.length, p + 4); b.writeUInt32BE(data, p + 8); sw.copy(b, data); data += sw.length; p += 12;
+  b.writeUInt16BE(0x8769, p); b.writeUInt16BE(4, p + 2); b.writeUInt32BE(1, p + 4); b.writeUInt32BE(subAt, p + 8); p += 12; b.writeUInt32BE(0, p);
+  const d = Buffer.from(date + '\0', 'latin1'); b.writeUInt16BE(1, subAt); b.writeUInt16BE(0x9003, subAt + 2); b.writeUInt16BE(2, subAt + 4); b.writeUInt32BE(d.length, subAt + 6); b.writeUInt32BE(data, subAt + 10); d.copy(b, data); data += d.length; b.writeUInt32BE(0, subAt + 14);
+  return b.subarray(0, data);
+}
+
+test('signature decides the format, not the name or declared type', () => {
+  assert.equal(sniffMime(Buffer.from([0xff, 0xd8, 0xff, 0xe0])), 'image/jpeg');
+  assert.equal(sniffMime(Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a, 0])), 'image/png');
+  assert.equal(sniffMime(Buffer.from('GIF89a....')), null);
+  assert.equal(sniffMime(Buffer.from('RIFF....WEBPVP8 ')), null);
+  assert.equal(measure(Buffer.from('<svg/>')), null);
+});
+
+test('JPEG: baseline and progressive frame sizes; big-endian EXIF with orientation 6 swaps the displayed size', () => {
+  const base = Buffer.concat([Buffer.from([0xff, 0xd8]), sof(0xc0, 801, 1103), Buffer.from([0xff, 0xd9])]);
+  assert.deepEqual([measure(base).width, measure(base).height, measure(base).bytes], [801, 1103, base.length]);
+  const prog = Buffer.concat([Buffer.from([0xff, 0xd8]), seg(0xdb, Buffer.alloc(67)), sof(0xc2, 640, 480), Buffer.from([0xff, 0xd9])]);
+  assert.deepEqual([measure(prog).width, measure(prog).height], [640, 480]);
+  const exif = Buffer.concat([Buffer.from('Exif\0\0', 'latin1'), tiffBE({ software: 'Snapseed 2.0', orientation: 6, date: '2026:10:01 09:30:00' })]);
+  const rotated = Buffer.concat([Buffer.from([0xff, 0xd8]), seg(0xe1, exif), sof(0xc0, 1100, 800), Buffer.from([0xff, 0xd9])]), m = measure(rotated);
+  assert.deepEqual([m.width, m.height], [800, 1100]);
+  assert.equal(m.exif.orientation, 6); assert.equal(m.exif.software, 'Snapseed 2.0'); assert.equal(m.exif.dateTimeOriginal, '2026:10:01 09:30:00');
+  assert.equal(exifDate(m.exif.dateTimeOriginal), '2026-10-01'); assert.equal(editingSoftware(m.exif.software), true);
+});
+
+test('PNG IHDR size; malformed or truncated input returns null/empty without throwing', () => {
+  const ihdr = Buffer.alloc(25); ihdr.writeUInt32BE(13, 0); ihdr.write('IHDR', 4, 'latin1'); ihdr.writeUInt32BE(900, 8); ihdr.writeUInt32BE(1200, 12);
+  const png = Buffer.concat([Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]), ihdr]);
+  assert.deepEqual([measure(png).width, measure(png).height, measure(png).mime], [900, 1200, 'image/png']);
+  assert.equal(measure(png.subarray(0, 20)), null, 'truncated PNG');
+  assert.equal(measure(Buffer.from([0xff, 0xd8, 0xff, 0xc0, 0xff, 0xff])), null, 'JPEG with a bad segment length');
+  assert.deepEqual(parseExif(Buffer.from('II*\0\xff\xff\xff\x7f', 'latin1')), { dateTimeOriginal: null, dateTime: null, make: null, model: null, software: null, orientation: null, artist: null });
+  assert.equal(parseExif(Buffer.from('XX')).software, null);
+  assert.equal(exifDate('2026:13:45 00:00:00'), null); assert.equal(exifDate(null), null);
+  assert.equal(editingSoftware('Canon EOS firmware 1.0'), false); assert.equal(editingSoftware(null), false);
+});
