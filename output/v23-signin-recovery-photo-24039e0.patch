+import { z } from 'zod';
+import { sameOrigin,readJson,errorResponse,ApiError } from '@/lib/server';
+import { rateLimit } from '@/lib/security';
+import { requireAccount } from '@/lib/application-drafts';
+import { analyzePhoto,analysisInputSchema,attachPhoto,deletePhoto,explainAnalysis } from '@/lib/photo-store';
+// v2.3 — one photo: record an analysis (server re-measures; device checks bound to the image hash), explain a result,
+// attach to an application (replacement needs confirmation), delete. Ownership is checked in every operation.
+type Context={params:Promise<{id:string}>};
+const headers={'Cache-Control':'private, no-store'};
+const id=z.string().uuid();
+const schema=z.discriminatedUnion('action',[
+ analysisInputSchema.extend({action:z.literal('analysis')}).strict(),
+ z.object({action:z.literal('explain'),analysisId:z.string().uuid(),locale:z.enum(['ar','en'])}).strict(),
+ z.object({action:z.literal('attach'),analysisId:z.string().uuid(),reference:z.string().trim().min(4).max(100),replace:z.boolean(),requestKey:z.string().uuid()}).strict(),
+]);
+export async function POST(request:Request,ctx:Context){try{
+ sameOrigin(request);const a=await requireAccount(request),photoId=id.parse((await ctx.params).id),d=await readJson(request,schema,60000);
+ if(d.action==='analysis'){await rateLimit(request,'photo-analysis:'+a.accountKey,60,3600);const {action:_a,...input}=d;void _a;return Response.json(await analyzePhoto(a,photoId,input),{status:201,headers});}
+ if(d.action==='explain'){await rateLimit(request,'photo-explain:'+a.accountKey,10,3600);return Response.json(await explainAnalysis(a,photoId,d.analysisId,d.locale),{headers});}
+ const r=await attachPhoto(a,photoId,d);// A replacement that still needs the client's confirmation is an ordinary 200 answer carrying the existing photo.
+ return Response.json(r,{status:r.confirmationRequired||r.replay?200:201,headers});
+}catch(e){if(e instanceof z.ZodError)return errorResponse(new ApiError(400,'معرّف الصورة غير صحيح.'));return errorResponse(e);}}
+export async function DELETE(request:Request,ctx:Context){try{sameOrigin(request);const a=await requireAccount(request),photoId=id.parse((await ctx.params).id);return Response.json(await deletePhoto(a,photoId),{headers});}catch(e){if(e instanceof z.ZodError)return errorResponse(new ApiError(400,'معرّف الصورة غير صحيح.'));return errorResponse(e);}}
