diff --git a/app/premium.css b/app/premium.css
index cbce061..97d3a15 100644
--- a/app/premium.css
+++ b/app/premium.css
@@ -657,3 +657,21 @@ input,select,textarea{transition:border-color .18s,box-shadow .18s}
 .rules-interval{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:8px;align-items:center}
 .rules-release{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:8px 0;border-top:1px solid var(--line)}
 .rules-release div{display:flex;flex-direction:column;min-width:0}.rules-release small{color:var(--muted);overflow:hidden;text-overflow:ellipsis}
+/* Unified client entry (v2.2 Gate 4 behaviour) with the original gold/green look restored: both intent choices sit inside
+   the hero card — gold for a new application, green glass for an existing one. The chosen intent keeps a clear ring. */
+.client-entry .account-intents{position:relative;width:100%;margin-top:14px;gap:14px}
+.client-entry .account-intent{display:flex;align-items:center;gap:12px;padding:18px 20px;border-radius:20px;backdrop-filter:none;min-height:84px;text-align:start;transition:transform .2s cubic-bezier(.2,.8,.2,1),box-shadow .2s}
+.client-entry .account-intent:active{transform:scale(.98)}
+.client-entry .account-intent .entry-btn-icon{display:grid;place-items:center;width:44px;height:44px;border-radius:13px;flex-shrink:0}
+.client-entry .account-intent .entry-btn-copy{flex:1;display:grid;gap:2px;line-height:1.35}
+.client-entry .account-intent.intent-gold{border:1px solid rgba(255,236,179,.65);background:linear-gradient(135deg,#f3dc9b,#d4af37 55%,#a8842a);color:#1b1405;box-shadow:0 14px 30px rgba(212,175,55,.3),inset 0 1px 0 rgba(255,255,255,.5)}
+.client-entry .account-intent.intent-gold .entry-btn-icon{background:rgba(255,255,255,.28);color:#1b1405}
+.client-entry .account-intent.intent-green{border:1px solid rgba(16,185,129,.55);background:rgba(16,185,129,.1);color:#ecfdf5;box-shadow:inset 0 0 0 1px rgba(16,185,129,.12),0 14px 30px rgba(1,6,18,.35)}
+.client-entry .account-intent.intent-green .entry-btn-icon{background:rgba(16,185,129,.2);color:#6ee7b7}
+.client-entry .account-intent .entry-btn-copy strong{font-size:17px;font-weight:700}
+.client-entry .account-intent .entry-btn-copy small{font-size:13px;opacity:.85;color:inherit}
+.client-entry .account-intent:hover{transform:translateY(-2px)}
+.client-entry .account-intent.intent-gold.on{box-shadow:0 0 0 2px #fff3cf,0 0 0 5px rgba(212,175,55,.45),0 18px 36px rgba(212,175,55,.35)}
+.client-entry .account-intent.intent-green.on{border-color:#34d399;box-shadow:0 0 0 2px #34d399,0 0 0 5px rgba(16,185,129,.25),0 18px 36px rgba(1,6,18,.4)}
+.client-entry .account-intent:focus-visible{outline:2px solid #fff;outline-offset:3px}
+@media(max-width:768px){.client-entry .account-intents{grid-template-columns:minmax(0,1fr)}.client-entry .account-intent{padding:16px 18px}}
