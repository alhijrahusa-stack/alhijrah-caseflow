# ---- Required ----
MURAILEX_DOMAIN=murailex.example.com
ENVIRONMENT=production
SECRET_KEY=                      # 64+ random chars: python -c "import secrets;print(secrets.token_urlsafe(64))"
POSTGRES_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=           # first administrator (created only when no users exist)
BOOTSTRAP_ADMIN_PASSWORD=        # min 12 chars; change after first sign-in

# Private S3-compatible storage (MinIO in docker-compose, or any S3 with versioning + Object Lock)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=murailex-evidence
S3_REGION=us-east-1
S3_SERVER_SIDE_ENCRYPTION=AES256
S3_OBJECT_LOCK_MODE=GOVERNANCE   # GOVERNANCE | COMPLIANCE (bucket must be created with Object Lock)
S3_OBJECT_LOCK_DAYS=3650
MINIO_KMS_SECRET_KEY=            # murailex-key:<base64 of 32 random bytes>  (enables SSE at rest in MinIO)

# ---- Transcription engines (absent => NOT CONFIGURED) ----
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_SPEECH_MODEL=universal-3-5-pro
GOOGLE_CREDENTIALS_JSON=         # service-account JSON (Speech-to-Text + Cloud Storage + Cloud Translation roles)
GOOGLE_PROJECT_ID=
GOOGLE_STT_LOCATION=us
GOOGLE_STT_MODEL=chirp_3
GOOGLE_STT_LANGUAGE_CODES=ar-YE
GOOGLE_STT_GCS_BUCKET=           # private working bucket for derived FLAC copies (deleted after each run)
PYANNOTE_API_KEY=
PYANNOTE_MODEL=precision-2
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe-diarize
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=ar
